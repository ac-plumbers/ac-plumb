---
import '@/styles/global.css';
import '@fontsource-variable/inconsolata';
import '@fontsource/lato';
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

import BaseHead from '@/components/fundations/head/BaseHead.astro';
import { ClientRouter } from 'astro:transitions';
import HeaderVue from '@/components/global/Header.vue';
import StickyCallButton from '@/components/global/StickyCallButton.vue';
import Footer from '@/components/global/Footer.astro';
import Header from '@/components/global/Header.astro';

const {
  title,
  description,
  keywords,
  author,
  themeColor,
  canonical,
  noindex = false,
  schemaType = 'WebPage',
  datePublished,
  dateModified,
  ogImage,
  logoImage,
} = Astro.props;

// Get current path for active link highlighting
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang='en-GB' class='h-full scroll-smooth'>
  <head>
    <BaseHead
      title={title}
      description={description}
      keywords={keywords}
      author={author}
      themeColor={themeColor}
      canonical={canonical}
      noindex={noindex}
      schemaType={schemaType}
      datePublished={datePublished}
      dateModified={dateModified}
      ogImage={ogImage}
      logoImage={logoImage}
    />
    <ClientRouter />
  </head>
  <body class='h-full overflow-x-hidden'>
    <Header />
    <!-- <HeaderVue client:load currentPath={currentPath} transition:persist /> -->
    <main id='main-content' class='mx-auto mt-20 flex min-h-screen flex-col'>
      <slot />
    </main>
    <Footer />
    <StickyCallButton client:load />
  </body>
</html>
