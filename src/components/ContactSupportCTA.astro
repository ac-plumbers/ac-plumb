---
import GetAQuote from './fundations/elements/GetAQuote.astro';

const {
  heading = 'Still have questions?',
  message = "If you can't find the answer you're looking for, our team is ready to help.",
  buttonText = 'Contact Support',
  buttonHref = '/contact-us',
  sectionClass = '',
  containerClass = '',
} = Astro.props;
---

<section
  class={`mt-16 ${sectionClass}`}
  aria-labelledby='contact-support-heading'>
  <div
    class={`mx-auto max-w-2xl text-center bg-primary-100 rounded-lg shadow p-8 ${containerClass}`}>
    <h2
      id='contact-support-heading'
      class='mb-4 text-2xl font-bold text-primary-700'>
      {heading}
    </h2>
    <p class='mb-6 text-primary-700'>{message}</p>
    <GetAQuote
      variant='primary'
      size='md'
      iconStyle='none'
      href={buttonHref}
      text={buttonText}
      data-umami-event='lead_quote_click'
      data-umami-event-placement='cta_center_page'
    />
  </div>
</section>
