---
import Text from '../fundations/elements/Text.astro';

interface Props {
  benefits: string[];
}

const { benefits } = Astro.props;
---

<section
  aria-labelledby='why-choose-us-heading'
  class='rounded-lg bg-primary-50 p-6'>
  <Text
    tag='h3'
    variant='displayMD'
    id='why-choose-us-heading'
    class='mb-6 font-bold text-text-00'>
    Why Choose Our Service?
  </Text>
  <ul class='space-y-2'>
    {
      benefits.map((benefit: string) => (
        <li class='flex items-start gap-2 text-neutral-700'>
          <span class='pt-1.5 sm:pt-0'>
            <svg
              class='h-5 w-5 shrink-0 text-accent-500'
              fill='currentColor'
              viewBox='0 0 20 20'
              aria-hidden='true'
              focusable='false'>
              <path
                fill-rule='evenodd'
                d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z'
                clip-rule='evenodd'
              />
            </svg>
          </span>
          <span class='wrap-break-word'>{benefit}</span>
        </li>
      ))
    }
  </ul>
</section>
