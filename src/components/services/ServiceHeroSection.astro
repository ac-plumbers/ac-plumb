---
import Text from '../fundations/elements/Text.astro';
import Link from '../fundations/elements/Link.astro';
import Breadcrumb from '../fundations/elements/Breadcrumb.astro';
import { BadgeCheck, Camera } from 'lucide-vue-next';
import GetAQuote from '../fundations/elements/GetAQuote.astro';
import Badge from '../fundations/elements/Badge.astro';

type Props = {
  title: string;
  description?: string;
  image: string;
  alt?: string;
  intro?: string;
  slug?: string;
};
const { title, description, image, alt, intro, slug } = Astro.props;

// Provide fallback alt text for better accessibility
const imageAlt =
  alt && alt.trim() !== '' ? alt : `${title} service background image`;
---

<section
  data-bg='dark'
  id='service-hero'
  class='relative bg-linear-to-r from-primary-900 to-primary-800 pt-32 pb-16 sm:mt-0 sm:pt-20 sm:pb-24'
  role='banner'
  aria-labelledby='service-hero-title'>
  <div class='absolute inset-0 opacity-20' aria-hidden='true'>
    <picture>
      <source
        srcset={image
          .replace('/images/services/', '/images/services/optimized/')
          .replace(/\.(jpg|jpeg|png)$/i, '-400w.webp')}
        type='image/webp'
      />
      <img
        src={image}
        alt={imageAlt}
        class='h-full w-full object-cover'
        role='presentation'
        loading='eager'
        width='1920'
        height='600'
        decoding='async'
      />
    </picture>
  </div>
  <div class='relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
    <div class='flex flex-col items-center text-center'>
      <Breadcrumb
        variant='warm'
        size='base'
        items={[
          { label: 'Home', href: '/' },
          { label: 'Services', href: '/services' },
          { label: title, href: slug ? `/services/${slug}` : undefined },
        ]}
      />
      <!-- badge -->
      <Badge
        text='Un poco di testo per riempire il badge'
        iconSize='lg'
        class='mt-4'>
        <BadgeCheck slot='left-icon' aria-hidden='true' />
      </Badge>
      <Text
        tag='h1'
        variant='display2XL'
        id='service-hero-title'
        class='mt-8 font-bold tracking-tight text-white'>
        {title}
      </Text>
      <Text tag='p' variant='textXL' class='mt-6 max-w-3xl text-neutral-200'>
        {intro}
      </Text>
      <div class='mt-10 flex items-center gap-x-6'>
        <GetAQuote
          href='/contact-us'
          variant='accent'
          size='lg'
          class='text-2xl font-bold text-white uppercase sm:text-base'>
          Get a Quote
        </GetAQuote>
      </div>
    </div>
  </div>
</section>
