---
import Text from '../fundations/elements/Text.astro';
import Link from '../fundations/elements/Link.astro';
import Breadcrumb from '../fundations/elements/Breadcrumb.astro';
import { BadgeCheck, Camera } from 'lucide-vue-next';
import GetAQuote from '../fundations/elements/GetAQuote.astro';
import Badge from '../fundations/elements/Badge.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  title: string;
  description?: string;
  image: ImageMetadata;
  alt?: string;
  intro?: string;
  slug?: string;
};
const { title, description, image, alt, intro, slug } = Astro.props;

const imageAlt =
  alt && alt.trim() !== '' ? alt : `${title} service background image`;
---

<section
  data-bg='dark'
  id='service-hero'
  class='relative mt-4 overflow-hidden bg-linear-to-r from-primary-900 to-primary-800 px-2 py-32 sm:px-4 sm:pt-20 sm:pb-24 lg:px-8'
  role='banner'
  aria-labelledby='service-hero-title'>
  <div class='absolute inset-0 opacity-40' aria-hidden='true'>
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 800, 1200, 1920]}
      sizes='100vw'
      format='webp'
      class='h-full w-full object-cover'
      loading='eager'
      decoding='async'
    />
  </div>
  <div class='relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
    <div class='flex flex-col items-center text-center'>
      <Breadcrumb
        variant='warm'
        size='base'
        items={[
          { label: 'Home', href: '/' },
          { label: 'Services', href: '/services' },
          { label: title, href: slug ? `/services/${slug}` : undefined },
        ]}
      />
      <!-- badge -->
      <!-- TODO:: Add a badge field to each service's markdown frontmatter, pass it as a prop to ServiceHeroSection.  -->
      <Badge text='Gas Safe Registered Engineers' iconSize='lg' class='mt-4'>
        <BadgeCheck slot='left-icon' aria-hidden='true' />
      </Badge>
      <Text
        tag='h1'
        variant='display2XL'
        id='service-hero-title'
        class='mt-8 font-bold tracking-tight text-white'
        transition:name={slug ? `service-title-${slug}` : undefined}>
        {title}
      </Text>
      <Text tag='p' variant='textXL' class='mt-6 max-w-3xl text-neutral-200'>
        {intro}
      </Text>
      <div class='mt-10 flex items-center gap-x-6'>
        <GetAQuote
          href='/contact-us'
          variant='accent'
          size='lg'
          class='text-2xl font-bold text-white uppercase sm:text-base'>
          Get a Quote
        </GetAQuote>
      </div>
    </div>
  </div>
</section>
