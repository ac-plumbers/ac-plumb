---
import Text from '@/components/fundations/elements/Text.astro';
import { Image } from 'astro:assets';
import gasSafe from '@/images/brands/gas-safe-register-logo-certified-brighton.png';
---

<article class='p-5 sm:p-6'>
  <div class='flex items-start gap-4 sm:gap-5 xl:flex-col xl:gap-4'>
    <Image
      src={gasSafe}
      alt='Gas Safe Register logo'
      width={180}
      height={64}
      class='h-10 w-auto shrink-0 object-contain sm:h-12'
      format='webp'
      quality={90}
    />
    <div>
      <Text tag='h3' variant='displayXS' class='font-semibold text-primary-900'>
        Gas Safe registered
      </Text>
      <Text tag='p' variant='textSM' class='mt-2 leading-relaxed text-neutral-700'>
        Certified engineers for safe, compliant gas work across Brighton &amp;
        Hove.
      </Text>
    </div>
  </div>
</article>
