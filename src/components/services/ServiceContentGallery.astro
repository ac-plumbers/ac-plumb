---
import Text from '@/components/fundations/elements/Text.astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';

type GalleryImage = {
  src: string;
  alt: string;
  title?: string;
};

const { images } = Astro.props as {
  images?: GalleryImage[];
};
---

{
  images && images.length > 0 && (
    <Wrapper variant='contentWide' class='mb-10'>
      <section class='mt-10'>
<div class='relative flex items-center gap-4'>
          <div class='h-px flex-1 bg-slate-200'></div>
          <Text tag='h2' variant='displaySM' class='text-base-900 font-semibold'>
            Gallery
          </Text>
          <div class='h-px flex-1 bg-slate-200'></div>
        </div>
        <div
          class={`mt-4 grid grid-cols-1 gap-4 ${images.length === 1 ? 'mx-auto max-w-4xl' : images.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
          {images.slice(0, 6).map((image, i) => (
            <div class={`group overflow-hidden rounded-xl shadow-sm transition-shadow duration-300 hover:shadow-lg ${images.length === 1 ? 'aspect-video' : 'aspect-3/4'}`}>
              <img
                src={image.src}
                alt={image.alt}
                title={image.title || image.alt}
                class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
                loading='lazy'
                width='600'
                height='800'
              />
            </div>
          ))}
        </div>
      </section>
    </Wrapper>
  )
}
