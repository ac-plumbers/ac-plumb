---
import type { CollectionEntry } from "astro:content";
import Text from "../fundations/elements/Text.astro";

interface Props {
  services: CollectionEntry<"services">[];
}

const { services } = Astro.props;

const sortedServices = [...services].sort(
  (a, b) => (a.data.sortedOrder || 999) - (b.data.sortedOrder || 999)
);
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {sortedServices.map((service) => {
    const image = service.data.image || service.data.imageHero;
    const imageAlt = service.data.alt || service.data.title;
    return (
      <article class="service-card group relative overflow-hidden rounded-xl bg-white border border-neutral-200 shadow-sm hover:shadow-lg hover:border-primary-300 transition-all duration-300">
        <div class="flex h-full flex-col">

          {image && (
            <div class="aspect-4/4 overflow-hidden bg-neutral-100">
              <img
                src={image}
                alt={imageAlt}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                width="600"
                height="600"
              />
            </div>
          )}

          <!-- Card Content -->
          <div class="p-6 space-y-4 flex flex-1 flex-col">
            <!-- Service Title -->
            <Text
              tag="h3"
              variant="displayXS"
              class="text-xl font-bold text-neutral-900 transition-colors duration-200 leading-tight"
              transition:name={`service-title-${service.id}`}>
              <a
                href={`/services/${service.id}`}
                class="inline-block hover:text-primary-600 focus-visible:outline-2 focus-visible:outline-primary-400 focus-visible:outline-offset-4">
                {service.data.title}
              </a>
            </Text>

            <!-- Service Description -->
            <Text
              tag="p"
              variant="textBASE"
              class="text-neutral-700 leading-relaxed line-clamp-3">
              {service.data.intro}
            </Text>

            <!-- CTA -->
            <div class="flex items-end justify-between pt-2 border-t border-neutral-100 mt-auto">
              <a
                href={`/services/${service.id}`}
                class="inline-flex items-center text-primary-600 font-semibold text-sm hover:translate-x-1 transition-transform duration-200 focus:outline-2 focus:outline-primary-400 focus:outline-offset-4"
                aria-label={`Learn more about ${service.data.title}`}
                tabindex="-1"
                aria-hidden="true">
                Learn more
                <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Hover Overlay Effect -->
          <div class="absolute inset-0 bg-linear-to-t from-primary-600/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
        </div>
      </article>
    );
  })}
</div>
