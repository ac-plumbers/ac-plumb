---
import { Image } from 'astro:assets';
import Text from '../components/fundations/elements/Text.astro';
import vaillant from '@/images/brands/vaillant-installer-logo-brighton-boilers.png';
import viesmann from '@/images/brands/viessmann-logo-boiler-installation-brighton.png';
import bpec from '@/images/brands/bpec-certification-logo-gas-plumbing.png';
import checktrade from '@/images/brands/checkatrade-logo-ac-plumbers-brighton.png';
import gasSafe from '@/images/brands/gas-safe-register-logo-certified-brighton.png';
import oftec from '@/images/brands/oftec-registered-logo-heating-certification-1.png';
---

<section
  class='relative overflow-hidden bg-slate-50 py-24 sm:py-32'
  id='certifications'>
  <div class='pointer-events-none absolute inset-0'>
    <div
      class='absolute inset-0 bg-linear-to-br from-white via-slate-50 to-slate-200 opacity-100'>
    </div>
  </div>
  <div class='relative mx-auto max-w-5xl px-6 lg:px-8'>
    <Text
      tag='h2'
      variant='displaySM'
      class='text-center font-semibold text-primary-900'>
      Fully Certified & Regulated
    </Text>
    <div
      class='mx-auto mt-10 grid max-w-lg grid-cols-4 items-center gap-x-8 gap-y-10 sm:max-w-xl sm:grid-cols-6 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5'
      aria-label='Brand certifications and partners'>
      <Image
        width={260}
        height={76}
        src={vaillant}
        alt='Vaillant Advance Installer certification'
        class='col-span-2 max-h-24 w-full object-contain lg:col-span-1'
        format='png'
      />

      <Image
        width={260}
        height={76}
        src={viesmann}
        alt='Viessmann certified installer'
        class='col-span-2 max-h-24 w-full object-contain lg:col-span-1'
        format='png'
      />

      <Image
        width={260}
        height={76}
        src={bpec}
        alt='BPEC certified gas and plumbing professional'
        class='col-span-2 max-h-24 w-full object-contain lg:col-span-1'
        format='webp'
        quality={90}
      />

      <Image
        width={260}
        height={76}
        src={checktrade}
        alt='Checkatrade verified tradesperson'
        class='col-span-2 max-h-24 w-full object-contain sm:col-start-2 lg:col-span-1'
        format='webp'
        quality={90}
      />

      <Image
        width={260}
        height={76}
        src={gasSafe}
        alt='Gas Safe Register certified engineer'
        class='col-span-2 col-start-2 max-h-24 w-full object-contain sm:col-start-auto lg:col-span-1'
        format='webp'
        quality={90}
      />
    </div>
  </div>
</section>
