---
import { Image } from 'astro:assets';
import vaillant from '@/images/brands/vaillant-installer-logo-brighton-boilers.jpg';
import viesmann from '@/images/brands/viessmann-logo-boiler-installation-brighton.jpg';
import bpec from '@/images/brands/bpec-certification-logo-gas-plumbing.png';
import checktrade from '@/images/brands/checkatrade-logo-ac-plumbers-brighton.png';
import gasSafe from '@/images/brands/gas-safe-register-logo-certified-brighton.png';
import oftec from '@/images/brands/oftec-registered-logo-heating-certification-1.png';
---

<section class='bg-primary-700 py-24 sm:py-32' id='certifications'>
  <div class='mx-auto max-w-7xl px-6 lg:px-8'>
    <h2 class='text-center text-2xl font-semibold text-white'>
      Fully Certified & Regulated
    </h2>
    <div
      class='mx-auto mt-10 grid max-w-lg grid-cols-4 items-center gap-x-8 gap-y-10 sm:max-w-xl sm:grid-cols-6 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-5'
      aria-label='Brand certifications and partners'>
      <Image
        width={158}
        height={48}
        src={vaillant}
        alt='Vaillant Advance Installer certification'
        class='col-span-2 max-h-12 w-full object-contain lg:col-span-1'
        format='webp'
        quality={90}
      />

      <Image
        width={158}
        height={48}
        src={viesmann}
        alt='Viessmann certified installer'
        class='col-span-2 max-h-12 w-full object-contain lg:col-span-1'
        format='webp'
        quality={90}
      />

      <Image
        width={158}
        height={48}
        src={bpec}
        alt='BPEC certified gas and plumbing professional'
        class='col-span-2 max-h-12 w-full object-contain lg:col-span-1'
        format='webp'
        quality={90}
      />

      <Image
        width={158}
        height={48}
        src={checktrade}
        alt='Checkatrade verified tradesperson'
        class='col-span-2 max-h-12 w-full object-contain sm:col-start-2 lg:col-span-1'
        format='webp'
        quality={90}
      />

      <Image
        width={158}
        height={48}
        src={gasSafe}
        alt='Gas Safe Register certified engineer'
        class='col-span-2 col-start-2 max-h-12 w-full object-contain sm:col-start-auto lg:col-span-1'
        format='webp'
        quality={90}
      />
    </div>
  </div>
</section>
