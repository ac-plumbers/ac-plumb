---
import { getCollection } from 'astro:content';
import Text from '@/components/fundations/elements/Text.astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';

const allAreas = await getCollection('areas');
const sorted = allAreas.sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99));
---

<section class='bg-neutral-50 py-16 sm:py-24'>
  <Wrapper variant='standard'>
    <!-- Section header -->
    <div class='mb-12 text-center'>
      <p
        class='font-lato text-xs font-bold uppercase tracking-[0.35em] text-accent-500'>
        Coverage
      </p>
      <Text
        tag='h2'
        variant='displayXL'
        class='mt-3 font-poppins font-black text-text-00'>
        Where We Work
      </Text>
      <Text tag='p' variant='textLG' class='mt-4 text-neutral-600'>
        Fast, reliable service across Brighton, Hove &amp; Sussex
      </Text>
    </div>

    <!-- Tag cloud -->
    <div
      class='flex flex-wrap justify-center gap-3'
      role='list'
      aria-label='Service areas'>
      {
        sorted.map(area => {
          const isPriority = area.data.level === 'Priority';
          return (
            <a
              href={`/areas-we-serve/${area.id.replace('.md', '')}`}
              role='listitem'
              class:list={[
                'group flex items-center gap-3 rounded-full border bg-white px-5 py-3 shadow-sm transition-all duration-200 hover:shadow-md focus:outline-2 focus:outline-offset-2',
                isPriority
                  ? 'border-primary-200 hover:border-primary-400 hover:bg-primary-50 focus:outline-primary-600'
                  : 'border-neutral-200 hover:border-neutral-400 hover:bg-neutral-100 focus:outline-neutral-600',
              ]}>
              {/* Level dot */}
              <span
                class:list={[
                  'h-2.5 w-2.5 shrink-0 rounded-full transition-transform duration-200 group-hover:scale-125',
                  isPriority ? 'bg-primary-500' : 'bg-neutral-400',
                ]}
                aria-hidden='true'
              />

              {/* Area name */}
              <span
                class:list={[
                  'font-poppins text-sm font-semibold transition-colors duration-200',
                  isPriority
                    ? 'text-text-00 group-hover:text-primary-700'
                    : 'text-text-00 group-hover:text-neutral-700',
                ]}>
                {area.data.area}
              </span>

              {/* Detail — slides in on hover */}
              <span class='flex max-w-0 items-center gap-1.5 overflow-hidden whitespace-nowrap font-lato text-xs text-neutral-500 transition-[max-width] duration-300 ease-in-out group-hover:max-w-48'>
                <span aria-hidden='true'>·</span>
                {area.data.postcode}
                <span aria-hidden='true'>·</span>
                {area.data.responseTime}
              </span>
            </a>
          );
        })
      }
    </div>

    <!-- Legend -->
    <div
      class='mt-10 flex flex-wrap items-center justify-center gap-6 font-lato text-xs text-neutral-500'>
      <span class='flex items-center gap-2'>
        <span class='h-2.5 w-2.5 rounded-full bg-primary-500' aria-hidden='true'></span>
        Priority coverage — 15–20 min response
      </span>
      <span class='flex items-center gap-2'>
        <span class='h-2.5 w-2.5 rounded-full bg-neutral-400' aria-hidden='true'></span>
        Extended coverage — 20–40 min response
      </span>
    </div>
  </Wrapper>
</section>
