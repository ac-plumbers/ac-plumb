---
import { ArrowRight } from 'lucide-vue-next';
import Text from '../fundations/elements/Text.astro';
import Link from '../fundations/elements/Link.astro';
---

<section class='bg-white py-16'>
  <div class='mx-auto max-w-4xl px-4 sm:px-6 lg:px-8'>
    <div class='mb-12 text-center'>
      <Text tag='h2' variant='displayXL' class='font-bold text-text-00'>
        Service Area FAQs
      </Text>
    </div>

    <div class='space-y-6'>
      <details class='group rounded-lg border border-gray-200 bg-gray-50 p-6'>
        <summary
          class='flex cursor-pointer list-none items-center justify-between gap-4'>
          <Text tag='span' variant='textLG' class='font-semibold text-gray-900'>
            Do you charge extra for travel in Brighton & Hove?
          </Text>
          <ArrowRight
            class='h-5 w-5 text-gray-400 transition-transform group-open:rotate-90'
            aria-hidden='true'
          />
        </summary>
        <Text tag='p' variant='textBase' class='mt-4 text-gray-700'>
          No additional travel fees within our core Brighton & Hove coverage
          areas. For extended areas, we'll confirm any small surcharge before
          booking—always transparent, no surprises.
        </Text>
      </details>

      <details class='group rounded-lg border border-gray-200 bg-gray-50 p-6'>
        <summary
          class='flex cursor-pointer list-none items-center justify-between gap-4'>
          <Text tag='span' variant='textLG' class='font-semibold text-gray-900'>
            What are your working hours?
          </Text>
          <ArrowRight
            class='h-5 w-5 text-gray-400 transition-transform group-open:rotate-90'
            aria-hidden='true'
          />
        </summary>
        <Text tag='p' variant='textBase' class='mt-4 text-gray-700'>
          We work Monday to Friday during business hours, with flexible evening
          appointments available for planned work. We don't operate on weekends,
          but you can book appointments for the following week.
        </Text>
      </details>

      <details class='group rounded-lg border border-gray-200 bg-gray-50 p-6'>
        <summary
          class='flex cursor-pointer list-none items-center justify-between gap-4'>
          <Text tag='span' variant='textLG' class='font-semibold text-gray-900'>
            Don't see your area listed?
          </Text>
          <ArrowRight
            class='h-5 w-5 text-gray-400 transition-transform group-open:rotate-90'
            aria-hidden='true'
          />
        </summary>
        <Text tag='p' variant='textBase' class='mt-4 text-gray-700'>
          <Link
            href='/contact-us'
            variant='default-link'
            class='font-semibold text-primary-700 underline hover:text-primary-800'>
            Contact us
          </Link>
          {' '}with your postcode and we'll let you know if we can help. If
          we're unable to serve your location, we're happy to recommend a
          trusted local plumber from our network.
        </Text>
      </details>

      <details class='group rounded-lg border border-gray-200 bg-gray-50 p-6'>
        <summary
          class='flex cursor-pointer list-none items-center justify-between gap-4'>
          <Text tag='span' variant='textLG' class='font-semibold text-gray-900'>
            How quickly can you reach my area?
          </Text>
          <ArrowRight
            class='h-5 w-5 text-gray-400 transition-transform group-open:rotate-90'
            aria-hidden='true'
          />
        </summary>
        <Text tag='p' variant='textBase' class='mt-4 text-gray-700'>
          Response times vary by location. Brighton & Hove core areas typically
          15-20 minutes, coastal areas 20-30 minutes, and extended areas 40-60
          minutes. For urgent issues, we prioritize based on severity and aim to
          respond as quickly as possible.
        </Text>
      </details>
    </div>
  </div>
</section>
