---
import Text from '../fundations/elements/Text.astro';
import {
  Wrench,
  Thermometer,
  Flame,
  Shield,
  Droplet,
  Bath,
  Wind,
  Gauge,
} from '@lucide/astro';

const allServices = [
  { icon: Wrench, label: 'Plumbing, Heating & Gas' },
  { icon: Flame, label: 'Gas Boiler Installation' },
  { icon: Wind, label: 'Air Source Heat Pumps' },
  { icon: Gauge, label: 'Smart Thermostats' },
  { icon: Shield, label: 'Gas Safety Checks (CP12)' },
  { icon: Bath, label: 'Bathroom Installation' },
  { icon: Thermometer, label: 'Central Heating Systems' },
];
---

<section class='bg-white py-16'>
  <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
    <div class='mb-12 text-center'>
      <Text tag='h2' class='font-bold md:text-4xl'>
        Services Available Everywhere We Cover
      </Text>
      <p class='mt-4 text-lg text-gray-600'>
        Same quality standards in every location
      </p>
    </div>

    <div class='grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4'>
      {
        allServices.map(service => {
          const Icon = service.icon;
          return (
            <div class='rounded-lg border border-gray-200 bg-gray-50 p-6 text-center transition-colors hover:border-primary-300 hover:bg-primary-50'>
              <div class='mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-100'>
                <Icon class='h-6 w-6 text-primary-600' />
              </div>
              <p class='font-medium text-gray-900'>{service.label}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
