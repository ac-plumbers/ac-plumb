---
import { Shield, Users, Award, Wrench } from '@lucide/astro';
import Text from '@/components/fundations/elements/Text.astro';
import { BUSINESS_CONFIG } from '@/utils/businessConfig';

const whyChooseUs = [
  {
    icon: Shield,
    title: 'Gas Safe & Insured',
    description:
      'Fully qualified, insured and compliant across all areas we serve.',
  },
  {
    icon: Users,
    title: 'Local Engineers',
    description:
      'Brighton & Hove based team for quicker travel and better support.',
  },
  {
    icon: Award,
    title: 'Trusted Service',
    description: 'Established reputation with hundreds of satisfied customers.',
  },
  {
    icon: Wrench,
    title: 'Quality Workmanship',
    description: 'Professional work with guarantees and follow-up support.',
  },
];
---

<section class='bg-white py-16'>
  <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
    <div class='mb-12 text-center'>
      <Text tag='h2' variant='displayXL' class='font-bold text-text-00'>
        Why Choose {BUSINESS_CONFIG.name}?
      </Text>
      <Text tag='p' variant='textLG' class='mt-4 text-neutral-600'>
        Local expertise you can trust across all our coverage areas
      </Text>
    </div>

    <div class='grid gap-8 md:grid-cols-2 lg:grid-cols-4'>
      {
        whyChooseUs.map(point => {
          const Icon = point.icon;
          return (
            <div class='text-center'>
              <div class='mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-100'>
                <Icon class='h-8 w-8 text-primary-600' aria-hidden='true' />
              </div>
              <Text
                tag='h3'
                variant='textLG'
                class='mb-2 font-semibold text-text-00'>
                {point.title}
              </Text>
              <Text tag='p' variant='textBase' class='text-neutral-600'>
                {point.description}
              </Text>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
