---
import Text from '@/components/fundations/elements/Text.astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';
import CallButton from '@/components/fundations/elements/CallButton.astro';
import GetAQuote from '@/components/fundations/elements/GetAQuote.astro';
---

<section
  class='relative isolate flex min-h-[70vh] items-center overflow-hidden bg-primary-900'
  aria-labelledby='areas-hero-heading'>
  <!-- Blur blobs -->
  <div
    aria-hidden='true'
    class='absolute -top-40 -right-40 -z-10 h-[37.5rem] w-[37.5rem] rounded-full bg-secondary-400/10 blur-3xl'>
  </div>
  <div
    aria-hidden='true'
    class='absolute -bottom-40 left-20 -z-10 h-[25rem] w-[25rem] rounded-full bg-accent-500/10 blur-3xl'>
  </div>

  <Wrapper variant='standard' class='py-32 sm:py-40'>
    <!-- Kicker -->
    <p
      class='font-lato text-xs font-bold uppercase tracking-[0.35em] text-accent-400'>
      Brighton &amp; Hove
    </p>

    <!-- Heading -->
    <Text
      tag='h1'
      id='areas-hero-heading'
      variant='display2XL'
      class='mt-5 font-poppins font-black tracking-tight text-white'>
      Areas We Serve
    </Text>

    <!-- Gold rule -->
    <div class='mt-7 h-0.5 w-14 bg-accent-500' aria-hidden='true'></div>

    <!-- Subtext -->
    <Text
      tag='p'
      variant='textLG'
      class='mt-6 max-w-xl font-lato leading-relaxed text-primary-200'>
      Gas Safe registered engineers covering Brighton, Hove and across East
      &amp; West Sussex. Fast response times, transparent pricing, no hidden
      travel fees.
    </Text>

    <!-- Stats row -->
    <div
      class='mt-10 flex flex-wrap items-center gap-6 sm:gap-8'
      aria-label='Service statistics'>
      <div>
        <span class='font-poppins text-3xl font-black text-white'>11+</span>
        <p class='font-lato text-xs uppercase tracking-widest text-primary-300'>
          Areas covered
        </p>
      </div>
      <div class='h-8 w-px bg-primary-600' aria-hidden='true'></div>
      <div>
        <span class='font-poppins text-3xl font-black text-white'>15 min</span>
        <p class='font-lato text-xs uppercase tracking-widest text-primary-300'>
          Priority response
        </p>
      </div>
      <div class='h-8 w-px bg-primary-600' aria-hidden='true'></div>
      <div>
        <span class='font-poppins text-3xl font-black text-white'
          >Gas Safe</span
        >
        <p class='font-lato text-xs uppercase tracking-widest text-primary-300'>
          Registered
        </p>
      </div>
    </div>

    <!-- CTAs -->
    <div class='mt-10 flex flex-wrap gap-4'>
      <CallButton variant='accent' size='lg' animation='ring' />
      <GetAQuote variant='outline' size='lg' />
    </div>
  </Wrapper>
</section>
