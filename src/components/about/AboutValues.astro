---
import { Image } from 'astro:assets';
import { ThumbsUp, MessageSquare, ShieldCheck } from '@lucide/astro';
import antonioPortrait from '@/images/antonio/antonio-catalano-ac-plumbers-owner-portrait.jpeg';

const values = [
  {
    icon: ThumbsUp,
    title: 'Honest Advice',
    description:
      'No upselling, no unnecessary work. I tell you exactly what your system needs and give you clear options — so you can decide with confidence.',
  },
  {
    icon: MessageSquare,
    title: 'Clear Communication',
    description:
      "You'll always know what's happening, when I'm arriving, and what the work will cost. No hidden charges, no surprises on the invoice.",
  },
  {
    icon: ShieldCheck,
    title: 'High Standards',
    description:
      'Every job — big or small — gets the same care and attention to detail. Work that meets current regulations, built to last for years to come.',
  },
];
---

<section class='py-24 lg:py-32' aria-labelledby='values-title'>
  <div class='mx-auto max-w-7xl px-6 lg:px-8'>
    <div class='grid items-center gap-12 lg:grid-cols-2 lg:gap-20'>
      <!-- Left: portrait -->
      <div>
        <Image
          src={antonioPortrait}
          alt='Antonio Catalano, Gas Safe registered plumber and owner of AC Plumbers Ltd. Brighton, headshot portrait'
          class='w-full rounded-2xl object-cover shadow-xl'
          title='Antonio Catalano – Owner & Lead Engineer at AC Plumbers Ltd. Brighton'
          loading='lazy'
          width={600}
          height={480}
        />
      </div>

      <!-- Right: header + values -->
      <div>
        <p
          class='font-lato text-xs font-bold tracking-[0.35em] text-accent-500 uppercase'>
          The AC Plumbers Ltd. Way
        </p>
        <h2
          id='values-title'
          class='mt-3 font-poppins text-4xl leading-tight font-black text-neutral-900 sm:text-5xl'>
          What Every Job<br />Is Built On
        </h2>

        <dl class='mt-10 space-y-8'>
          {
            values.map(v => {
              const Icon = v.icon;
              return (
                <div class='grid grid-cols-[auto,1fr] items-start gap-x-4 gap-y-1'>
                  <div
                    class='flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary-400/20'
                    aria-hidden='true'>
                    <Icon class='h-6 w-6 text-primary-600' aria-hidden='true' />
                  </div>
                  <dt class='flex-1 font-poppins text-lg font-bold text-neutral-900'>
                    {v.title}
                  </dt>
                  <dd class='col-start-2 mt-1 font-lato text-base leading-relaxed text-neutral-600'>
                    {v.description}
                  </dd>
                </div>
              );
            })
          }
        </dl>
      </div>
    </div>
  </div>
</section>
