---
const values = [
  {
    number: '01',
    title: 'Honest Advice',
    description:
      'No upselling, no unnecessary work. I tell you exactly what your system needs and give you clear options — so you can decide with confidence.',
  },
  {
    number: '02',
    title: 'Clear Communication',
    description:
      "You'll always know what's happening, when I'm arriving, and what the work will cost. No hidden charges, no surprises on the invoice.",
  },
  {
    number: '03',
    title: 'High Standards',
    description:
      'Every job — big or small — gets the same care and attention to detail. Work that meets current regulations, built to last for years to come.',
  },
] as const;
---

<section
  class='bg-primary-900 py-24 lg:py-32'
  aria-labelledby='values-title'>

  <div class='mx-auto max-w-7xl px-6 lg:px-8'>

    <!-- Section header -->
    <div class='mb-16 max-w-lg'>
      <p class='font-lato text-xs font-bold uppercase tracking-[0.35em] text-accent-400'>
        The AC Plumbers Way
      </p>
      <h2
        id='values-title'
        class='mt-3 font-poppins text-4xl font-black leading-tight text-white sm:text-5xl'>
        What Every Job<br />Is Built On
      </h2>
    </div>

    <!-- Value cards -->
    <div class='grid gap-px bg-white/[0.08] overflow-hidden rounded-2xl sm:grid-cols-3'>
      {values.map((v) => (
        <div class='group relative bg-primary-900 p-8 lg:p-10 transition-colors duration-300 hover:bg-primary-800'>
          <!-- Number -->
          <p
            class='font-poppins text-7xl font-black leading-none text-accent-500/20 transition-colors duration-300 group-hover:text-accent-500/30'
            aria-hidden='true'>
            {v.number}
          </p>
          <!-- Title -->
          <h3 class='mt-5 font-poppins text-xl font-bold text-white'>
            {v.title}
          </h3>
          <!-- Gold rule -->
          <div
            class='mt-3 h-0.5 w-8 bg-accent-500 transition-all duration-300 group-hover:w-12'
            aria-hidden='true'>
          </div>
          <!-- Description -->
          <p class='mt-4 font-lato text-sm leading-relaxed text-primary-300'>
            {v.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
