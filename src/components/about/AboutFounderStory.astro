---
import { Image } from 'astro:assets';
import founderImage1 from '@/images/services/antonio-catalano-gas-boiler-servicing-safety-checks-brighton-hove.jpeg';
import work2 from '@/images/lavori/viessmann-boiler-installation-utility-room-brighton.jpeg';
import work3 from '@/images/lavori/freestanding-bathtub-installation-brighton.jpeg';
// Content
import founderImage from '@/images/antonio/antonio-catalano-ac-plumbers-brighton-plumber-on-site.jpeg';
import van from '@/images/antonio/antonio-catalano-ac-plumbers-brighton-van.jpeg';
import three from '@/images/about/360.jpeg';
---

<section class='py-24 lg:py-36' aria-labelledby='story-title'>
  <div class='mx-auto max-w-7xl px-6 lg:px-8'>
    <!-- Pull quote -->
    <!-- <div class='relative mb-20 lg:mb-28'>
      <span
        class='pointer-events-none absolute -top-8 -left-2 font-poppins text-[8rem] leading-none font-black text-primary-100 select-none sm:text-[10rem]'
        aria-hidden='true'>&ldquo;</span
      >
      <blockquote class='relative pl-6 sm:pl-10'>
        <p
          class='max-w-3xl font-poppins text-2xl leading-snug font-semibold text-primary-800 italic sm:text-3xl lg:text-4xl'>
          Honest advice, clear communication, and high standards on every job
          &mdash; whether it&rsquo;s a small repair or a complete system
          installation.
        </p>
        <footer class='mt-5'>
          <cite
            class='font-lato text-xs font-bold tracking-[0.3em] text-accent-700 uppercase not-italic'>
            Antonio Catalano &mdash; Founder, AC Plumbers Ltd.
          </cite>
        </footer>
      </blockquote>
    </div> -->

    <!-- Story + images grid -->
    <div class='grid items-start gap-16 lg:grid-cols-2 lg:gap-24'>
      <!-- Story text -->
      <div>
        <h2
          id='story-title'
          class='font-poppins text-3xl font-black tracking-tight text-primary-900 sm:text-4xl'>
          The Story Behind the Work
        </h2>

        <div class='mt-8 space-y-5 font-lato text-base leading-7 text-text-00'>
          <p class='text-lg leading-8 font-medium text-primary-800'>
            With nearly three decades of experience in plumbing and heating
            gained in Italy and the UK, I founded AC Plumbers Ltd. in 2016 with
            one clear purpose: to do the job right.
          </p>
          <p>
            With hands-on experience across a wide range of plumbing and heating
            services, I specialise in everything from general plumbing repairs
            to full heating system installations. I take pride in delivering
            work that is not only efficient and compliant with current
            regulations, but also built to last.
          </p>
          <p>
            My approach is simple: I treat every project with the same level of
            care and attention to detail regardless of size
          </p>
          <p>
            I stay up to date with the latest industry developments, including
            energy-efficient technologies and government-backed schemes, so I
            can offer customers modern, cost-effective solutions.
          </p>
          <p>
            At AC Plumbers Ltd., the goal is to provide a service you can trust,
            dependable, professional, and always focused on doing the job right.
          </p>
        </div>
      </div>

      <!-- Work photography collage -->
      <div class='grid grid-cols-2 gap-4'>
        <div class='col-span-2'>
          <Image
            src={founderImage1}
            alt='Antonio Catalano, Gas Safe engineer at AC Plumbers Ltd. Brighton, using a Kane 458 flue gas analyser to service a gas boiler'
            title='AC Plumbers Ltd. Brighton – Gas Boiler Service and Safety Check by Antonio Catalano'
            class='w-full rounded-2xl object-cover shadow-md'
            loading='lazy'
            width={760}
            height={480}
          />
        </div>
        <div>
          <Image
            src={van}
            alt='AC Plumbers Ltd. Brighton van with company branding'
            class='aspect-square w-full rounded-xl object-cover shadow-md'
            loading='lazy'
            width={380}
            height={380}
          />
        </div>
        <div>
          <Image
            src={three}
            alt='Freestanding bathtub installation by AC Plumbers in Brighton'
            class='aspect-square w-full rounded-xl object-cover shadow-md'
            loading='lazy'
            width={380}
            height={380}
          />
        </div>
      </div>
    </div>
  </div>
</section>
