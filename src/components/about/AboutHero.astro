---
import { Image } from 'astro:assets';
import antonio from '@/images/AC-Plumbers-Ltd-Antonio.jpeg';
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
---

<section
  class='relative isolate overflow-hidden'
  aria-labelledby='about-hero-title'>

  <div class='grid lg:min-h-[88vh] lg:grid-cols-2'>

    <!-- Left: dark content panel -->
    <div class='relative flex flex-col justify-center overflow-hidden bg-primary-900 px-8 py-28 sm:px-12 lg:px-16 xl:px-20'>

      <!-- Ghost watermark "30" -->
      <span
        class='pointer-events-none absolute -right-8 top-1/2 -translate-y-1/2 select-none font-poppins text-[16rem] font-black leading-none text-white/[0.04] lg:text-[22rem]'
        aria-hidden='true'>30</span>

      <!-- Kicker -->
      <p class='relative font-lato text-xs font-bold uppercase tracking-[0.35em] text-accent-400'>
        Founder &amp; Lead Engineer
      </p>

      <!-- Name -->
      <h1
        id='about-hero-title'
        class='relative mt-5 font-poppins text-5xl font-black leading-[1.02] tracking-tight text-white sm:text-6xl xl:text-7xl'>
        Antonio<br />
        <em class='not-italic text-accent-400'>Catalano</em>
      </h1>

      <!-- Gold rule -->
      <div class='relative mt-7 h-0.5 w-14 bg-accent-500' aria-hidden='true'></div>

      <!-- Stats -->
      <div class='relative mt-7 flex flex-wrap items-center gap-x-8 gap-y-4'>
        <div>
          <p class='font-poppins text-3xl font-black text-white'>~30</p>
          <p class='mt-0.5 font-lato text-xs uppercase tracking-widest text-primary-300'>Years&rsquo; Experience</p>
        </div>
        <div class='h-8 w-px bg-primary-700' aria-hidden='true'></div>
        <div>
          <p class='font-poppins text-3xl font-black text-white'>2016</p>
          <p class='mt-0.5 font-lato text-xs uppercase tracking-widest text-primary-300'>Founded</p>
        </div>
        <div class='h-8 w-px bg-primary-700' aria-hidden='true'></div>
        <div>
          <p class='font-poppins text-3xl font-black text-white'>IT &rarr; UK</p>
          <p class='mt-0.5 font-lato text-xs uppercase tracking-widest text-primary-300'>Trained</p>
        </div>
      </div>

      <!-- Bio lead -->
      <p class='relative mt-8 max-w-sm font-lato text-base leading-relaxed text-primary-200'>
        I&rsquo;m the person behind AC Plumbers Ltd. &mdash; a
        dedicated and reliable plumbing and heating specialist with
        a strong focus on quality workmanship and customer
        satisfaction.
      </p>

      <!-- CTAs -->
      <div class='relative mt-8 flex flex-wrap gap-3'>
        <a
          href='/contact-us'
          class='inline-flex items-center rounded-lg bg-accent-500 px-6 py-3 font-poppins text-sm font-semibold text-primary-900 transition-colors duration-200 hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 focus:ring-offset-primary-900'>
          Get a Free Quote
        </a>
        <a
          href='tel:01273680731'
          class='inline-flex items-center rounded-lg border border-white/20 px-6 py-3 font-poppins text-sm font-semibold text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/30 focus:ring-offset-2 focus:ring-offset-primary-900'>
          {BUSINESS_CONFIG.landline}
        </a>
      </div>
    </div>

    <!-- Right: portrait -->
    <div class='relative min-h-80 lg:min-h-0'>
      <!-- Gradient fade on the left edge to blend into the dark panel on desktop -->
      <div
        class='absolute inset-0 z-10 bg-linear-to-r from-primary-900/60 via-primary-900/10 to-transparent lg:from-primary-900/30'
        aria-hidden='true'>
      </div>
      <!-- Bottom fade for mobile -->
      <div
        class='absolute inset-x-0 bottom-0 z-10 h-32 bg-linear-to-t from-primary-900 lg:hidden'
        aria-hidden='true'>
      </div>
      <Image
        src={antonio}
        alt='Antonio Catalano, founder of AC Plumbers Ltd., Brighton'
        class='h-full w-full object-cover object-top'
        loading='eager'
        width={900}
        height={1100}
      />
    </div>

  </div>
</section>
