---
import { Image } from 'astro:assets';
import antonio from '@/images/AC-Plumbers-Ltd-Antonio.jpeg';
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
---

<section class='relative isolate overflow-hidden bg-primary-900' aria-labelledby='about-hero-title'>
  <Image
    src={antonio}
    alt=''
    aria-hidden='true'
    class='absolute inset-0 -z-10 size-full object-cover object-top opacity-30'
    loading='eager'
    width={900}
    height={1100}
  />

  <!-- Top decorative blur -->
  <div aria-hidden='true' class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80'>
    <div
      style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'
      class='relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-accent-400 to-secondary-400 opacity-20 sm:left-[calc(50%-30rem)] sm:w-288.75'>
    </div>
  </div>

  <div class='mx-auto max-w-7xl px-6 lg:px-8'>
    <div class='mx-auto max-w-2xl py-32 sm:py-48 lg:py-56'>
      <!-- Kicker badge -->
      <div class='hidden sm:mb-8 sm:flex sm:justify-center'>
        <div class='relative rounded-full px-3 py-1 text-sm/6 text-gray-400 ring-1 ring-white/10 hover:ring-white/20'>
          Founder &amp; Lead Engineer · 30+ Years&rsquo; Experience
        </div>
      </div>

      <div class='text-center'>
        <h1
          id='about-hero-title'
          class='font-poppins text-5xl font-semibold tracking-tight text-balance text-white sm:text-7xl'>
          Antonio <em class='text-accent-400 not-italic'>Catalano</em>
        </h1>
        <p class='mt-8 text-lg font-medium text-pretty text-gray-400 sm:text-xl/8'>
          I&rsquo;m the person behind AC Plumbers Ltd. &mdash; a dedicated and reliable plumbing
          and heating specialist based in Brighton, with a strong focus on quality workmanship
          and customer satisfaction.
        </p>

        <!-- Stats row -->
        <div class='mt-10 flex items-center justify-center gap-x-8 gap-y-4 flex-wrap'>
          <div>
            <p class='font-poppins text-3xl font-black text-white'>~30</p>
            <p class='mt-0.5 font-lato text-xs tracking-widest text-primary-300 uppercase'>Years&rsquo; Experience</p>
          </div>
          <div class='h-8 w-px bg-primary-700' aria-hidden='true'></div>
          <div>
            <p class='font-poppins text-3xl font-black text-white'>2016</p>
            <p class='mt-0.5 font-lato text-xs tracking-widest text-primary-300 uppercase'>Founded</p>
          </div>
          <div class='h-8 w-px bg-primary-700' aria-hidden='true'></div>
          <div>
            <p class='font-poppins text-3xl font-black text-white'>IT &rarr; UK</p>
            <p class='mt-0.5 font-lato text-xs tracking-widest text-primary-300 uppercase'>Trained</p>
          </div>
        </div>

        <!-- CTAs -->
        <div class='mt-10 flex items-center justify-center gap-x-6 flex-wrap gap-y-3'>
          <a
            href='/contact-us'
            class='rounded-md bg-accent-500 px-3.5 py-2.5 text-sm font-semibold text-primary-900 shadow-xs hover:bg-accent-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500'>
            Get a Free Quote
          </a>
          <a
            href={`tel:${BUSINESS_CONFIG.landline}`}
            class='text-sm/6 font-semibold text-white'>
            {BUSINESS_CONFIG.landline} <span aria-hidden='true'>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom decorative blur -->
  <div aria-hidden='true' class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]'>
    <div
      style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'
      class='relative left-[calc(50%+3rem)] aspect-1155/678 w-144.5 -translate-x-1/2 bg-linear-to-tr from-accent-400 to-secondary-400 opacity-20 sm:left-[calc(50%+36rem)] sm:w-288.75'>
    </div>
  </div>
</section>
