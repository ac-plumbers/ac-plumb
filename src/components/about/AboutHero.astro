---
import { Image } from 'astro:assets';
import team from '@/images/team/gas-boiler-installation-brighton-ac-plumbers.jpg';
/* Content for SEO */
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';
---

<section
  class='relative isolate overflow-hidden bg-linear-to-br from-primary-50 via-background-00 to-accent-50 pt-14'
  aria-labelledby='about-hero-title'>
  <div
    class='absolute inset-y-0 right-1/2 -z-10 -mr-96 w-[200%] origin-top-right skew-x-[-30deg] bg-background-00 shadow-xl ring-1 shadow-primary-600/10 ring-primary-100 sm:-mr-80 lg:-mr-96'
    aria-hidden='true'>
  </div>

  <div class='mx-auto max-w-7xl px-6 py-32 sm:py-40 lg:px-8'>
    <div
      class='mx-auto max-w-2xl lg:mx-0 lg:grid lg:max-w-none lg:grid-cols-2 lg:gap-x-16 lg:gap-y-8 xl:grid-cols-1 xl:grid-rows-1 xl:gap-x-8'>
      <h1
        id='about-hero-title'
        class='max-w-2xl text-4xl font-bold tracking-tight text-balance text-primary-600 sm:text-6xl lg:col-span-2 xl:col-auto'>
        Meet Antonio Catalano &mdash; The Person Behind AC Plumbers Ltd.
      </h1>

      <div class='mt-6 max-w-xl lg:mt-0 xl:col-end-1 xl:row-start-1'>
        <p class='text-lg leading-8 font-medium text-text-00 sm:text-xl'>
          My name is Antonio Catalano. With nearly three decades of experience
          in plumbing and heating &mdash; gained in Italy and the UK &mdash; I
          founded AC Plumbers Ltd. in 2016 with one goal: to deliver quality
          workmanship and honest service every single time.
        </p>
        <p class='mt-4 text-base leading-7 text-text-00'>
          I specialise in everything from general plumbing repairs to full
          heating system installations. Every job I take on is done to be
          efficient, compliant with current regulations, and built to last.
        </p>
        <p class='mt-4 text-base leading-7 text-text-00'>
          My approach is simple: honest advice, clear communication, and high
          standards on every job &mdash; whether it&rsquo;s a small repair or a
          complete system installation.
        </p>

        <div class='mt-8 flex items-center gap-x-6'>
          <a
            href='/contact-us'
            class='rounded-md bg-primary-600 px-6 py-3 text-sm font-semibold text-background-00 shadow-sm transition-colors duration-200 hover:bg-primary-700 focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 focus:outline-none'
            aria-describedby='contact-description'>
            Get Free Quote
          </a>
          <span id='contact-description' class='sr-only'
            >Contact us for a free consultation and quote</span
          >

          <a
            href='tel:01273680731'
            class='rounded-md px-2 py-1 text-sm leading-6 font-semibold text-primary-600 hover:text-primary-700 focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 focus:outline-none'>
            Call: {BUSINESS_CONFIG.mobilePhone}
            <span aria-hidden='true'>&rarr;</span>
          </a>
        </div>
      </div>

      <Image
        src={team}
        alt='Antonio Catalano, founder of AC Plumbers Ltd., carrying out a professional plumbing installation in Brighton'
        class='mt-10 aspect-6/5 w-full max-w-lg rounded-2xl object-cover shadow-lg sm:mt-16 lg:mt-0 lg:max-w-none xl:row-span-2 xl:row-end-2 xl:mt-36'
        loading='eager'
        width='640'
        height='512'
      />
    </div>
  </div>

  <div
    class='absolute inset-x-0 bottom-0 -z-10 h-24 bg-linear-to-t from-background-00 sm:h-32'
    aria-hidden='true'>
  </div>
</section>
