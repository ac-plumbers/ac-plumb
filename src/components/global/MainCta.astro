---
// Assets
import { Image } from 'astro:assets';
import CtaImage from '@/images/new-hero-img.jpeg';
// Fundations
import Text from '@/components/fundations/elements/Text.astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';
import Link from '@/components/fundations/elements/Link.astro';
---

<section class='py-12 lg:py-20'>
  <Wrapper variant='full'>
    <div
      class='overflow-hidden rounded-3xl bg-linear-to-br from-primary-700 via-primary-800 to-primary-900 shadow-2xl'>
      <div class='grid grid-cols-1 items-stretch lg:grid-cols-12'>
        <div class='p-8 sm:p-10 lg:col-span-7 lg:p-14 xl:p-16'>
          <Text
            tag='p'
            variant='textXS'
            class='font-semibold tracking-wider text-accent-300 uppercase'>
            Need help now?
          </Text>
          <Text
            tag='h2'
            variant='displayLG'
            class='mt-4 font-bold tracking-tight text-balance text-white'>
            Book trusted plumbing & heating support in Brighton &amp; Hove
          </Text>
          <Text
            tag='p'
            variant='textBase'
            class='mt-4 max-w-2xl leading-relaxed text-primary-100'>
            From boiler issues to urgent plumbing repairs, our certified
            engineers deliver fast, reliable service with clear communication
            and transparent pricing.
          </Text>

          <div class='mt-8 flex flex-wrap items-center gap-3 sm:gap-4'>
            <Link href='/contact-us' variant='accent-button' size='md'>
              Get a Free Quote
            </Link>
            <Link
              href='/services'
              variant='default-link'
              class='rounded-lg border border-white/30 px-4 py-2 text-white no-underline hover:bg-white/10 hover:text-white'>
              View All Services
            </Link>
          </div>

          <!-- Trust Indicators -->
          <div
            class='mt-12 flex flex-wrap items-center justify-center gap-8 text-white/80'>
            <div class='flex items-center text-sm'>
              <svg
                class='mr-2 h-5 w-5 text-green-400'
                fill='currentColor'
                viewBox='0 0 20 20'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              Free Quotes
            </div>
            <div class='flex items-center text-sm'>
              <svg
                class='mr-2 h-5 w-5 text-green-400'
                fill='currentColor'
                viewBox='0 0 20 20'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              24/7 Emergency
            </div>
            <div class='flex items-center text-sm'>
              <svg
                class='mr-2 h-5 w-5 text-green-400'
                fill='currentColor'
                viewBox='0 0 20 20'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              Gas Safe Registered
            </div>
            <div class='flex items-center text-sm'>
              <svg
                class='mr-2 h-5 w-5 text-green-400'
                fill='currentColor'
                viewBox='0 0 20 20'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              Fully Insured
            </div>
          </div>
        </div>

        <div class='relative min-h-72 lg:col-span-5 lg:min-h-full'>
          <div
            class='absolute inset-0 bg-linear-to-t from-primary-900/60 via-primary-900/10 to-transparent'
            aria-hidden='true'>
          </div>
          <Image
            src={CtaImage}
            alt='AC Plumbers engineer carrying out a professional heating service'
            class='h-full w-full object-cover'
            loading='lazy'
            width={900}
            height={700}
          />
        </div>
      </div>
    </div>
  </Wrapper>
</section>
