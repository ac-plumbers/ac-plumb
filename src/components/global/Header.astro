---
import Image from 'astro/components/Image.astro';
import Logo from '@/images/logo/ac-plumbers-ltd-logo-brighton-hove.svg';

import {
  BUSINESS_CONFIG,
  formatPhoneForTel,
  formatPhoneForDisplay,
} from '@/utils/businessConfig';

const phone = formatPhoneForTel(BUSINESS_CONFIG.mobilePhone);
const phoneDisplay = formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone);

const whatsappUrl = `https://wa.me/${BUSINESS_CONFIG.mobilePhone.replace('+', '').replace(/\s/g, '')}?text=Hi%20AC%20Plumbers%2C%20I%20need%20help%20with%20my%20plumbing`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href;
const inServices = currentPath.startsWith('/services');

const linkBase =
  'rounded-md px-2 py-1 text-lg font-semibold transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none';
const linkActive = 'bg-primary-600 text-white shadow-sm';
const linkInactive = 'text-text-00 hover:text-primary-600';

const serviceLinks = [
  {
    href: '/services/gas-boiler-installation',
    label: 'Gas Boiler Installation',
  },
  {
    href: '/services/boiler-servicing-and-repair',
    label: 'Boiler Servicing & Repairs',
  },
  {
    href: '/services/all-aspects-of-plumbing-heating-and-gas',
    label: 'Plumbing',
  },
  { href: '/services/central-heating-installation', label: 'Heating Services' },
  {
    href: '/services/gas-safety-checks-cp12',
    label: 'Gas Safety Checks (CP12)',
  },
  {
    href: '/services/renewable-air-source-heat-pump',
    label: 'Air Source Heat Pumps',
  },
];
---

<!-- Skip to main content -->
<a
  href='#main-content'
  class='default-button sr-only z-100 focus-visible:not-sr-only focus-visible:absolute focus-visible:top-2 focus-visible:left-2'>
  Skip to main content
</a>

<script>
  import '@tailwindplus/elements';
</script>

<header class='fixed inset-x-0 top-0 z-50 w-full bg-white shadow-lg'>
  <nav
    aria-label='Main navigation'
    class='flex items-center justify-between px-4 py-2 lg:px-6'>
    <!-- Logo -->
    <a
      href='/'
      class='-m-1.5 inline-flex shrink-0 items-center rounded-md p-2 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none'>
      <span class='sr-only'>{BUSINESS_CONFIG.name}</span>
      <Image
        src={Logo}
        alt=''
        width='300'
        height='300'
        class='h-auto w-20 object-contain sm:w-28 md:w-32 lg:w-28'
      />
    </a>

    <!-- Tagline -->
    <div
      class='hidden flex-1 justify-center sm:flex lg:flex-none lg:shrink-0 lg:justify-start'
      aria-hidden='true'>
      <span
        class='rounded-full px-2 py-2 text-base font-bold text-primary-600 lg:ml-2 xl:px-4 xl:text-xl'>
        Plumbing &bull; Heating &bull; Renewable
      </span>
    </div>

    <!-- Mobile hamburger -->
    <div class='ml-auto flex lg:hidden'>
      <button
        type='button'
        command='show-modal'
        commandfor='mobile-menu'
        class='-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-text-00 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:outline-none'>
        <span class='sr-only'>Open main menu</span>
        <svg
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.5'
          aria-hidden='true'
          class='size-8'>
          <path
            d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'
            stroke-linecap='round'
            stroke-linejoin='round'></path>
        </svg>
      </button>
    </div>

    <!-- Desktop nav -->
    <el-popover-group
      class='hidden lg:flex lg:flex-1 lg:items-center lg:justify-center lg:gap-x-4'>
      <!-- Home -->
      <a
        href='/'
        data-nav-href='/'
        aria-current={isActive('/') ? 'page' : undefined}
        class:list={[linkBase, isActive('/') ? linkActive : linkInactive]}>
        Home
      </a>

      <!-- Services dropdown -->
      <div class='relative'>
        <button
          id='services-trigger'
          popovertarget='desktop-menu-services'
          data-nav-href='/services'
          aria-current={inServices ? 'page' : undefined}
          class:list={[
            'flex items-center gap-x-1',
            linkBase,
            inServices ? linkActive : linkInactive,
          ]}>
          Services
          <svg
            viewBox='0 0 20 20'
            fill='currentColor'
            aria-hidden='true'
            class='size-4 flex-none'>
            <path
              d='M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z'
              clip-rule='evenodd'
              fill-rule='evenodd'></path>
          </svg>
        </button>

        <div
          id='desktop-menu-services'
          popover='auto'
          class='services-dropdown w-56 overflow-hidden rounded-lg bg-white shadow-lg ring-1 ring-gray-900/5 outline-none'>
          <div class='py-2'>
            <a
              href='/services'
              aria-current={isActive('/services') ? 'page' : undefined}
              class='block border-b border-gray-100 px-4 py-2 text-sm font-medium text-text-00 hover:bg-accent-500/10 hover:text-primary-600 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:outline-none focus-visible:ring-inset'>
              All Services
            </a>
            {
              serviceLinks.map(({ href, label }) => (
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  class='block px-4 py-2 text-sm text-text-00 hover:bg-accent-500/10 hover:text-primary-600 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:outline-none focus-visible:ring-inset'>
                  {label}
                </a>
              ))
            }
          </div>
          <div
            class='grid grid-cols-2 divide-x divide-gray-100 border-t border-gray-100 bg-gray-50'>
            <a
              href='/services'
              class='flex items-center justify-center gap-x-2 p-3 text-sm font-semibold text-text-00 hover:bg-gray-100 hover:text-primary-600'>
              <svg
                viewBox='0 0 20 20'
                fill='currentColor'
                aria-hidden='true'
                class='size-4 flex-none text-gray-400'>
                <path
                  clip-rule='evenodd'
                  fill-rule='evenodd'
                  d='M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z'></path>
              </svg>
              Our Work
            </a>
            <a
              href={`tel:${phone}`}
              class='flex items-center justify-center gap-x-2 p-3 text-sm font-semibold text-text-00 hover:bg-gray-100 hover:text-primary-600'>
              <svg
                viewBox='0 0 20 20'
                fill='currentColor'
                aria-hidden='true'
                class='size-4 flex-none text-gray-400'>
                <path
                  d='M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z'
                  clip-rule='evenodd'
                  fill-rule='evenodd'></path>
              </svg>
              Call Us Now
            </a>
          </div>
        </div>
      </div>

      <!-- About -->
      <a
        href='/about-us'
        data-nav-href='/about-us'
        aria-current={isActive('/about-us') ? 'page' : undefined}
        class:list={[
          linkBase,
          isActive('/about-us') ? linkActive : linkInactive,
        ]}>
        About
      </a>

      <!-- Contact -->
      <a
        href='/contact-us'
        data-nav-href='/contact-us'
        aria-current={isActive('/contact-us') ? 'page' : undefined}
        class:list={[
          linkBase,
          isActive('/contact-us') ? linkActive : linkInactive,
        ]}>
        Contact
      </a>
    </el-popover-group>

    <!-- Desktop CTA -->
    <div class='hidden lg:flex lg:items-center lg:gap-x-3'>
      <a
        href={whatsappUrl}
        data-umami-event='lead_whatsapp_click'
        data-umami-event-placement='header'
        target='_blank'
        rel='noopener noreferrer'
        class='flex items-center gap-x-2 rounded-md px-3 py-2 text-lg font-medium text-green-700 transition-colors duration-200 hover:bg-green-50 hover:text-green-800 focus-visible:ring-2 focus-visible:ring-green-600 focus-visible:ring-offset-2 focus-visible:outline-none'>
        <svg
          class='size-5'
          fill='currentColor'
          viewBox='0 0 24 24'
          aria-hidden='true'>
          <path
            d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488'
          ></path>
        </svg>
        <span>WhatsApp</span>
        <span class='sr-only'>(opens in new tab)</span>
      </a>
      <a
        href='/contact-us'
        class='inline-flex items-center justify-center gap-2 rounded-lg bg-primary-600 px-5 py-2.5 text-lg font-semibold text-white shadow-lg ring-2 shadow-primary-600/30 ring-primary-300/50 transition-all duration-300 hover:scale-105 hover:bg-primary-700 focus:ring-4 focus:ring-primary-300/50 focus:outline-none active:scale-95'
        aria-label='Get a free quote'>
        Free Quote
        <svg
          class='h-4 w-4'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='2'
          stroke='currentColor'
          aria-hidden='true'>
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3'></path>
        </svg>
      </a>
    </div>
  </nav>

  <!-- Mobile menu -->
  <el-dialog>
    <dialog id='mobile-menu' aria-label='Navigation menu' class='backdrop:bg-black/40 lg:hidden'>
      <div tabindex='0' class='fixed inset-0 focus:outline-none'>
        <el-dialog-panel
          class='fixed inset-y-0 right-0 z-50 flex w-full flex-col bg-white sm:max-w-sm sm:shadow-2xl sm:ring-1 sm:ring-gray-900/10'>
          <!-- Panel header -->
          <div
            class='flex shrink-0 items-center justify-between border-b border-gray-100 px-6 pt-6 pb-4'>
            <a
              href='/'
              class='-m-1.5 rounded focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none'>
              <span class='sr-only'>{BUSINESS_CONFIG.name} — home</span>
              <img
                src='/images/logo/ac-plumbers-ltd-logo-brighton.svg'
                alt=''
                class='h-10 w-auto'
              />
            </a>
            <button
              type='button'
              command='close'
              commandfor='mobile-menu'
              class='-m-2.5 rounded-md p-2.5 text-gray-400 hover:text-gray-600 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none'>
              <span class='sr-only'>Close menu</span>
              <svg
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
                aria-hidden='true'
                class='size-6'>
                <path
                  d='M6 18 18 6M6 6l12 12'
                  stroke-linecap='round'
                  stroke-linejoin='round'></path>
              </svg>
            </button>
          </div>

          <!-- Nav links -->
          <div class='flex-1 overflow-y-auto px-6 py-6'>
            <div class='space-y-1'>
              <a
                href='/'
                data-nav-href='/'
                aria-current={isActive('/') ? 'page' : undefined}
                class='-mx-3 block rounded-lg px-3 py-2 text-lg font-semibold text-gray-800 hover:bg-primary-50 hover:text-primary-700'>
                Home
              </a>

              <!-- Services accordion -->
              <div class='-mx-3'>
                <button
                  type='button'
                  data-nav-href='/services'
                  aria-current={inServices ? 'page' : undefined}
                  command='--toggle'
                  commandfor='mobile-services'
                  class='flex w-full items-center justify-between rounded-lg py-2 pr-3.5 pl-3 text-lg font-semibold text-gray-800 hover:bg-primary-50 hover:text-primary-700'>
                  Services
                  <svg
                    viewBox='0 0 20 20'
                    fill='currentColor'
                    aria-hidden='true'
                    class='size-5 flex-none transition-transform in-aria-expanded:rotate-180'>
                    <path
                      d='M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z'
                      clip-rule='evenodd'
                      fill-rule='evenodd'></path>
                  </svg>
                </button>
                <el-disclosure
                  id='mobile-services'
                  hidden
                  class='mt-1 block space-y-1'>
                  <a
                    href='/services'
                    class='block rounded-lg py-2 pr-3 pl-6 text-sm font-semibold text-gray-800 hover:bg-primary-50 hover:text-primary-700'>
                    All Services
                  </a>
                  {
                    serviceLinks.map(({ href, label }) => (
                      <a
                        href={href}
                        class='block rounded-lg py-2 pr-3 pl-6 text-sm text-gray-600 hover:bg-primary-50 hover:text-primary-700'>
                        {label}
                      </a>
                    ))
                  }
                  <a
                    href='/services'
                    class='block rounded-lg py-2 pr-3 pl-6 text-sm text-gray-600 hover:bg-primary-50 hover:text-primary-700'>
                    Our Work
                  </a>
                  <a
                    href={`tel:${phone}`}
                    class='block rounded-lg py-2 pr-3 pl-6 text-sm text-gray-600 hover:bg-primary-50 hover:text-primary-700'>
                    Call Us Now
                  </a>
                </el-disclosure>
              </div>

              <a
                href='/about-us'
                data-nav-href='/about-us'
                aria-current={isActive('/about-us') ? 'page' : undefined}
                class='-mx-3 block rounded-lg px-3 py-2 text-lg font-semibold text-gray-800 hover:bg-primary-50 hover:text-primary-700'>
                About
              </a>
              <a
                href='/contact-us'
                data-nav-href='/contact-us'
                aria-current={isActive('/contact-us') ? 'page' : undefined}
                class='-mx-3 block rounded-lg px-3 py-2 text-lg font-semibold text-gray-800 hover:bg-primary-50 hover:text-primary-700'>
                Contact
              </a>
            </div>
          </div>

          <!-- Need help now? — pinned to bottom -->
          <div class='shrink-0 bg-primary-800 px-6 py-5'>
            <p class='mb-3 text-xs font-semibold tracking-widest text-primary-300 uppercase'>
              Need help now?
            </p>
            <div class='flex flex-col gap-2'>
              <a
                href={`tel:${phone}`}
                data-umami-event='lead_call_click'
                data-umami-event-placement='mobile-menu'
                class='flex items-center justify-center gap-2 rounded-lg bg-white px-4 py-3 text-sm font-bold text-primary-800 transition-colors hover:bg-primary-50 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary-800 focus-visible:outline-none'>
                <svg
                  class='h-4 w-4 shrink-0'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke-width='2'
                  stroke='currentColor'
                  aria-hidden='true'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 6.75z'
                  ></path>
                </svg>
                {phoneDisplay}
              </a>
              <a
                href={whatsappUrl}
                data-umami-event='lead_whatsapp_click'
                data-umami-event-placement='mobile-menu'
                target='_blank'
                rel='noopener noreferrer'
                class='flex items-center justify-center gap-2 rounded-lg border border-primary-600 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-700 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary-800 focus-visible:outline-none'>
                <svg
                  class='h-4 w-4 shrink-0'
                  fill='currentColor'
                  viewBox='0 0 24 24'
                  aria-hidden='true'>
                  <path
                    d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488'
                  ></path>
                </svg>
                WhatsApp us
                <span class='sr-only'>(opens in new tab)</span>
              </a>
            </div>
          </div>
        </el-dialog-panel>
      </div>
    </dialog>
  </el-dialog>
</header>

<script>
  // Update active nav links on Astro SPA navigation
  function updateActiveLinks(path: string) {
    const linkBase =
      'rounded-md px-2 py-1 text-lg font-semibold transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none';
    const linkActive = 'bg-primary-600 text-white shadow-sm';
    const linkInactive = 'text-text-00 hover:text-primary-600';

    document
      .querySelectorAll<HTMLElement>('header [data-nav-href]')
      .forEach(el => {
        const href = el.dataset.navHref ?? '';
        const active =
          href === '/services'
            ? path.startsWith('/services')
            : href === '/'
              ? path === '/'
              : path === href;

        if (active) el.setAttribute('aria-current', 'page');
        else el.removeAttribute('aria-current');
        // Only apply desktop pill classes outside the mobile dialog
        if (!el.closest('dialog')) {
          linkActive.split(' ').forEach(c => el.classList.toggle(c, active));
          linkInactive.split(' ').forEach(c => el.classList.toggle(c, !active));
        }
      });
  }

  function setupServicesDropdown() {
    const trigger = document.getElementById('services-trigger') as HTMLElement | null;
    const dropdown = document.getElementById('desktop-menu-services') as HTMLElement | null;
    if (!trigger || !dropdown) return;
    trigger.addEventListener('click', () => {
      const r = trigger.getBoundingClientRect();
      dropdown.style.top = r.bottom + 8 + 'px';
      dropdown.style.left = r.left + 'px';
    });
  }

  setupServicesDropdown();

  document.addEventListener('astro:page-load', () => {
    updateActiveLinks(window.location.pathname);
    setupServicesDropdown();
  });
</script>

<style>
  .services-dropdown {
    position: fixed;
    margin: 0;
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity 0.2s ease-out,
      translate 0.2s ease-out,
      display 0.2s ease-out allow-discrete;
  }
  .services-dropdown:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .services-dropdown:popover-open {
      opacity: 0;
      translate: 0 4px;
    }
  }

  /* Mobile menu active link */
  dialog a[aria-current="page"],
  dialog button[aria-current="page"] {
    background-color: var(--color-primary-50, #e6f4f7);
    color: var(--color-primary-600, #176776);
    font-weight: 700;
  }
</style>
