---
import { Image } from 'astro:assets';
import imgFooter from '@/images/prova-footer.jpg.avif';

// Busineess Config
import { BUSINESS_CONFIG, fullYear } from '@/utils/businessConfig';

// Services Links
const servicesLinks = [
  {
    href: '/services/gas-boiler-installation',
    label: 'Gas Boilers Installation',
  },
  {
    href: '/services/boiler-servicing-and-repair',
    label: 'Boiler Servicing & Repairs',
  },
  {
    href: '/services/all-aspects-of-plumbing-heating-and-gas',
    label: 'Plumbing',
  },
  { href: '/services/central-heating-installation', label: 'Heating' },

  { href: '/services/gas-safety-checks-cp12', label: 'Gas Safety (CP12)' },
  {
    href: '/services/renewable-air-source-heat-pump',
    label: 'Heat Pumps & Electric Boilers',
  },

  { href: '/landlords', label: 'Landlord Services' },
];

const areasLinks = [
  { href: '/areas-we-serve/brighton', label: 'Brighton' },
  { href: '/areas-we-serve/hove', label: 'Hove' },
  { href: '/areas-we-serve/rottingdean', label: 'Rottingdean' },
  { href: '/areas-we-serve/saltdean', label: 'Saltdean' },
  { href: '/areas-we-serve/peacehaven', label: 'Peacehaven' },
  { href: '/areas-we-serve/lewes', label: 'Lewes' },
  { href: '/areas-we-serve/hassocks', label: 'Hassocks' },
  { href: '/areas-we-serve/portslade', label: 'Portslade' },
  { href: '/areas-we-serve/southwick', label: 'Southwick' },
  { href: '/areas-we-serve/shoreham-by-sea', label: 'Shoreham by Sea' },
  { href: '/areas-we-serve/lancing', label: 'Lancing' },
  { href: '/areas-we-serve', label: 'See All Areas' },
];

const companyLinks = [
  { href: '/about-us', label: 'About Us' },
  { href: '/gallery', label: 'Our Work' },
  { href: '/contact-us', label: 'Contact Us' },
  { href: '/testimonials', label: 'Customer Reviews' },
  { href: '/frequently-asked-questions', label: 'FAQs' },
];

const legalLinks = [
  { href: '/terms-and-conditions', label: 'Terms and Conditions' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/cookie-policy', label: 'Cookie Policy' },
  { href: '/ai-policy', label: 'AI Policy' },
];
// Images
import logo from '@/images/logo/ACPL-Logo-Reversed-sp.svg';
import Text from '../fundations/elements/Text.astro';
/* TODO: change the name of the logo file if needed */
---

<footer
  class='relative bg-primary-800'
  data-bg='dark'
  aria-labelledby='footer-company-heading'>
  <!-- Background image with overlay -->
  <Image
    src={imgFooter}
    alt=''
    class='absolute inset-0 h-full w-full object-cover'
    aria-hidden='true'
  />
  <!-- Dark overlay for readability -->
  <div class='absolute inset-0 h-full w-full bg-black/40'></div>
  <div class='bg-center-60 absolute inset-0 h-full w-full'></div>
  <div class='absolute inset-0 h-full w-full bg-black/20'></div>
  <div
    class='max-w-8xl relative mx-auto px-6 pt-8 pb-4 sm:pt-12 lg:px-8 lg:pt-16'>
    <div class='xl:grid xl:grid-cols-5 xl:gap-8'>
      <!-- Company Info Column -->
      <div class='space-y-8'>
        <Image
          src={logo}
          width={120}
          height={120}
          alt='AC Plumbers Ltd logo with water and flame icons'
          title='AC Plumbers Ltd – Plumbing, Heating & Gas Services in Brighton'
          class='w-24 lg:scale-115'
        />
        <Text
          tag='h3'
          variant='displayMD'
          id='footer-company-heading'
          class='text-balance text-white'>
          {BUSINESS_CONFIG.nameSmall}<sup
            class='relative -top-[0.70em] ml-1 text-[0.35em] leading-none'
            >Ltd.</sup
          >
        </Text>
        <Text
          tag='p'
          variant='textBase'
          class='font-lato leading-relaxed text-neutral-100'>
          Brighton & Hove and surrounding <br />
          Gas Safe Registered Engineers
        </Text>

        <div class='flex gap-x-6'>
          <!-- social links remain unchanged -->
        </div>
      </div>

      <!-- Main Links Section - Now spans 4 columns -->
      <div
        class='mt-16 grid grid-cols-2 gap-8 sm:grid-cols-4 xl:col-span-4 xl:mt-0'>
        <!-- Services Column -->
        <div>
          <Text
            tag='h3'
            variant='textLG'
            class='font-lato font-semibold text-white'>
            Services
          </Text>
          <ul role='list' class='mt-6 space-y-4 font-lato'>
            {
              servicesLinks.map(link => (
                <li>
                  <Text
                    tag='a'
                    href={link.href}
                    variant='textBase'
                    class='font-lato text-white transition hover:text-accent-400 focus-visible:text-primary-600'>
                    {link.label}
                  </Text>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- NEW: Areas We Serve Column -->
        <div>
          <Text
            tag='h3'
            variant='textLG'
            class='font-lato font-semibold text-white'>
            Areas We Serve
          </Text>
          <ul role='list' class='mt-6 space-y-4 font-lato'>
            {
              areasLinks.map(link => (
                <li>
                  <Text
                    tag='a'
                    href={link.href}
                    variant='textBase'
                    class='font-lato text-white transition hover:text-accent-400 focus-visible:text-primary-600'>
                    {link.label}
                  </Text>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Company Column -->
        <div>
          <Text
            tag='h3'
            variant='textLG'
            class='font-lato font-semibold text-white'>
            Company
          </Text>
          <ul role='list' class='mt-6 space-y-4 font-lato'>
            {
              companyLinks.map(link => (
                <li>
                  <Text
                    tag='a'
                    href={link.href}
                    variant='textBase'
                    class='font-lato text-white transition hover:text-accent-400 focus-visible:text-primary-600'>
                    {link.label}
                  </Text>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Legal Column -->
        <div>
          <Text
            tag='h3'
            variant='textLG'
            class='font-lato font-semibold text-white'>
            Legal
          </Text>
          <ul role='list' class='mt-6 space-y-4 font-lato'>
            {
              legalLinks.map(link => (
                <li>
                  <Text
                    tag='a'
                    href={link.href}
                    variant='textBase'
                    class='font-lato text-white transition hover:text-accent-400 focus-visible:text-primary-600'>
                    {link.label}
                  </Text>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Certifications Section -->

    <!-- Copyright section - Updated with color palette -->
    <div class='mt-8 border-t border-white/10 pt-4 sm:mt-12 lg:mt-16'>
      <div
        class='flex flex-wrap items-center justify-center gap-2 text-center font-poppins text-sm/6 text-white sm:flex-nowrap'>
        <span
          >&copy; {fullYear()}
          {BUSINESS_CONFIG.name} All rights reserved.</span
        >
        <span class='hidden sm:inline'>|</span>
        <a
          href='https://agencyga.es'
          target='_blank'
          rel='noopener'
          class='flex items-center justify-center gap-1 text-xs text-accent-300 transition hover:text-primary-400'
          title='Website by agencyGA'>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            class='inline h-4 w-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            aria-hidden='true'
            focusable='false'>
            <ellipse cx='12' cy='12' rx='8' ry='10' stroke-width='2'></ellipse>
            <ellipse cx='9' cy='13' rx='1.5' ry='2.5' fill='#fff'></ellipse>
            <ellipse cx='15' cy='13' rx='1.5' ry='2.5' fill='#fff'></ellipse>
            <ellipse cx='9' cy='13' rx='0.8' ry='1.2' fill='#0ea5e9'></ellipse>
            <ellipse cx='15' cy='13' rx='0.8' ry='1.2' fill='#0ea5e9'></ellipse>
            <ellipse cx='12' cy='18' rx='2' ry='0.7' fill='#fff'></ellipse>
          </svg>
          AGA
        </a>
      </div>
    </div>
  </div>
</footer>
