---
import { Image } from 'astro:assets';
import img from '@/images/lavori/viessmann-boiler-closeup-brighton-installation.jpeg';
import antonio from '@/images/AC-Plumbers-Ltd-Antonio.jpeg';
import logoNew from '@/images/logo/ac-plumbers-ltd-logo-who-are-we.svg';
import Text from '../fundations/elements/Text.astro';
---

<section id='who-are-we' class='bg-primary-800 py-24 sm:py-32' data-bg='dark'>
  <div class='mx-auto max-w-7xl px-6 lg:px-8'>
    <div
      class='mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2'>
      <div class='lg:ml-auto lg:pt-4 lg:pl-4'>
        <div class='lg:max-w-lg'>
          <div class='mt-4 flex items-center gap-8 sm:gap-12'>
            <Image
              src={logoNew}
              alt='AC Plumbers Ltd logo with water and flame icons'
              title='AC Plumbers Ltd – Plumbing, Heating & Gas Services in Brighton'
              class='mt-6'
              width={100}
            />
            <Text
              tag='h2'
              variant='displayLG'
              class='mt-2 font-semibold tracking-tight text-pretty text-white'>
              Who We Are
            </Text>
          </div>
          <Text
            tag='p'
            variant='textLG'
            class='mt-6 max-w-xl text-base leading-8 text-neutral-100 sm:text-lg'>
            Established in 2016, AC Plumbers Ltd. has been proudly serving
            Brighton & Hove and the surrounding areas. As a locally based
            company, we are always on hand to provide a professional, reliable
            service with a strong focus on excellent customer care and
            high-quality workmanship. We cover all aspects of <a
              href='/services'
              class='rounded font-semibold text-accent-600 underline decoration-accent-400 underline-offset-4 hover:text-accent-700 hover:decoration-accent-600 focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 focus:outline-none'>
              plumbing, heating, gas services, boilers, and air source heat pump
              installations</a
            >. We are a Gas Safe registered company and an approved installer
            for Vaillant and Viessmann.
          </Text>
        </div>
      </div>
      <div class='flex items-start justify-center lg:order-first'>
        <Image
          width='2432'
          height='1442'
          src={antonio}
          alt='Antonio Catalano from AC Plumbers Ltd. in Brighton'
          class='h-96 w-[20rem] max-w-none rounded-xl object-cover object-top shadow-xl ring-1 ring-primary-500/20 sm:h-112 sm:w-[24rem] lg:h-128 lg:w-104'
          title='Antonio Catalano from AC Plumbers Ltd. – Plumbing, Heating & Gas Services in Brighton'
        />
      </div>
    </div>
  </div>
</section>
