---
// src/components/home/Services.astro
import ServicesGrid from '@/components/services/ServicesGrid.astro';
import { getCollection } from 'astro:content';
import Text from '../fundations/elements/Text.astro';
import GetACuote from '../fundations/elements/GetACuote.astro';

// Get featured services for homepage
const allServices = await getCollection('services');
const featuredServices = allServices
  .filter(service => service.data.featured)
  .slice(0, 6); // Show only 6 featured services on homepage
console.log(featuredServices.length);
---

<section
  id='services'
  class='bg-white py-16 sm:py-24'
  aria-labelledby='services-heading'>
  <div class='mx-auto max-w-7xl px-6 lg:px-8'>
    <!-- Section Header -->
    <div class='mx-auto mb-16 max-w-2xl text-center'>
      <Text
        tag='h2'
        variant='displayLG'
        id='services-heading'
        class='font-bold tracking-tight text-neutral-900'>
        Our Expert Services
      </Text>
      <Text tag='p' variant='textBase' class='mt-4 text-neutral-600'>
        Professional plumbing, heating, and gas services across Brighton & Hove.
        From emergency repairs to complete installations.
      </Text>
    </div>

    <!-- Services Grid -->
    <ServicesGrid services={featuredServices} />

    <!-- View All Services CTA -->
    <div class='mt-12 text-center'>
      <GetACuote
        variant='primary'
        size='lg'
        href='/services'
        class=''
        text='View all Services'
      />
    </div>
  </div>
</section>
