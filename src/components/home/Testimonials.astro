---
import Text from '@components/fundations/elements/Text.astro';
import TestimonialsCard from '../global/TestimonialsCard.astro';
import Link from '../fundations/elements/Link.astro';
import Button from '../fundations/elements/Button.astro';
import Carousel from '../home/Carousel.vue';

import { Image } from 'astro:assets';

// Images
import checkaTrade from '@/images/brands/checkatrade-logo-ac-plumbers-brighton.png';
import google from '@/images/brands/g.webp';
import CallButton from '../fundations/elements/CallButton.astro';
import GetAQuote from '../fundations/elements/GetAQuote.astro';
import reviewsData from '@/data/reviews.json';
const reviews = [...reviewsData.reviews].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<!-- Modern Bento-Style Layout -->
<section
  id='testimonials'
  aria-labelledby='testimonials-heading'
  class='relative overflow-hidden pt-24 pb-48 sm:py-32'>
  <!-- Decorative Elements -->
  <div class='absolute inset-0 overflow-hidden opacity-10'>
    <div
      class='absolute -top-24 -right-20 h-64 w-64 rounded-full bg-accent-400 blur-3xl'>
    </div>
    <div
      class='absolute top-1/2 left-10 h-96 w-96 rounded-full bg-accent-300 blur-3xl'>
    </div>
  </div>

  <div class='relative mx-auto max-w-7xl px-6 lg:px-8'>
    <!-- Header -->
    <div class='mx-auto mb-20 max-w-2xl text-center'>
      <Text
        tag='p'
        variant='textBase'
        class='font-semibold tracking-wide text-accent-400 uppercase'>
        Customer Stories
      </Text>
      <Text
        tag='h2'
        id='testimonials-heading'
        variant='displayXL'
        class='mt-2 font-lato font-bold text-balance text-text-00'>
        What our clients say
      </Text>
      <Text tag='p' class='mt-6 font-lato text-lg leading-8 text-text-00'>
        Discover why our customers trust us for their plumbing and heating needs
      </Text>
    </div>

    <!-- Social Proof Logos -->
    <div class='mb-10 flex flex-wrap items-center justify-center gap-6'>
      <a
        href='https://g.page/r/CfBbyTh1_7W1EAI/review'
        target='_blank'
        rel='noopener'
        class='flex h-10 items-center gap-3 rounded-xl border border-neutral-200 bg-background-100 px-4 py-2 text-neutral-800 shadow transition hover:shadow-md'
        aria-label='Read our reviews on Google'>
        <Image
          src={google}
          alt='Google Reviews'
          width={220}
          height={72}
          class='h-14 w-auto object-contain'
        />
        <Text tag='span' variant='textSM' class='font-semibold'>
          Rated 5.0 ★ on Google
        </Text>
      </a>
      <a
        href='https://www.checkatrade.com/trades/acplumbingheatingbathroomsserviceslimited'
        target='_blank'
        rel='noopener'
        class='flex h-14 items-center rounded-xl border border-neutral-200 bg-white px-2 shadow transition hover:shadow-md'
        aria-label='Read our reviews on Checkatrade'>
        <Image
          src={checkaTrade}
          alt='AC Plumbers Ltd. on Checkatrade — verified Brighton plumber'
          width={220}
          height={72}
          class='block h-14 w-auto object-contain object-center'
        />
      </a>
    </div>
    <!-- Testimonials Grid with Animated Entry -->
    <div class='relative'>
      <Carousel client:load reviews={reviews} />
    </div>
  </div>
  <!-- Call to Action -->
  <div class='mt-20 text-center'>
    <GetAQuote
      variant='accent'
      size='lg'
      iconStyle='none'
      class='uppercase'
      data-umami-event='lead_quote_click'
      data-umami-event-placement='reviews_section'
      text='Contact Us'
    />
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "AC Plumbers Ltd.",
  "url": "https://acplumb.co.uk",
  "telephone": "+447535653850",
  "email": "info@acplumb.co.uk",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "21j Campbell Road",
    "addressLocality": "Brighton",
    "postalCode": "BN1 4QD",
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "50.8225",
    "longitude": "-0.1372"
  },
  "sameAs": [
    "https://www.checkatrade.com/trades/acplumbingheatingbathroomsserviceslimited",
    "https://g.page/r/CfBbyTh1_7W1EAI/review"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "10",
    "bestRating": "10",
    "worstRating": "1",
    "ratingCount": "134",
    "reviewCount": "134"
  }
})} />
