---
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
import { Image } from 'astro:assets';
import GetAQuote from '../fundations/elements/GetAQuote.astro';
import Text from '../fundations/elements/Text.astro';
import thermostat from '@/images/heroHome/tado-smart-thermostat-installation.jpeg';
import gasBolier from '@/images/heroHome/viessmann-gas-boiler-installation-copper-pipework.jpg';
import imgHeatPump from '@/images/services/vaillant-air-source-heat-pump-brighton-installation.jpeg';
import imgTapRepair from '@/images/services/kitchen-mixer-tap-replacement-leak-repair-brighton.jpg';
/* import imgThermostat from '@/images/services/nest-thermostat-installation-brighton.jpeg'; */
import imgBoilerInstall from '@/images/services/viessmann-boiler-installation-utility-room-brighton.jpeg';
import imgRadiator from '@/images/services/compact-cast-iron-radiator-bee-valve-saltdean.jpeg';
// Content for the hero section
const heroContent = {
  description:
    'We specialise in boiler installation, repair and maintenance, plumbing, heating & gas services. Proudly serving homeowners across Brighton & Hove and the surrounding areas with reliable and professional service.',
  cta: {
    text: 'Get A Quote',
    href: '/contact-us',
  },
};

const heroImages = [
  {
    src: imgHeatPump,
    alt: 'Air source heat pump outdoor unit installed at a Brighton property',
  },
  {
    src: imgTapRepair,
    alt: 'Kitchen mixer tap replacement during leak repair service in Brighton',
  },
  {
    src: thermostat,
    alt: 'Nest smart thermostat displaying 20 degrees heating temperature installed by AC Plumbers Ltd in Brighton and Hove',
    /* src: imgThermostat,
    alt: 'Nest smart thermostat setup for efficient heating control', */
  },
  {
    src: gasBolier,
    alt: 'Viessmann gas boiler installation with copper pipework and smart controls, fitted by AC Plumbers Ltd.',
  },
  {
    src: imgRadiator,
    alt: 'Cast iron radiator valve fitting and balancing on a home heating system',
  },
];
---

<section
  id='hero'
  aria-labelledby='hero-heading'
  class='relative isolate'
  data-bg='dark'>
  <div
    class='bg-linear-to-br from-primary-900 via-primary-800 to-secondary-800'>
    <div class='relative isolate'>
      <svg
        aria-hidden='true'
        class='absolute inset-x-0 top-0 -z-10 h-256 w-full mask-[radial-gradient(32rem_32rem_at_center,white,transparent)] stroke-primary-200/15'>
        <defs>
          <pattern
            id='1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84'
            width='200'
            height='200'
            x='50%'
            y='-1'
            patternUnits='userSpaceOnUse'>
            <path d='M.5 200V.5H200' fill='none'></path>
          </pattern>
        </defs>
        <svg x='50%' y='-1' class='overflow-visible fill-primary-900'>
          <path
            d='M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z'
            stroke-width='0'></path>
        </svg>
        <rect
          width='100%'
          height='100%'
          fill='url(#1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84)'
          stroke-width='0'></rect>
      </svg>
      <div
        aria-hidden='true'
        class='absolute top-0 right-0 left-1/2 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48'>
        <div
          style='clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)'
          class='aspect-801/1036 w-200.25 bg-linear-to-tr from-accent-500/40 to-secondary-400/40 opacity-80'>
        </div>
      </div>
      <div class='overflow-hidden'>
        <div
          class='mx-auto max-w-7xl px-6 pt-36 pb-32 sm:pt-60 lg:px-8 lg:pt-32'>
          <div
            class='mx-auto max-w-2xl gap-x-14 lg:mx-0 lg:flex lg:max-w-none lg:items-center'>
            <div
              class='relative w-full sm:pb-44 lg:max-w-xl lg:shrink-0 lg:pb-0 xl:max-w-2xl'>
              <Text
                tag='p'
                variant='textSM'
                class='inline-flex rounded-full bg-accent-500 px-4 py-1.5 font-semibold tracking-wide whitespace-nowrap text-primary-900 uppercase'>
                Brighton and Hove trusted engineers
              </Text>
              <!-- Hero heading and text -->
              <Text
                tag='h1'
                id='hero-heading'
                variant='displayLG'
                class='mt-5 leading-snug text-neutral-50'>
                <span slot='left-icon'> </span>
                Welcome to {BUSINESS_CONFIG.nameSmall}<sup
                  class='relative -top-[0.70em] ml-1 text-[0.35em] leading-none'
                  >Ltd.</sup
                >
                <br />
                your trusted local experts in plumbing, heating, gas and renewable
                energy
              </Text>
              <Text
                tag='p'
                class='mt-8 max-w-2xl text-primary-100'
                variant='textBase'>
                {heroContent.description}
              </Text>
              <div class='mt-10 flex items-center gap-x-6'>
                <GetAQuote
                  variant='accent'
                  size='lg'
                  text={heroContent.cta.text}
                  href={heroContent.cta.href}
                  class='uppercase'
                  data-umami-event='lead_quote_click'
                  data-umami-event-placement='home_hero'
                />
              </div>
            </div>
            <div
              class='mt-14 flex justify-end gap-8 sm:-mt-44 sm:justify-start sm:pl-20 lg:mt-0 lg:pl-0'>
              <div
                class='ml-auto w-44 flex-none space-y-8 pt-32 sm:ml-0 sm:pt-80 lg:order-last lg:pt-36 xl:order-0 xl:pt-80'>
                <div class='relative'>
                  <Image
                    src={heroImages[0].src}
                    alt={heroImages[0].alt}
                    class='aspect-2/3 w-full rounded-xl object-cover shadow-lg ring-1 ring-white/20'
                  />
                  <div
                    class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/20 ring-inset'>
                  </div>
                </div>
              </div>
              <div
                class='mr-auto w-44 flex-none space-y-8 sm:mr-0 sm:pt-52 lg:pt-36'>
                <div class='relative'>
                  <Image
                    src={heroImages[1].src}
                    alt={heroImages[1].alt}
                    class='aspect-2/3 w-full rounded-xl object-cover shadow-lg ring-1 ring-white/20'
                  />
                  <div
                    class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/20 ring-inset'>
                  </div>
                </div>
                <div class='relative'>
                  <Image
                    src={heroImages[2].src}
                    alt={heroImages[2].alt}
                    class='aspect-2/3 w-full rounded-xl object-cover shadow-lg ring-1 ring-white/20'
                  />
                  <div
                    class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/20 ring-inset'>
                  </div>
                </div>
              </div>
              <div class='w-44 flex-none space-y-8 pt-32 sm:pt-0'>
                <div class='relative'>
                  <Image
                    src={heroImages[3].src}
                    alt={heroImages[3].alt}
                    class='aspect-2/3 w-full rounded-xl object-cover shadow-lg ring-1 ring-white/20'
                  />
                  <div
                    class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/20 ring-inset'>
                  </div>
                </div>
                <div class='relative'>
                  <Image
                    src={heroImages[4].src}
                    alt={heroImages[4].alt}
                    class='aspect-2/3 w-full rounded-xl object-cover shadow-lg ring-1 ring-white/20'
                  />
                  <div
                    class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/20 ring-inset'>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
