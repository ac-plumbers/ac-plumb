---
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
import GetAQuote from '../fundations/elements/GetAQuote.astro';

const {
  buttonText = 'Contact Us',
  buttonHref = '/contact-us',
  sectionClass = '',
} = Astro.props;
---

<section
  aria-labelledby='service-review-cta-heading'
  class={`relative overflow-hidden bg-primary-800 py-16 sm:py-20 ${sectionClass}`}>
  <div class='absolute inset-0'>
    <div
      class='absolute -top-24 -left-20 h-64 w-64 rounded-full bg-secondary-500/20 blur-3xl'>
    </div>
    <div
      class='absolute -right-12 bottom-0 h-56 w-56 rounded-full bg-accent-500/20 blur-3xl'>
    </div>
  </div>

  <div class='relative mx-auto max-w-7xl px-6 lg:px-8'>
    <div
      class='grid gap-8 rounded-2xl border border-white/20 bg-white/10 p-8 backdrop-blur-sm sm:p-10 lg:grid-cols-[1.35fr_1fr] lg:items-center'>
      <div>
        <p
          class='text-sm font-semibold tracking-wide text-accent-400 uppercase'>
          Need A Reliable Plumber?
        </p>
        <h2
          id='service-review-cta-heading'
          class='mt-3 text-3xl font-bold text-white sm:text-4xl'>
          Get your quote today and let us handle the plumbing stress.
        </h2>
        <p class='mt-4 max-w-2xl text-base text-neutral-100'>
          From leaks and boiler issues to full heating upgrades, our local
          Brighton team is ready to help with clear pricing and fast response.
        </p>
      </div>

      <div class='flex flex-col gap-3 sm:flex-row lg:flex-col'>
        <GetAQuote
          variant='accent'
          size='md'
          iconStyle='none'
          href={buttonHref}
          text={buttonText}
          data-umami-event='lead_quote_click'
          data-umami-event-placement='cta_center_page'
        />

        <a
          href={`tel:${BUSINESS_CONFIG.mobilePhone}`}
          class='inline-flex items-center justify-center rounded-lg border border-secondary-300 px-6 py-3 text-base font-semibold text-secondary-50 transition-colors hover:bg-secondary-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-300'>
          Call {BUSINESS_CONFIG.mobilePhone}
        </a>
      </div>
    </div>
  </div>
</section>
