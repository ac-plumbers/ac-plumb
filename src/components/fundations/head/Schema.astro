---
import { Schema as AstroSchema } from "astro-seo-schema";
import { BUSINESS_CONFIG } from "@/utils/businessConfig";

const {
  type = "WebPage",
  title = "AC Plumbers Ltd. | Plumbing, Heating & Renewable Services in Brighton",
  url = BUSINESS_CONFIG.website,
  description = "AC Plumbers Ltd. provides top-notch plumbing, heating, and renewable energy services in Brighton. Our team is dedicated to delivering high-quality solutions with a focus on customer satisfaction.",
  email = BUSINESS_CONFIG.email,
  telephone = BUSINESS_CONFIG.landline,
  telephone2 = BUSINESS_CONFIG.mobilePhone,
  address = "21j Campbell Road",
  addressLocality = "Brighton",
  addressRegion = "East Sussex",
  postalCode = "BN1 4QD",
  addressCountry = "GB",
  image = BUSINESS_CONFIG.ogImage,
  logoImage = BUSINESS_CONFIG.logoImage,
  datePublished = "2017-01-04T21:17:16+00:00",
} = Astro.props;

const dateModified = new Date().toISOString().split('T')[0];
---

<AstroSchema
  item={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": type,
        "@id": url,
        url,
        name: title,
        isPartOf: { "@id": "https://acplumb.co.uk/#website" },
        about: { "@id": "https://acplumb.co.uk/#organization" },
        primaryImageOfPage: { "@id": "https://acplumb.co.uk/#primaryimage" },
        image: { "@id": "https://acplumb.co.uk/#primaryimage" },
        thumbnailUrl: image,
        datePublished,
        dateModified,
        description,
        breadcrumb: { "@id": "https://acplumb.co.uk/#breadcrumb" },
        inLanguage: "en-GB",
        potentialAction: [{ "@type": "ReadAction", target: [url] }],
      },
      {
        "@type": "Plumber",
        "@id": "https://acplumb.co.uk/#organization",
        name: "AC Plumbers, Heating & Bathrooms",
        url,
        email,
        telephone: [telephone, telephone2],
        address: {
          "@type": "PostalAddress",
          streetAddress: address,
          addressLocality,
          addressRegion,
          postalCode,
          addressCountry,
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 50.83484516058824,
          longitude: -0.1414027180757651,
        },
        logo: {
          "@type": "ImageObject",
          "@id": "https://acplumb.co.uk/#/schema/logo/image/",
          url: logoImage,
          contentUrl: logoImage,
          width: 341,
          height: 341,
          caption: description,
        },
        image: { "@id": "https://acplumb.co.uk/#/schema/logo/image/" },
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "08:00",
            closes: "18:00",
          },
        ],
        sameAs: [
          "https://www.checkatrade.com/trades/ACPlumbingAndHeatingServices",
          "https://www.instagram.com/ac_plumbing_heating_bathrooms/",
          "https://www.gassaferegister.co.uk/",
          "https://g.page/r/CfBbyTh1_7W1EAI/review",
        ],
        hasCredential: {
          "@type": "EducationalOccupationalCredential",
          name: "Gas Safe Register",
          credentialCategory: "certification",
          identifier: BUSINESS_CONFIG.gasSafeNumber,
          url: "https://www.gassaferegister.co.uk/",
        },
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: "4.9",
          reviewCount: "85",
        },
      },
      {
        "@type": "ImageObject",
        "@id": "https://acplumb.co.uk/#primaryimage",
        url: image,
        contentUrl: image,
        width: 1200,
        height: 630,
        inLanguage: "en-GB",
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://acplumb.co.uk/#breadcrumb",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: url,
          },
        ],
      },
      {
        "@type": "WebSite",
        "@id": "https://acplumb.co.uk/#website",
        url,
        name: "AC Plumbers Heating & Bathrooms",
        description: "AC Plumbers, Heating & Bathrooms – Brighton",
        publisher: { "@id": "https://acplumb.co.uk/#organization" },
        potentialAction: [
          {
            "@type": "SearchAction",
            target: {
              "@type": "EntryPoint",
              urlTemplate: "https://acplumb.co.uk/?s={search_term_string}",
            },
          },
        ],
        inLanguage: "en-GB",
      },
    ],
  }}
/>
