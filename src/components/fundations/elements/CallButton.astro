---
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';
import { Phone, PhoneCall } from 'lucide-vue-next';
import Link from './Link.astro';
import Text from './Text.astro';

export interface Props {
  /**
   * Visual style variant of the button
   * @default 'primary'
   */
  variant?:
    | 'primary'
    | 'secondary'
    | 'accent'
    | 'outline'
    | 'ghost'
    | 'gradient';

  /**
   * Size of the button
   * @default 'md'
   */
  size?: 'sm' | 'md' | 'lg' | 'xl';

  /**
   * Display mode for the phone number
   * @default 'full'
   */
  display?: 'full' | 'short' | 'icon-only' | 'with-label';

  /**
   * Icon style to use
   * @default 'call'
   */
  iconStyle?: 'call' | 'phone';

  /**
   * Animation style for the button.
   * - 'pulse'  — fades opacity in/out (existing)
   * - 'bounce' — bobs up and down
   * - 'ring'   — rippling glow ring around the button
   * @default undefined (no animation)
   */
  animation?: 'pulse' | 'bounce' | 'ring';

  /**
   * Show additional label text
   * @default undefined
   */
  label?: string;

  /**
   * Additional CSS classes
   */
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  display = 'full',
  iconStyle = 'call',
  animation,
  label,
  class: className = '',
} = Astro.props;

// Icon selection
const IconComponent = iconStyle === 'call' ? PhoneCall : Phone;

// Variant styles
const variantStyles = {
  primary:
    'bg-primary-600 text-white hover:bg-primary-700 shadow-lg shadow-primary-600/30 hover:shadow-primary-700/40 ring-2 ring-primary-300/50',
  secondary:
    'bg-white text-primary-600 hover:bg-gray-50 shadow-lg border-2 border-primary-600 hover:border-primary-700',
  accent:
    'bg-accent-500 text-gray-900 hover:bg-accent-600 shadow-lg shadow-accent-500/40 hover:shadow-accent-600/50 ring-2 ring-accent-300/50',
  outline:
    'bg-transparent text-primary-600 border-2 border-primary-600 hover:bg-primary-50 hover:border-primary-700',
  ghost:
    'bg-primary-50 text-primary-700 hover:bg-primary-100 hover:text-primary-800',
  gradient:
    'bg-linear-to-r from-primary-600 to-primary-800 text-white hover:from-primary-700 hover:to-primary-900 shadow-lg shadow-primary-600/40',
};

// Size styles
const sizeStyles = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
  xl: 'px-10 py-5 text-xl',
};

const iconSizes = {
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-6 w-6',
  xl: 'h-7 w-7',
};

// Base styles
const baseStyles =
  'inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-all duration-300 hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-primary-300/50';

// Animation class
const animationClass =
  animation === 'pulse' ? 'cb-pulse' :
  animation === 'bounce' ? 'cb-bounce' :
  animation === 'ring' ? 'cb-ring' : '';

// Combined classes
const buttonClasses = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${animationClass} ${className}`;

// Phone number display logic
const getPhoneDisplay = () => {
  const fullPhone = formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone);

  switch (display) {
    case 'short':
      // Show last 6 digits or similar short format
      return fullPhone.replace(/^.*(\d{4}\s?\d{3}\s?\d{3})$/, '...$1');
    case 'icon-only':
      return null;
    case 'with-label':
      return fullPhone;
    case 'full':
    default:
      return fullPhone;
  }
};

const phoneDisplay = getPhoneDisplay();
const showLabel = display === 'with-label' && label;
---

<Link
  href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
  variant='custom'
  class={buttonClasses}
  data-umami-event='lead_call_click'
  data-umami-event-placement='inline_cta'
  aria-label={`Call ${BUSINESS_CONFIG.name} at ${formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}`}>
  <IconComponent
    class={`${iconSizes[size]} ${display === 'icon-only' ? '' : ''}`}
    aria-hidden='true'
    slot='left-icon'
  />

  {
    showLabel && (
      <Text tag='span' variant='textXS' class='opacity-80'>
        {label}
      </Text>
    )
  }
  {
    phoneDisplay && (
      <Text
        tag='span'
        variant={
          size === 'sm' ? 'textSM' : size === 'xl' ? 'textLG' : 'textBase'
        }
        class='font-semibold'>
        {phoneDisplay}
      </Text>
    )
  }
</Link>

<style>
  /* pulse — fades opacity in/out */
  @keyframes cb-pulse-kf {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .cb-pulse {
    animation: cb-pulse-kf 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  /* bounce — bobs up and down */
  @keyframes cb-bounce-kf {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  .cb-bounce {
    animation: cb-bounce-kf 1.2s ease-in-out infinite;
  }

  /* ring — rippling glow ring */
  @keyframes cb-ring-kf {
    0% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--color-primary-400, #21b6df) 60%, transparent); }
    70% { box-shadow: 0 0 0 10px color-mix(in oklch, var(--color-primary-400, #21b6df) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--color-primary-400, #21b6df) 0%, transparent); }
  }
  .cb-ring {
    animation: cb-ring-kf 1.8s ease-out infinite;
  }
</style>
