---
interface Props {
  text: string;
  /**
   * Icon size applied to slotted icons via a wrapper
   * @default 'sm'
   */
  iconSize?: 'xs' | 'sm' | 'md' | 'lg';
  /**
   * Show the dot separator between text and right icons
   * @default true
   */
  dot?: boolean;
  class?: string;
}

const {
  text,
  iconSize = 'sm',
  dot = true,
  class: className = '',
} = Astro.props;

const iconSizeClass = {
  xs: 'h-3 w-3',
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-6 w-6',
  xl: 'h-8 w-8',
  xxl: 'h-10 w-10',
}[iconSize];

const hasLeftIcon = Astro.slots.has('left-icon');
const hasRightIcon =
  Astro.slots.has('right-icon') || Astro.slots.has('default');
---

<div
  class={`inline-flex items-center rounded-full border border-accent-00 bg-accent-600/20 px-4 py-2 text-base font-bold text-accent-400 ${className}`}>
  {
    hasLeftIcon && (
      <span class={`mr-2 ${iconSizeClass} text-accent-600`}>
        <slot name='left-icon' />
      </span>
    )
  }

  {text}

  {
    dot && hasRightIcon && (
      <div
        class='ml-2 h-1 w-1 shrink-0 rounded-full bg-accent-600'
        aria-hidden='true'
      />
    )
  }

  {
    hasRightIcon && (
      <span
        class={`ml-2 inline-flex items-center gap-1 ${iconSizeClass} text-accent-600`}>
        <slot name='right-icon' />
        <slot />
      </span>
    )
  }
</div>
