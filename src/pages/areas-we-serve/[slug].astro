---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import {
  MapPin,
  Phone,
  CheckCircle,
  Star,
  ArrowRight,
  Shield,
  Wrench,
  Thermometer,
  Flame,
  Users,
  Award,
  Home,
} from '@lucide/astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';

// Import background images
import brightonBg from '@/images/lavori/viessmann-boiler-closeup-brighton-installation.jpeg';
import hoveBg from '@/images/lavori/radiator-valve-installation-brass-fitting-hove.jpeg';
import lewesBg from '@/images/lavori/vaillant-air-source-heat-pump-brighton-installation.jpeg';
import portsladeBg from '@/images/lavori/compact-cast-iron-radiator-bee-valve-saltdean.jpeg';

const backgroundImages: Record<string, ImageMetadata> = {
  brighton: brightonBg,
  hove: hoveBg,
  lewes: lewesBg,
  portslade: portsladeBg,
};

const serviceLabels: Record<string, string> = {
  'gas-boiler-installation': 'Gas Boiler Installation',
  'central-heating-installation': 'Central Heating Installation',
  'gas-safety-checks-cp12': 'Gas Safety Checks (CP12)',
  'renewable-air-source-heat-pump': 'Heat Pumps & Renewable Energy',
  'boiler-servicing-and-repair': 'Boiler Servicing & Repair',
  'all-aspects-of-plumbing-heating-and-gas': 'All Plumbing & Heating Services',
};

export async function getStaticPaths() {
  const areaEntries = await getCollection('areas');

  return areaEntries.map(area => ({
    params: { slug: area.id.replace('.md', '') },
  }));
}

const { slug } = Astro.params;
const areaEntries = await getCollection('areas');
const areaEntry = areaEntries.find(
  entry => entry.id.replace('.md', '') === slug,
);

if (!areaEntry) {
  throw new Error(`Area ${slug} not found`);
}

const areaData = areaEntry.data;
const areaName = areaData.area || areaEntry.id.replace(/-/g, ' ');
const heroTitle =
  areaData.title || `Plumbing & Heating Services in ${areaName}`;
const heroDescription =
  areaData.description ||
  `Professional plumbing, heating, and gas services in ${areaName}.`;
const neighborhoods = areaData.neighborhoods ?? [];
const postcodes = areaData.postcode
  ? areaData.postcode.split(',').map((code: string) => code.trim())
  : [];
const localInfo =
  areaData.specificContent ||
  `Trusted local engineers providing plumbing, heating, and gas services across ${areaName}.`;
const featuredServices =
  areaData.services?.map((service: string) => ({
    slug: service,
    label: serviceLabels[service] || service.replace(/-/g, ' '),
  })) ?? [];
const backgroundImage =
  backgroundImages[areaEntry.id.replace('.md', '')] ??
  backgroundImages['brighton'];
const defaultHighlights = [
  {
    slug: 'gas-boiler-installation',
    label: serviceLabels['gas-boiler-installation'],
  },
  {
    slug: 'central-heating-installation',
    label: serviceLabels['central-heating-installation'],
  },
  {
    slug: 'boiler-servicing-and-repair',
    label: serviceLabels['boiler-servicing-and-repair'],
  },
];

const area = {
  name: areaName,
  title: heroTitle,
  description: heroDescription,
  localInfo,
  neighborhoods: neighborhoods.length
    ? neighborhoods
    : [`${areaName} and surrounding communities`],
  postcodes: postcodes.length ? postcodes.join(', ') : 'All BN postcodes',
  responseTime: areaData.responseTime || '30 minutes',
  services: featuredServices.length ? featuredServices : defaultHighlights,
  backgroundImage,
};

const services = [
  {
    icon: Thermometer,
    name: 'Boiler Installation & Repair',
    desc: 'New boiler installations and expert repairs',
  },
  {
    icon: Wrench,
    name: 'Emergency Repairs',
    desc: 'Fast response for urgent plumbing issues',
  },
  {
    icon: Flame,
    name: 'Central Heating',
    desc: 'Full heating system installation & maintenance',
  },
  {
    icon: Shield,
    name: 'Gas Safety Checks',
    desc: 'CP12 certificates and gas appliance safety',
  },
  {
    icon: Home,
    name: 'Bathroom Fitting',
    desc: 'Complete bathroom installations and renovations',
  },
  {
    icon: Wrench,
    name: 'General Plumbing',
    desc: 'Leak repairs, tap replacements, pipe work',
  },
];

const whyChooseUs = [
  {
    icon: MapPin,
    title: 'Local to ' + area.name,
    desc: 'Based locally with fast response times',
  },
  {
    icon: Shield,
    title: 'Fully Insured',
    desc: 'Comprehensive insurance and Gas Safe registered',
  },
  {
    icon: Award,
    title: 'Quality Guaranteed',
    desc: 'All work comes with our quality guarantee',
  },
  {
    icon: Users,
    title: 'Trusted Engineers',
    desc: 'Experienced, friendly, professional team',
  },
];
---

<BaseLayout title={area.title} description={area.description}>
  <!-- Hero Section -->
  <section
    class='relative mt-24 overflow-hidden pt-16 pb-16 md:mt-28 md:pt-20 md:pb-20'>
    <!-- Background Image -->
    <div class='absolute inset-0 z-0'>
      <Image
        src={area.backgroundImage}
        alt={`Plumbing and heating work in ${area.name}`}
        class='h-full w-full object-cover'
        quality={70}
        width={1600}
        height={800}
        format='webp'
        loading='eager'
        decoding='async'
      />
      <!-- Overlay -->
      <div
        class='absolute inset-0 bg-linear-to-r from-primary-900/85 via-primary-800/75 to-primary-700/70'>
      </div>
    </div>

    <!-- Content -->
    <div class='relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='grid items-center gap-12 lg:grid-cols-2'>
        <div>
          <div class='mb-4 flex items-center gap-2'>
            <MapPin class='h-5 w-5 text-primary-100' aria-hidden='true' />
            <Text
              tag='span'
              variant='textBase'
              class='font-medium text-primary-100'>
              Serving {area.name}
            </Text>
          </div>

          <Text tag='h1' variant='display2XL' class='font-bold text-white'>
            Plumbing & Heating in {area.name}
          </Text>

          <Text tag='p' variant='textXL' class='mt-6 text-primary-100'>
            {area.localInfo}
          </Text>

          <div class='mt-8 flex flex-col gap-4 sm:flex-row'>
            <Link
              href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
              variant='default-button'
              size='md'
              class='bg-white text-primary-600 hover:bg-gray-100'
              aria-label={`Call ${BUSINESS_CONFIG.name} at ${formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}`}>
              <Phone class='h-5 w-5' aria-hidden='true' slot='left-icon' />
              <Text tag='span' variant='textBase' class='font-semibold'>
                Call {formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}
              </Text>
            </Link>
            <Link
              href='/contact-us'
              variant='default-button'
              size='md'
              class='border-2 border-white bg-transparent text-white hover:bg-white hover:text-primary-600'>
              <Text tag='span' variant='textBase' class='font-semibold'>
                Get a Quote
              </Text>
              <ArrowRight
                class='h-4 w-4'
                aria-hidden='true'
                slot='right-icon'
              />
            </Link>
          </div>

          <div
            class='mt-6 flex flex-wrap items-center gap-4 text-sm text-primary-200'>
            <div class='flex items-center gap-2'>
              <CheckCircle
                class='h-4 w-4 text-primary-100'
                aria-hidden='true'
              />
              <Text tag='span' variant='textSM' class='text-primary-200'>
                Local {area.name} engineers
              </Text>
            </div>
            <div class='flex items-center gap-2'>
              <CheckCircle
                class='h-4 w-4 text-primary-100'
                aria-hidden='true'
              />
              <Text tag='span' variant='textSM' class='text-primary-200'>
                Average response time: {area.responseTime}
              </Text>
            </div>
          </div>
        </div>

        <div class='relative'>
          <div class='relative'>
            <div
              class='rounded-2xl border border-white/20 bg-white/95 p-6 shadow-xl backdrop-blur-sm'>
              <Text
                tag='h3'
                variant='textLG'
                class='mb-4 font-semibold text-gray-900'>
                Areas We Cover in {area.name}
              </Text>
              <div class='grid grid-cols-2 gap-3'>
                {
                  area.neighborhoods.map((neighborhood: string) => (
                    <div class='flex items-center gap-2 text-sm text-gray-700'>
                      <span
                        class='h-1.5 w-1.5 rounded-full bg-primary-600'
                        aria-hidden='true'
                      />
                      <Text tag='span' variant='textSM' class='text-gray-700'>
                        {neighborhood}
                      </Text>
                    </div>
                  ))
                }
              </div>
              <div class='mt-4 border-t border-gray-200 pt-4'>
                <Text tag='p' variant='textSM' class='text-gray-600'>
                  <Text tag='strong' variant='textSM' class='font-semibold'>
                    Postcodes:
                  </Text>
                  {' '}{area.postcodes}
                </Text>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class='bg-white py-16'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='mb-12 text-center'>
        <Text tag='h2' variant='displayXL' class='font-bold text-gray-900'>
          Our Services in {area.name}
        </Text>
        <Text tag='p' variant='textLG' class='mt-4 text-gray-600'>
          Comprehensive plumbing and heating services for {area.name} residents
        </Text>
      </div>

      <div class='grid gap-6 md:grid-cols-2 lg:grid-cols-3'>
        {
          services.map(service => {
            const Icon = service.icon;
            return (
              <div class='rounded-lg border border-gray-200 bg-gray-50 p-6 transition-colors hover:border-primary-300 hover:bg-primary-50'>
                <div class='mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary-100'>
                  <Icon class='h-6 w-6 text-primary-600' aria-hidden='true' />
                </div>
                <Text
                  tag='h3'
                  variant='textLG'
                  class='mb-2 font-semibold text-gray-900'>
                  {service.name}
                </Text>
                <Text tag='p' variant='textBase' class='text-gray-600'>
                  {service.desc}
                </Text>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Local Specialties -->
  <section class='bg-gray-50 py-16'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='mb-12 text-center'>
        <Text tag='h2' variant='displayXL' class='font-bold text-gray-900'>
          Featured Services in {area.name}
        </Text>
        <Text tag='p' variant='textLG' class='mt-4 text-gray-600'>
          Popular plumbing and heating services chosen by {area.name} customers
        </Text>
      </div>

      <div class='grid gap-6 md:grid-cols-2 lg:grid-cols-4'>
        {
          area.services.map((service: { slug: string; label: string }) => (
            <Link
              href={`/services/${service.slug}`}
              variant='default-link'
              class='block rounded-lg bg-white p-6 text-center shadow-sm transition hover:shadow-md'>
              <Star
                class='mx-auto mb-3 h-8 w-8 text-primary-600'
                aria-hidden='true'
              />
              <Text
                tag='h3'
                variant='textBase'
                class='font-semibold text-gray-900'>
                {service.label}
              </Text>
            </Link>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class='bg-white py-16'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='mb-12 text-center'>
        <Text tag='h2' variant='displayXL' class='font-bold text-gray-900'>
          Why Choose Us in {area.name}?
        </Text>
        <Text tag='p' variant='textLG' class='mt-4 text-gray-600'>
          Local expertise and professional service you can trust
        </Text>
      </div>

      <div class='grid gap-8 md:grid-cols-2 lg:grid-cols-4'>
        {
          whyChooseUs.map(point => {
            const Icon = point.icon;
            return (
              <div class='text-center'>
                <div class='mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-100'>
                  <Icon class='h-8 w-8 text-primary-600' aria-hidden='true' />
                </div>
                <Text
                  tag='h3'
                  variant='textLG'
                  class='mb-2 font-semibold text-gray-900'>
                  {point.title}
                </Text>
                <Text tag='p' variant='textBase' class='text-gray-600'>
                  {point.desc}
                </Text>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class='bg-primary-600 py-16'>
    <div class='mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8'>
      <Text tag='h2' variant='displayXL' class='font-bold text-white'>
        Need a Plumber in {area.name}?
      </Text>
      <Text tag='p' variant='textXL' class='mt-4 text-primary-100'>
        Get in touch today for a free quote on your plumbing or heating needs.
      </Text>
      <div class='mt-8 flex flex-col justify-center gap-4 sm:flex-row'>
        <Link
          href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
          variant='default-button'
          size='md'
          class='bg-white text-primary-600 hover:bg-gray-100'
          aria-label={`Call ${BUSINESS_CONFIG.name} at ${formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}`}>
          <Phone class='h-5 w-5' aria-hidden='true' slot='left-icon' />
          <Text tag='span' variant='textBase' class='font-semibold'>
            Call Now: {formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}
          </Text>
        </Link>
        <Link
          href='/contact-us'
          variant='default-button'
          size='md'
          class='border-2 border-white bg-transparent text-white hover:bg-white hover:text-primary-600'>
          <Text tag='span' variant='textBase' class='font-semibold'>
            Request Quote
          </Text>
          <ArrowRight class='h-4 w-4' aria-hidden='true' slot='right-icon' />
        </Link>
      </div>

      <div class='mt-8 text-center'>
        <Text tag='p' variant='textBase' class='text-primary-100'>
          Serving all areas of {area.name} • Fast response times • Free quotes
        </Text>
      </div>
    </div>
  </section>
</BaseLayout>
