---
// Layout
import BaseLayout from '../../layouts/BaseLayout.astro';
// Components
import HeroAreas from '@/components/areas/HeroAreas.astro';
import WhyChooseUs from '@/components/areas/WhyChooseUs.astro';
import ServicesGrid from '@/components/areas/ServicesGrid.astro';
import CoveragesAreasList from '@/components/areas/CoveragesAreasList.astro';
import ExtendedCoverageList from '@/components/areas/ExtendedCoverageList.astro';
import ServiceAreaFaq from '@/components/areas/ServiceAreaFaq.astro';
import AreasCta from '@/components/areas/AreasCta.astro';
// Utils
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
---

<BaseLayout
  title={`Areas We Serve | ${BUSINESS_CONFIG.name}`}
  description='Plumbing and heating services across Brighton, Hove and nearby areas. Local engineers, transparent pricing, reliable service.'>
  <HeroAreas />
  <WhyChooseUs />
  <CoveragesAreasList />
  <ServicesGrid />
  <ExtendedCoverageList />
  <ServiceAreaFaq />
  <AreasCta />
</BaseLayout>
