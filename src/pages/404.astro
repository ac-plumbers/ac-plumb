---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import MainCta from '@/components/global/MainCta.astro';
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';

const title = '404 Page Not Found | AC Plumbers Ltd. Brighton';
const description =
  'Sorry, the page you are looking for cannot be found. Explore our plumbing and heating services or contact AC Plumbers Ltd. in Brighton for assistance.';
const keywords =
  '404, page not found, AC Plumbers Ltd, Brighton, plumbing services';
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  noindex={true}>
  <!-- Split-screen layout: dark content left, image right (desktop) -->
  <div class='flex min-h-[calc(100vh-5rem)] w-full'>
    <!-- Left panel -->
    <div
      class='flex w-full flex-col justify-center bg-gray-900 px-6 py-24 sm:py-32 lg:max-w-[max(50%,36rem)] lg:px-16'>
      <div class='max-w-lg'>
        <Text tag='p' variant='textBase' class='font-semibold text-accent-400'>
          404
        </Text>
        <Text
          tag='h1'
          variant='display4XL'
          class='mt-4 font-lato font-semibold tracking-tight text-pretty text-white sm:text-6xl'>
          Page not found
        </Text>
        <Text
          tag='p'
          variant='textLG'
          class='mt-6 font-poppins text-pretty text-gray-400 sm:text-xl/8'>
          Sorry, we couldn't find the page you're looking for.<br />
          Need urgent plumbing help? Call us at{' '}
          <a
            href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
            class='font-semibold text-accent-400 underline-offset-2 hover:text-accent-300 hover:underline'
            aria-label={`Call ${formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}`}>
            {formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}
          </a>
        </Text>

        <div class='mt-10 flex flex-wrap items-center gap-4'>
          <Link
            href='/services'
            variant='default-button'
            size='md'
            class='bg-white text-primary-700 hover:bg-primary-50'>
            View Our Services
          </Link>
          <Link href='/contact-us' variant='accent-button' size='md'>
            Contact Us
          </Link>
        </div>

        <div class='mt-8'>
          <Link
            href='/'
            variant='default-link'
            class='text-sm/7 font-semibold text-gray-400 hover:text-accent-400'
            aria-label='Go back to homepage'>
            <span aria-hidden='true'>&larr;</span> Back to home
          </Link>
        </div>

        <!-- Quick-links -->
        <div class='mt-10 flex flex-wrap gap-3'>
          <Link
            href='/services/gas-boiler-installation'
            variant='default-button'
            size='sm'
            class='border border-white/10 bg-white/5 text-gray-300 hover:bg-white/10'>
            Boiler Installation
          </Link>
          <Link
            href='/services/boiler-servicing-and-repair'
            variant='default-button'
            size='sm'
            class='border border-white/10 bg-white/5 text-gray-300 hover:bg-white/10'>
            Boiler Servicing
          </Link>
          <Link
            href='/services/gas-safety-checks-cp12'
            variant='default-button'
            size='sm'
            class='border border-white/10 bg-white/5 text-gray-300 hover:bg-white/10'>
            Gas Safety Checks
          </Link>
        </div>
      </div>
    </div>

    <!-- Right panel: image (desktop only) -->
    <div class='relative hidden flex-1 lg:block'>
      <img
        src='/images/services/antonio-catalano-gas-boiler-servicing-safety-checks-brighton-hove.jpeg'
        alt=''
        role='presentation'
        class='absolute inset-0 h-full w-full object-cover'
      />
    </div>
  </div>

  <MainCta />
</BaseLayout>
