---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';
/* TODO:: finish the 404 page */
// Content for SEO
const title = '404 Page Not Found | AC Plumbers Ltd. Brighton';
const description =
  'Sorry, the page you are looking for cannot be found. Explore our plumbing and heating services or contact AC Plumbers Ltd. in Brighton for assistance.';
const keywords =
  '404, page not found, AC Plumbers Ltd, Brighton, plumbing services';
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  noindex={true}>
  <main class='relative isolate min-h-full' id='main-content'>
    <img
      src='https://images.unsplash.com/photo-1545972154-9bb223aac798?ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&ixlib=rb-1.2.1&auto=format&fit=crop&w=3050&q=80&exp=8&con=-15&sat=-75'
      alt=''
      class='absolute inset-0 -z-10 size-full object-cover object-top'
      role='presentation'
    />
    <!-- Dark overlay for better text contrast -->
    <div
      class='absolute inset-0 -z-10 bg-linear-to-br from-primary-900/85 via-primary-800/80 to-primary-900/85'>
    </div>
    <div class='mx-auto max-w-7xl px-6 py-32 text-center sm:py-40 lg:px-8'>
      <Text tag='p' variant='textBase' class='font-semibold text-accent-400'>
        404
      </Text>
      <Text
        tag='h1'
        variant='display4XL'
        class='mt-4 font-lato font-semibold tracking-tight text-balance text-white sm:text-7xl'>
        Page not found
      </Text>
      <Text
        tag='p'
        variant='textLG'
        class='mx-auto mt-6 max-w-2xl font-poppins font-medium text-pretty text-white sm:text-xl'>
        Sorry, we couldn't find the page you're looking for.<br />
        Need urgent plumbing help? Call us now at <a
          href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
          class='font-semibold text-accent-400 underline decoration-2 underline-offset-2 transition-colors hover:text-accent-300 focus:outline-2 focus:outline-offset-4 focus:outline-accent-400'
          aria-label={`Call ${formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}`}>
          {formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}
        </a> or explore our services below.
      </Text>
      <div
        class='mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row'>
        <Link
          href='/services'
          variant='default-button'
          size='md'
          class='bg-white text-primary-700 hover:bg-primary-50'>
          <Text tag='span' variant='textBase' class='font-semibold'>
            View Our Services
          </Text>
        </Link>
        <Link
          href='/contact-us'
          variant='accent-button'
          size='md'
          aria-label='Contact AC Plumbers Ltd.'>
          <Text tag='span' variant='textBase' class='font-semibold'>
            Contact Us
          </Text>
        </Link>
      </div>
      <div class='mt-10 flex justify-center'>
        <Link
          href='/'
          variant='default-link'
          class='text-sm font-semibold text-white hover:text-accent-400 hover:underline'
          aria-label='Go back to homepage'>
          <span aria-hidden='true'>&larr;</span> Back to home
        </Link>
      </div>
      <!-- Quick links to popular services -->
      <div class='mt-12 flex flex-wrap justify-center gap-3'>
        <Link
          href='/services/gas-boiler-installation'
          variant='default-button'
          size='sm'
          class='bg-primary-700/90 text-white hover:bg-primary-800'
          aria-label='View Gas Boiler Installation service'>
          <Text tag='span' variant='textSM' class='font-medium'>
            Boiler Installation
          </Text>
        </Link>
        <Link
          href='/services/boiler-servicing-and-repair'
          variant='default-button'
          size='sm'
          class='bg-primary-700/90 text-white hover:bg-primary-800'
          aria-label='View Boiler Servicing service'>
          <Text tag='span' variant='textSM' class='font-medium'>
            Boiler Servicing
          </Text>
        </Link>
        <Link
          href='/services/gas-safety-checks-cp12'
          variant='default-button'
          size='sm'
          class='bg-primary-700/90 text-white hover:bg-primary-800'
          aria-label='View Gas Safety Checks service'>
          <Text tag='span' variant='textSM' class='font-medium'>
            Gas Safety Checks
          </Text>
        </Link>
      </div>
    </div>
  </main>
</BaseLayout>
