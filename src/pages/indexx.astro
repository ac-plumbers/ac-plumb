---
import Hero from '@components/home/Hero.astro';
import HeroNew from '@/components/home/HeroNew.astro';
import WhoWeAre from '@/components/home/WhoWeAre.astro';
import LogoCloud from '@/components/LogoCloud.astro';
import Services from '@components/home/Services.astro';
import Faq from '@/components/home/Faq.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import Contact from '@/components/Contact.astro';
import HomeLayout from '../layouts/HomeLayout.astro';
import ContactSupportCTA from '@/components/ContactSupportCTA.astro';
import ServiceReviewCta from '@/components/home/ServiceReviewCta.astro';
---

<HomeLayout>
  <!-- <HeroNew /> -->
  <Hero />
  <WhoWeAre />
  <LogoCloud />
  <Services />
  <ContactSupportCTA
    heading='Ready to get a quote?'
    message="Tell us about your job and we'll get back quickly with next steps."
    buttonText='Get a Quote'
    buttonHref='/contact-us'
    sectionClass='bg-accent-50 py-8'
    containerClass='bg-white/80 border border-neutral-200'
  />
  <ServiceReviewCta />
  <Faq />
  <Testimonials />
  <Contact />
</HomeLayout>
