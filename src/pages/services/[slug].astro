---
// @ts-nocheck
import ServicesLayout from '@/layouts/ServicesLayout.astro';
import ServiceHeroSection from '@/components/services/ServiceHeroSection.astro';
import ServiceFeaturesList from '@/components/services/ServiceFeaturesList.astro';
import ServiceProcessSteps from '@/components/services/ServiceProcessSteps.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import ServiceFaqList from '@/components/services/ServiceFaqList.astro';
import ServiceCallToAction from '@/components/services/ServiceCallToAction.astro';
import RelatedServicesList from '@/components/services/RelatedServicesList.astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import MainCta from '@/components/global/MainCta.astro';
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
import type {
  ServiceFeature,
  ServiceStep,
  ServiceFaq,
  ServiceFrontmatter,
} from '@/lib/types';
import { getCollection, render } from 'astro:content';
import SingleSchemaService from '@/components/fundations/schema-services/SingleSchemaService.astro';
import { Image } from 'astro:assets';
import vaillant from '@/images/brands/vaillant-installer-logo-brighton-boilers.jpg';
import viesmann from '@/images/brands/viessmann-logo-boiler-installation-brighton.jpg';
import bpec from '@/images/brands/bpec-certification-logo-gas-plumbing.png';
import checktrade from '@/images/brands/checkatrade-logo-ac-plumbers-brighton.png';
import gasSafe from '@/images/brands/gas-safe-register-logo-certified-brighton.png';
import oftec from '@/images/brands/oftec-registered-logo-heating-certification-1.png';
import ServiceGallery from '@/components/services/ServiceGallery.astro';
import ServiceBenefits from '@/components/services/ServiceBenefits.astro';
import Badge from '@/components/fundations/elements/Badge.astro';
import { BadgeCheck, ShieldCheck } from 'lucide-vue-next';
import CallButton from '@/components/fundations/elements/CallButton.astro';
import ServiceContentGallery from '@/components/services/ServiceContentGallery.astro';
import ServiceCertifications from '@/components/services/ServiceCertifications.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(page => ({
    params: { slug: page.id },
    props: { page, allServices: services },
  }));
}

const { page, allServices } = Astro.props as {
  page: {
    data: ServiceFrontmatter;
    id: string;
  };
  allServices: Array<{
    data: ServiceFrontmatter;
    id: string;
  }>;
};
const service = page.data;
const { Content } = await render(page);

const relatedServices = allServices
  .filter(s => s.id !== page.id)
  .filter(s => {
    if (!page.data.tags || !s.data.tags) return false;
    return page.data.tags.some(tag => (s.data.tags ?? []).includes(tag));
  })
  .slice(0, 3);

const intro = service.intro || '';
const description = service.description || '';
const paragraph = service.paragraph || '';
const benefits = service.benefits || [];
const specialties = service.specialties || [];
const steps = service.process || [];
const faqs = service.faqs || [];
const features: ServiceFeature[] = service.features || [];
const process: ServiceStep[] = service.process || [];
---

<ServicesLayout frontmatter={service}>
  <SingleSchemaService
    service={page}
    providerName='AC Plumbers Ltd.'
    providerUrl='https://acplumb.co.uk'
  />

  <ServiceHeroSection
    title={service.title}
    image={service.imageHero}
    alt={service.altHero}
    intro={intro}
    badge={service.badge}
    slug={page.id}
  />
  <!-- Main Service Content & Benefits -->
  <Wrapper
    id='main-content'
    variant='compact'
    class='mx-auto mt-6 py-8 sm:mt-10 sm:py-14 lg:mt-12 lg:py-16'
    aria-label='Service details'>
    <div class='grid items-start gap-8 lg:grid-cols-2 lg:gap-12'>
      <section aria-labelledby='about-service-heading'>
        <article>
          <header>
            <!-- <Badge
              text='badge temporaneo soprattutto i colori'
              iconSize='sm'
              class='my-4 px-3 py-1 text-xs sm:px-4 sm:py-1.5 sm:text-sm'>
              <BadgeCheck slot='left-icon' aria-hidden='true' />
            </Badge> -->
            <Text
              tag='h2'
              variant='displayMD'
              id='about-service-heading'
              class='mb-4 font-bold text-primary-900'>
              {service.title}
            </Text>
          </header>

          <div
            class='prose max-w-none prose-neutral prose-headings:text-primary-900 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline'>
            <section aria-labelledby='service-description-heading'>
              <!-- content -->
              <Content />
            </section>
          </div>
          <CallButton
            class='mt-8'
            display='with-label'
            label='Call'
            animation='ring'
          />
        </article>
      </section>

      <!-- Sidebar -->
      <aside
        class='rounded-2xl border border-slate-200 bg-white p-8 shadow-xl lg:sticky lg:top-40 lg:max-h-[calc(100vh-10rem)] lg:overflow-y-auto'
        aria-label='Service benefits and emergency contact information'
        data-bg='dark'>
        <ServiceBenefits benefits={benefits} />
        <div class='mt-8 border-t border-primary-400 pt-8'>
          <div class='flex items-center gap-4'>
            <div
              class='flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-primary-400/20'>
              <ShieldCheck
                class='h-8 w-8 text-primary-600'
                aria-hidden='true'
              />
            </div>
            <div class='flex-1'>
              <Text
                tag='h3'
                variant='textBase'
                class='font-semibold text-primary-900'>
                Need Help Today?
              </Text>
              <Text tag='p' variant='textSM' class='mt-1 text-neutral-600'>
                Call us — we're available across Brighton, Hove & surrounding
                areas.
              </Text>
            </div>
          </div>
          <CallButton class='mt-4 w-full' display='full' animation='ring' />
        </div>
      </aside>
    </div>
  </Wrapper>

  <!-- Key Features -->
  <section aria-labelledby='features-heading'>
    <ServiceFeaturesList features={features} />
  </section>

  <!-- Service-Specific FAQs -->
  <section aria-labelledby='faqs-heading'>
    <ServiceFaqList questions={faqs} />
  </section>

  <!-- Service Image Gallery -->
  <ServiceContentGallery images={service.gallery} />

  <!-- Certifications -->
  <ServiceCertifications />
  <!-- Service-Specific Testimonials -->
  <section aria-labelledby='testimonials-heading'>
    <Testimonials />
  </section>

  <!-- Related Services -->
  <!--   <nav aria-label='Related services'>
    <RelatedServicesList services={relatedServices} />
  </nav> -->

  <!-- Call to Action -->
  <section aria-labelledby='cta-heading'>
    <!--   <ServiceCallToAction
      title={`Ready to get started with ${page.data.title}?`}
      buttonText='Book a Service'
      buttonLink='/contact-us'
    /> -->
    <MainCta
      image={page.data.imageHero || page.data.image}
      imageAlt={page.data.altHero || page.data.alt || page.data.title}
    />
  </section>
</ServicesLayout>
