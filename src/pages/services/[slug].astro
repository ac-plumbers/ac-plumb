---
// @ts-nocheck
import ServicesLayout from '@/layouts/ServicesLayout.astro';
import ServiceHeroSection from '@/components/services/ServiceHeroSection.astro';
import ServiceFeaturesList from '@/components/services/ServiceFeaturesList.astro';
import ServiceProcessSteps from '@/components/services/ServiceProcessSteps.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import ServiceFaqList from '@/components/services/ServiceFaqList.astro';
import ServiceCallToAction from '@/components/services/ServiceCallToAction.astro';
import RelatedServicesList from '@/components/services/RelatedServicesList.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
import type {
  ServiceFeature,
  ServiceStep,
  ServiceFrontmatter,
} from '@/lib/types';
import { getCollection } from 'astro:content';
import SingleSchemaService from '@/components/fundations/schema-services/SingleSchemaService.astro';
import ServiceGallery from '@/components/services/ServiceGallery.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(page => ({
    params: { slug: page.slug },
    props: { page, allServices: services },
  }));
}

const { page, allServices } = Astro.props as {
  page: {
    data: ServiceFrontmatter;
    slug: string;
    render: () => Promise<{ Content: any }>;
  };
  allServices: Array<{
    data: ServiceFrontmatter;
    slug: string;
  }>;
};

const service = page.data;
const { Content } = await page.render();

const relatedServices = allServices
  .filter(s => s.slug !== page.slug)
  .filter(s => {
    if (!page.data.tags || !s.data.tags) return false;
    return page.data.tags.some(tag => (s.data.tags ?? []).includes(tag));
  })
  .slice(0, 3);

const intro = service.intro || '';
const description = service.description || '';

const benefits = service.benefits || [];
const steps: ServiceStep[] = service.process || [];
const faqs = service.faqs || [];
const features: ServiceFeature[] = service.features || [];
const gallery = service.gallery || [];
---

<ServicesLayout frontmatter={service}>
  <SingleSchemaService
    service={page}
    providerName='AC Plumbers Ltd.'
    providerUrl='https://acplumb.co.uk'
  />

  <ServiceHeroSection
    title={service.title}
    image={service.imageHero ?? ''}
    alt={service.altHero}
    intro={intro}
  />

  <section
    id='main-content'
    class='max-w-8xl mx-auto mt-12 bg-background-50 px-4 py-16 sm:px-6 sm:py-20 lg:px-8'
    aria-label='Service details'>
    <div class='grid grid-cols-1 gap-8 lg:grid-cols-3'>
      <section class='lg:col-span-2' aria-labelledby='about-service-heading'>
        <article class='rounded-xl bg-background-100 p-8 shadow-lg'>
          <header>
            <Text
              tag='h2'
              variant='displayMD'
              id='about-service-heading'
              class='mb-4 font-bold text-primary-900'>
              About {service.title}
            </Text>
          </header>

          <!-- ✅ Prefer Markdown body (stylable). Fallback to frontmatter.description if body is empty. -->
          <div
            class='prose prose-lg max-w-none text-neutral-700 prose-headings:font-lato prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-primary-900 prose-h2:mt-10 prose-h2:border-b prose-h2:border-neutral-200 prose-h2:pb-2 prose-h3:mt-8 prose-h3:text-primary-800 prose-p:leading-8 prose-p:text-neutral-700 prose-a:font-semibold prose-a:text-primary-700 prose-a:underline prose-a:decoration-primary-300 prose-a:underline-offset-4 hover:prose-a:text-primary-900 prose-strong:font-semibold prose-strong:text-neutral-900 prose-ul:space-y-2 prose-ol:space-y-2 prose-li:marker:text-primary-600 prose-blockquote:border-l-4 prose-blockquote:border-primary-300 prose-blockquote:bg-primary-50 prose-blockquote:px-4 prose-blockquote:py-2 prose-blockquote:text-neutral-700 prose-blockquote:not-italic prose-img:rounded-xl prose-img:shadow-md prose-hr:border-neutral-200'>
            <Content />
          </div>

          {
            description && (
              <Text
                tag='p'
                variant='textBase'
                class='mt-6 text-lg leading-relaxed text-neutral-700'>
                {description}
              </Text>
            )
          }

          <div class='mt-8 grid grid-cols-1 gap-6 md:grid-cols-2'>
            {
              benefits.length > 0 && (
                <section
                  aria-labelledby='why-choose-us-heading'
                  class='rounded-lg bg-primary-50 p-6'>
                  <Text
                    tag='h3'
                    variant='displayMD'
                    id='why-choose-us-heading'
                    class='mb-3 font-semibold text-primary-900'>
                    Service Benefits
                  </Text>
                  <ul class='space-y-2'>
                    {benefits.map((benefit: string) => (
                      <li class='flex items-start gap-2 text-neutral-700'>
                        <span class='pt-1.5 sm:pt-0'>
                          <svg
                            class='h-5 w-5 shrink-0 text-accent-500'
                            fill='currentColor'
                            viewBox='0 0 20 20'
                            aria-hidden='true'
                            focusable='false'>
                            <path
                              fill-rule='evenodd'
                              d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z'
                              clip-rule='evenodd'
                            />
                          </svg>
                        </span>
                        <span class='wrap-break-word'>{benefit}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              )
            }

            <section
              aria-labelledby='our-specialties-heading'
              class='rounded-lg bg-accent-50 p-6'>
              <div class='h-64 overflow-hidden rounded-lg shadow-sm'>
                <img
                  src={service.image ?? ''}
                  alt={service.alt ?? `${service.title} service`}
                  class='block h-full w-full object-cover'
                  loading='lazy'
                  title={service.titleImage ?? service.title}
                />
              </div>
            </section>
          </div>
        </article>
      </section>

      <aside
        class='lg:col-span-1'
        aria-label='Quick contact and service info'
        data-bg='dark'>
        <div class='sticky top-8 rounded-xl bg-primary-900 p-6 text-white'>
          <Text tag='h3' variant='displayMD' class='mb-4 font-semibold'>
            Quick Contact
          </Text>
          <Text tag='p' variant='textBASE' class='mb-4 text-primary-200'>
            Need immediate assistance?
          </Text>
          <Link href='/contact-us' variant='accent-button' size='lg'>
            <span class='text-2xl uppercase sm:text-base'>Get a Quote</span>
          </Link>

          <div class='mt-4 border-t border-primary-700 pt-4'>
            <Text
              tag='h4'
              variant='displayBASE'
              class='mb-2 font-lato font-semibold'>
              Service Hours
            </Text>
            <Text
              tag='p'
              variant='textBase'
              class='mb-2 text-sm text-primary-200'>
              Monday - Friday: 7AM - 6PM
            </Text>
            <Text tag='p' class='mb-2 text-sm text-primary-200'>
              Saturday: 8AM - 4PM
            </Text>
            <Text tag='p' variant='textBASE' class='text-sm text-primary-200'>
              Sunday: Emergency only
            </Text>
          </div>

          <div class='mt-4 border-t border-primary-700 pt-4'>
            <Text
              tag='h4'
              variant='displayBase'
              class='mb-2 font-lato font-semibold'>
              Emergency Service
            </Text>
            <Text
              tag='p'
              variant='textBASE'
              class='mb-2 text-sm text-primary-200'>
              24/7 availability
            </Text>
            <a
              href='tel:00447535653850'
              class='font-semibold text-accent-400 hover:text-accent-300'
              aria-label='Call emergency plumbing service'>
              {BUSINESS_CONFIG.mobilePhone}
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {
    gallery.length > 0 && (
      <ServiceGallery
        images={gallery}
        title={page.data.title}
        paragraph={service.paragraph || ''}
      />
    )
  }

  {
    features.length > 0 && (
      <section aria-labelledby='features-heading'>
        <ServiceFeaturesList features={features} />
      </section>
    )
  }

  <!-- {
    steps.length > 0 && (
      <section aria-labelledby='process-heading'>
        <ServiceProcessSteps steps={steps} />
      </section>
    )
  } -->

  <section aria-labelledby='testimonials-heading'>
    <Testimonials />
  </section>

  {
    faqs.length > 0 && (
      <section aria-labelledby='faqs-heading'>
        <ServiceFaqList questions={faqs} />
      </section>
    )
  }

  <nav aria-label='Related services'>
    <RelatedServicesList services={relatedServices} />
  </nav>

  <section aria-labelledby='cta-heading'>
    <ServiceCallToAction
      title={`Ready to get started with ${page.data.title}?`}
      buttonText='Book a Service'
      buttonLink='/contact-us'
    />
  </section>
</ServicesLayout>
