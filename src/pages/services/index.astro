---
// Layout
import BaseLayout from '@/layouts/BaseLayout.astro';
// Components
import ServicesHero from '@/components/services/ServicesHero.astro';
import ServicesGrid from '@/components/services/ServicesGrid.astro';
import MainCta from '@/components/global/MainCta.astro';
import SchemaServices from '@/components/fundations/schema-services/SchemaServices.astro';
// Data
import { getCollection } from 'astro:content';
import { BUSINESS_CONFIG } from '@/utils/businessConfig';

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

// SEO
const title =
  'Professional Plumbing & Heating Services in Brighton — AC Plumbers Ltd.';
const description =
  'Gas Safe registered plumbers and heating engineers serving Brighton & Hove. Boiler installation, servicing, central heating, gas safety checks, and more. Free quotes available.';
const ogImage = `${BUSINESS_CONFIG.website}/og/service-og-1200x630.png`;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <SchemaServices
    services={services}
    providerName='AC Plumbers Ltd.'
    providerUrl='https://acplumb.co.uk'
  />

  <!-- Skip to main content link for accessibility -->
  <a
    href='#main-content'
    class='sr-only z-50 rounded-md bg-primary-600 px-4 py-2 text-background-00 focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:ring-2 focus:ring-primary-600 focus:ring-offset-2'>
    Skip to main content
  </a>

  <main id='main-content' class='isolate'>
    <!-- Hero -->
    <ServicesHero />

    <!-- Services grid -->
    <section id='services' class='bg-background-00 py-24 lg:py-32'>
      <div class='mx-auto max-w-7xl px-6 lg:px-8'>
        <!-- Section header -->
        <p
          class='font-lato text-xs font-bold tracking-[0.35em] text-accent-600 uppercase'>
          What We Do
        </p>
        <h2
          class='mt-3 font-poppins text-4xl font-black tracking-tight text-primary-900 sm:text-5xl'>
          Our Services
        </h2>
        <p class='mt-4 max-w-2xl font-lato text-base leading-7 text-text-00'>
          From emergency callouts to planned installations &mdash; we cover
          every aspect of plumbing, heating, and gas for homes and businesses
          across Brighton &amp; Hove.
        </p>
        <!-- Divider -->
        <div class='mt-10 mb-12 h-px bg-neutral-200' aria-hidden='true'></div>
        <!-- Grid -->
        <ServicesGrid services={services} />
      </div>
    </section>

    <!-- CTA -->
    <MainCta
      body='From boiler issues to urgent plumbing repairs, our certified engineers deliver fast, reliable service with clear communication and transparent pricing.'
      secondaryLinkHref='/contact-us'
      secondaryLinkLabel='Get in Touch'
    />
  </main>
</BaseLayout>
