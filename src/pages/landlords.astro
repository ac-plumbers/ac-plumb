---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';
import Button from '@/components/fundations/elements/Button.astro';
import MainCta from '@/components/global/MainCta.astro';
import GetAQuote from '@/components/fundations/elements/GetAQuote.astro';
import CallButton from '@/components/fundations/elements/CallButton.astro';
import {
  ClipboardCheck,
  House,
  Shield,
  Clock,
  Calendar,
  BadgeCheck,
  Receipt,
  HeartHandshake,
} from '@lucide/astro';

import { getCollection } from 'astro:content';

const allTheServices = await getCollection('services');
const serviceIcons: Record<string, typeof ClipboardCheck> = {
  'gas-safety-checks-cp12': ClipboardCheck,
  'boiler-servicing-and-repair': House,
  'gas-boiler-installation': Shield,
  'central-heating-installation': Calendar,
  'all-aspects-of-plumbing-heating-and-gas': BadgeCheck,
  'renewable-air-source-heat-pump': HeartHandshake,
};
---

<BaseLayout
  title='Landlord Services in Brighton | AC Plumbers Ltd.'
  description='Specialist plumbing and heating services for landlords in Brighton & Hove. Gas safety certificates, boiler servicing, emergency repairs, and more.'
  keywords='landlord services, gas safety certificate, boiler servicing, emergency repairs, Brighton, AC Plumbers Ltd.'>
  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section
    class='relative isolate overflow-hidden'
    aria-labelledby='landlord-hero-heading'
    data-bg='dark'>
    <div
      class='bg-linear-to-br from-primary-900 via-primary-800 to-secondary-800'>
      <!-- Decorative SVG grid pattern -->
      <svg
        aria-hidden='true'
        class='absolute inset-x-0 top-0 -z-10 h-256 w-full mask-[radial-gradient(32rem_32rem_at_center,white,transparent)] stroke-primary-200/15'>
        <defs>
          <pattern
            id='landlord-hero-pattern'
            width='200'
            height='200'
            x='50%'
            y='-1'
            patternUnits='userSpaceOnUse'>
            <path d='M.5 200V.5H200' fill='none'></path>
          </pattern>
        </defs>
        <svg x='50%' y='-1' class='overflow-visible fill-primary-900'>
          <path
            d='M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z'
            stroke-width='0'></path>
        </svg>
        <rect
          width='100%'
          height='100%'
          fill='url(#landlord-hero-pattern)'
          stroke-width='0'></rect>
      </svg>

      <!-- Decorative blur blob -->
      <div
        aria-hidden='true'
        class='absolute top-0 right-0 left-1/2 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48'>
        <div
          style='clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)'
          class='aspect-801/1036 w-200.25 bg-linear-to-tr from-accent-500/40 to-secondary-400/40 opacity-80'>
        </div>
      </div>

      <Wrapper
        variant='standard'
        class='pt-36 pb-20 sm:pt-52 lg:pt-32 lg:pb-28'>
        <div class='mx-auto max-w-2xl text-center'>
          <Text
            tag='p'
            variant='textSM'
            class='inline-flex rounded-full bg-accent-500 px-4 py-1.5 font-semibold tracking-wide whitespace-nowrap text-primary-900 uppercase'>
            For Landlords
          </Text>
          <Text
            tag='h1'
            id='landlord-hero-heading'
            variant='display2XL'
            class='mt-5 font-bold text-white'>
            Specialist Landlord Services in Brighton &amp; Hove
          </Text>
          <Text tag='p' variant='textLG' class='mt-6 text-primary-100'>
            Landlord-ready plumbing, heating, and gas services — from annual
            CP12 certificates to boiler servicing, central heating upgrades, and
            responsive repairs across your rental portfolio.
          </Text>
          <div class='mt-10 flex flex-col justify-center gap-4 sm:flex-row'>
            <CallButton variant='accent' size='lg' animation='ring' />
            <GetAQuote variant='gradient' size='lg' iconStyle='send' />
          </div>
        </div>
      </Wrapper>
    </div>
  </section>

  <!-- ─── Key Services for Landlords ──────────────────────────────────── -->
  <section
    class='bg-white py-16 sm:py-24'
    aria-labelledby='landlord-services-heading'>
    <Wrapper variant='standard'>
      <div class='mb-16 text-center'>
        <Text
          tag='p'
          variant='textSM'
          class='font-semibold tracking-wider text-primary-600 uppercase'>
          Our Services
        </Text>
        <Text
          tag='h2'
          id='landlord-services-heading'
          variant='displayXL'
          class='mt-3 font-bold text-text-00'>
          Complete Landlord Services
        </Text>
        <Text
          tag='p'
          variant='textLG'
          class='mx-auto mt-4 max-w-3xl text-neutral-600'>
          Everything you need to ensure your rental properties are safe, legal,
          and well-maintained.
        </Text>
      </div>

      <div class='grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3'>
        {
          allTheServices.map(service => (
            <div class='rounded-xl border border-neutral-200 bg-white p-6 shadow-md transition-shadow hover:shadow-lg'>
              <div class='flex items-start'>
                <div class='rounded-lg bg-accent-50 p-3'>
                  {(() => {
                    const Icon = serviceIcons[service.id] ?? ClipboardCheck;
                    return (
                      <Icon
                        class='h-6 w-6 text-primary-600'
                        aria-hidden='true'
                        focusable='false'
                      />
                    );
                  })()}
                </div>
                <div class='ml-4 flex flex-col'>
                  <Text
                    tag='h3'
                    variant='textXL'
                    class='mb-2 font-bold text-primary-800'>
                    {service.data.title}
                  </Text>
                  <Text
                    tag='p'
                    variant='textBase'
                    class='line-clamp-4 text-neutral-600'>
                    {service.data.intro}
                  </Text>
                  <div class='mt-auto pt-4'>
                    <a
                      href={`/services/${service.id}`}
                      class='inline-flex items-center text-sm font-medium text-primary-600 hover:text-primary-800 focus:outline-2 focus:outline-offset-2 focus:outline-primary-600'
                      aria-label={`Learn more about ${service.data.title}`}>
                      Learn more about {service.data.title}
                      <span aria-hidden='true'>&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>

  <!-- ─── Why Choose Us ────────────────────────────────────────────────── -->
  <section
    class='bg-neutral-50 py-16 sm:py-24'
    aria-labelledby='landlord-why-heading'>
    <Wrapper variant='standard'>
      <div class='mb-16 text-center'>
        <Text
          tag='p'
          variant='textSM'
          class='font-semibold tracking-wider text-primary-600 uppercase'>
          Why choose us
        </Text>
        <Text
          tag='h2'
          id='landlord-why-heading'
          variant='displayXL'
          class='mt-3 font-bold text-primary-900'>
          Why Landlords Choose AC Plumbers Ltd.
        </Text>
        <Text
          tag='p'
          variant='textLG'
          class='mx-auto mt-4 max-w-3xl text-neutral-600'>
          We understand the unique challenges landlords face and provide
          reliable solutions to help you maintain compliant, safe rental
          properties.
        </Text>
      </div>

      <div class='grid grid-cols-1 gap-8 md:grid-cols-2'>
        <!-- Fast Service -->
        <div
          class='rounded-xl border border-neutral-200 bg-white p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div
              class='flex h-10 w-10 items-center justify-center rounded-full bg-primary-100'>
              <Clock
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <Text tag='h3' variant='textLG' class='font-bold text-primary-800'>
              Fast Response Times
            </Text>
          </div>
          <Text tag='p' variant='textBase' class='text-neutral-600'>
            We aim for fast callouts to reduce downtime and keep tenants
            comfortable.
          </Text>
        </div>

        <!-- Compliance Expertise -->
        <div
          class='rounded-xl border border-neutral-200 bg-white p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div
              class='flex h-10 w-10 items-center justify-center rounded-full bg-primary-100'>
              <ClipboardCheck
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <Text tag='h3' variant='textLG' class='font-bold text-primary-800'>
              Compliance Expertise
            </Text>
          </div>
          <Text tag='p' variant='textBase' class='text-neutral-600'>
            Gas Safe registered engineers deliver compliant inspections and
            documentation for rental properties.
          </Text>
        </div>

        <!-- Quality Workmanship -->
        <div
          class='rounded-xl border border-neutral-200 bg-white p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div
              class='flex h-10 w-10 items-center justify-center rounded-full bg-primary-100'>
              <BadgeCheck
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <Text tag='h3' variant='textLG' class='font-bold text-primary-800'>
              Quality Workmanship
            </Text>
          </div>
          <Text tag='p' variant='textBase' class='text-neutral-600'>
            Certified engineers deliver careful installations, servicing, and
            repairs across plumbing and heating.
          </Text>
        </div>

        <!-- Competitive Pricing -->
        <div
          class='rounded-xl border border-neutral-200 bg-white p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div
              class='flex h-10 w-10 items-center justify-center rounded-full bg-primary-100'>
              <Receipt
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <Text tag='h3' variant='textLG' class='font-bold text-primary-800'>
              Competitive Pricing
            </Text>
          </div>
          <Text tag='p' variant='textBase' class='text-neutral-600'>
            Clear pricing and practical recommendations to keep costs
            predictable.
          </Text>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- ─── Quote Form ───────────────────────────────────────────────────── -->
  <section
    class='bg-white py-16 sm:py-24'
    aria-labelledby='landlord-form-heading'>
    <Wrapper variant='standard'>
      <div class='grid grid-cols-1 gap-16 lg:grid-cols-2'>
        <!-- Left: benefits -->
        <div>
          <Text
            tag='h2'
            id='landlord-form-heading'
            variant='displayLG'
            class='font-bold text-text-00'>
            Why Landlords Trust AC Plumbers Ltd.
          </Text>
          <Text tag='p' variant='textLG' class='mt-4 text-neutral-600'>
            Dedicated landlord services, fast turnaround, and compliant
            documentation — so you can focus on your portfolio.
          </Text>

          <ul class='mt-8 space-y-4' role='list'>
            <li class='flex items-start gap-3'>
              <svg
                class='mt-0.5 h-5 w-5 shrink-0 text-green-500'
                fill='currentColor'
                viewBox='0 0 20 20'
                aria-hidden='true'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              <Text tag='span' variant='textBase' class='text-text-00'>
                CP12 certificates issued on pass
              </Text>
            </li>
            <li class='flex items-start gap-3'>
              <svg
                class='mt-0.5 h-5 w-5 shrink-0 text-green-500'
                fill='currentColor'
                viewBox='0 0 20 20'
                aria-hidden='true'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              <Text tag='span' variant='textBase' class='text-text-00'>
                Annual boiler servicing options
              </Text>
            </li>
            <li class='flex items-start gap-3'>
              <svg
                class='mt-0.5 h-5 w-5 shrink-0 text-green-500'
                fill='currentColor'
                viewBox='0 0 20 20'
                aria-hidden='true'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              <Text tag='span' variant='textBase' class='text-text-00'>
                Heating upgrades and smart controls
              </Text>
            </li>
            <li class='flex items-start gap-3'>
              <svg
                class='mt-0.5 h-5 w-5 shrink-0 text-green-500'
                fill='currentColor'
                viewBox='0 0 20 20'
                aria-hidden='true'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              <Text tag='span' variant='textBase' class='text-text-00'>
                Plumbing repairs and installations
              </Text>
            </li>
            <li class='flex items-start gap-3'>
              <svg
                class='mt-0.5 h-5 w-5 shrink-0 text-green-500'
                fill='currentColor'
                viewBox='0 0 20 20'
                aria-hidden='true'>
                <path
                  fill-rule='evenodd'
                  d='M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z'
                  clip-rule='evenodd'></path>
              </svg>
              <Text tag='span' variant='textBase' class='text-text-00'>
                Air source heat pump options
              </Text>
            </li>
          </ul>

          <div class='mt-10'>
            <CallButton variant='outline' size='md' />
          </div>
        </div>

        <!-- Right: form card -->
        <div class='rounded-2xl bg-white p-8 shadow-lg ring-1 ring-neutral-200'>
          <Text tag='h2' variant='displayLG' class='font-bold text-text-00'>
            Get a Landlord Service Quote
          </Text>
          <Text tag='p' variant='textBase' class='mt-4 text-neutral-600'>
            Complete the form and we'll get back to you with a customised
            solution for your rental properties.
          </Text>

          <form
            name='AC Plumbers Landlord Services'
            class='mt-8 space-y-6'
            action='/success'
            method='POST'
            netlify-honeypot='bot-field'
            data-netlify='true'>
            <!-- Hidden bot field for spam protection -->
            <p hidden>
              <label>
                Don't fill this out if you're human: <input name='bot-field' />
              </label>
            </p>

            <input
              type='hidden'
              name='subject'
              value='New Landlord Enquiry from %{formName} - Submission #%{submissionId}'
              data-remove-prefix
            />

            <div class='grid grid-cols-1 gap-6 sm:grid-cols-2'>
              <div>
                <label
                  for='first-name'
                  class='block text-sm font-medium text-text-00'>
                  First name <span class='text-red-600' aria-label='required'
                    >*</span
                  >
                </label>
                <input
                  type='text'
                  id='first-name'
                  name='first-name'
                  autocomplete='given-name'
                  required
                  aria-required='true'
                  class='mt-2 block w-full rounded-lg border border-neutral-300 px-3 py-2 text-text-00 placeholder:text-neutral-500 focus:border-primary-600 focus:ring-1 focus:ring-primary-600 focus:outline-none'
                />
              </div>
              <div>
                <label
                  for='last-name'
                  class='block text-sm font-medium text-text-00'>
                  Last name <span class='text-red-600' aria-label='required'
                    >*</span
                  >
                </label>
                <input
                  type='text'
                  id='last-name'
                  name='last-name'
                  autocomplete='family-name'
                  required
                  aria-required='true'
                  class='mt-2 block w-full rounded-lg border border-neutral-300 px-3 py-2 text-text-00 placeholder:text-neutral-500 focus:border-primary-600 focus:ring-1 focus:ring-primary-600 focus:outline-none'
                />
              </div>
            </div>

            <div>
              <label for='email' class='block text-sm font-medium text-text-00'>
                Email address <span class='text-red-600' aria-label='required'
                  >*</span
                >
              </label>
              <input
                type='email'
                id='email'
                name='email'
                autocomplete='email'
                required
                aria-required='true'
                class='mt-2 block w-full rounded-lg border border-neutral-300 px-3 py-2 text-text-00 placeholder:text-neutral-500 focus:border-primary-600 focus:ring-1 focus:ring-primary-600 focus:outline-none'
              />
            </div>

            <div>
              <label for='phone' class='block text-sm font-medium text-text-00'>
                Phone number
              </label>
              <input
                type='tel'
                id='phone'
                name='phone'
                autocomplete='tel'
                inputmode='tel'
                class='mt-2 block w-full rounded-lg border border-neutral-300 px-3 py-2 text-text-00 placeholder:text-neutral-500 focus:border-primary-600 focus:ring-1 focus:ring-primary-600 focus:outline-none'
              />
            </div>

            <div>
              <label
                for='service-type'
                class='block text-sm font-medium text-text-00'>
                Service needed
              </label>
              <select
                name='service-type'
                id='service-type'
                class='mt-2 block w-full rounded-lg border border-neutral-300 px-3 py-2 text-text-00 focus:border-primary-600 focus:ring-1 focus:ring-primary-600 focus:outline-none'>
                <option value=''>Select a service</option>
                <option value='gas-safety'>Gas Safety Certificate (CP12)</option
                >
                <option value='boiler-service'>Boiler Servicing</option>
                <option value='boiler-installation'>Boiler Installation</option>
                <option value='heating'>Central Heating</option>
                <option value='plumbing'>Plumbing Services</option>
                <option value='heat-pump'>Air Source Heat Pump</option>
                <option value='multiple'>Multiple Properties</option>
                <option value='other'>Other</option>
              </select>
            </div>

            <div>
              <label
                for='message'
                class='block text-sm font-medium text-text-00'>
                Tell us about your properties <span
                  class='text-red-600'
                  aria-label='required'>*</span
                >
              </label>
              <textarea
                id='message'
                name='message'
                rows='4'
                required
                aria-required='true'
                placeholder='Number of properties, location, service needed, etc.'
                class='mt-2 block w-full rounded-lg border border-neutral-300 px-3 py-2 text-text-00 placeholder:text-neutral-500 focus:border-primary-600 focus:ring-1 focus:ring-primary-600 focus:outline-none'
              ></textarea>
            </div>

            <div>
              <Button type='submit' variant='primary' size='lg' class='w-full'>
                Get Your Free Quote
              </Button>
            </div>
          </form>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- ─── FAQ ──────────────────────────────────────────────────────────── -->
  <section
    class='bg-neutral-50 py-16 sm:py-24'
    aria-labelledby='landlord-faq-heading'>
    <Wrapper variant='standard'>
      <div class='mx-auto max-w-3xl'>
        <div class='mb-12 text-center'>
          <Text
            tag='h2'
            id='landlord-faq-heading'
            variant='displayXL'
            class='font-bold text-primary-900'>
            Frequently Asked Questions
          </Text>
          <Text tag='p' variant='textLG' class='mt-4 text-neutral-600'>
            Common questions from our landlord clients
          </Text>
        </div>

        <div class='space-y-6'>
          <div
            class='rounded-lg border border-neutral-200 bg-white p-6 shadow-sm'>
            <Text
              tag='h3'
              variant='textLG'
              class='font-semibold text-primary-800'>
              How often do I need to get a gas safety certificate?
            </Text>
            <Text tag='p' variant='textBase' class='mt-3 text-neutral-600'>
              CP12 gas safety certificates must be renewed annually for rental
              properties with gas appliances. Our Gas Safe engineers carry out
              the inspection and issue certification when everything passes.
            </Text>
          </div>

          <div
            class='rounded-lg border border-neutral-200 bg-white p-6 shadow-sm'>
            <Text
              tag='h3'
              variant='textLG'
              class='font-semibold text-primary-800'>
              How often should a boiler be serviced?
            </Text>
            <Text tag='p' variant='textBase' class='mt-3 text-neutral-600'>
              We recommend annual boiler servicing to keep systems safe,
              efficient, and compliant. Regular servicing helps reduce
              breakdowns and keeps heating reliable for tenants.
            </Text>
          </div>

          <div
            class='rounded-lg border border-neutral-200 bg-white p-6 shadow-sm'>
            <Text
              tag='h3'
              variant='textLG'
              class='font-semibold text-primary-800'>
              What does a central heating upgrade include?
            </Text>
            <Text tag='p' variant='textBase' class='mt-3 text-neutral-600'>
              We install and upgrade central heating systems, including power
              flushing, TRVs, and smart controls, so each property runs more
              efficiently and evenly.
            </Text>
          </div>

          <div
            class='rounded-lg border border-neutral-200 bg-white p-6 shadow-sm'>
            <Text
              tag='h3'
              variant='textLG'
              class='font-semibold text-primary-800'>
              Do you handle general plumbing repairs?
            </Text>
            <Text tag='p' variant='textBase' class='mt-3 text-neutral-600'>
              Yes. We cover leak repairs, tap and sanitary fixes, pipework
              updates, and hot water cylinder services for rental properties.
            </Text>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- ─── CTA ──────────────────────────────────────────────────────────── -->
  <MainCta
    body='Need gas safety certificates, boiler servicing, or heating upgrades for your rental properties? Our Gas Safe engineers work with landlords across Brighton & Hove.'
    secondaryLinkHref='/request-quote'
    secondaryLinkLabel='Request a Quote'
  />
</BaseLayout>
