---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Text from '@/components/fundations/elements/Text.astro';
import {
  ClipboardCheck,
  Home,
  Shield,
  Clock,
  Calendar,
  BadgeCheck,
  Receipt,
  HeartHandshake,
} from '@lucide/astro';
import GetACuote from '@/components/fundations/elements/GetACuote.astro';
import CallButton from '@/components/fundations/elements/CallButton.astro';
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';

const phoneDisplay = formatPhoneForDisplay(BUSINESS_CONFIG.landline);
const phoneTel = formatPhoneForTel(BUSINESS_CONFIG.landline);
---

<BaseLayout
  title='Landlord Services in Brighton | AC Plumbers Ltd.'
  description='Specialist plumbing and heating services for landlords in Brighton & Hove. Gas safety certificates, boiler servicing, emergency repairs, and more.'
  keywords='landlord services, gas safety certificate, boiler servicing, emergency repairs, Brighton, AC Plumbers Ltd.'>
  <section class='bg-linear-to-b from-primary-200 to-background-00 py-24'>
    <div class='mx-auto mt-24 max-w-7xl px-4 text-center md:px-8'>
      <Text tag='h1' class='mb-6 md:text-5xl'>
        Specialist Landlord Services in Brighton & Hove
      </Text>
      <p class='mx-auto mb-8 max-w-3xl text-lg text-text-00 md:text-xl'>
        Landlord-ready services built around our core plumbing, heating, and gas
        offerings. From annual CP12 gas safety checks to boiler servicing,
        central heating upgrades, and responsive repairs.
      </p>
      <div class='flex flex-col justify-center gap-4 sm:flex-row'>
        <GetACuote
          variant='gradient'
          size='lg'
          iconStyle='send'
          class='w-full sm:w-auto'
        />
        <CallButton variant='secondary' size='lg' class='w-full sm:w-auto' />
      </div>
    </div>
  </section>

  <!-- Key Services for Landlords -->
  <section class='bg-neutral-100 py-16'>
    <div class='mx-auto max-w-7xl px-4 md:px-8'>
      <div class='mb-16 text-center'>
        <Text tag='h2' class='mb-4 font-bold'>
          Complete Landlord Services
        </Text>
        <p class='mx-auto max-w-3xl text-lg text-text-00'>
          Everything you need to ensure your rental properties are safe, legal,
          and well-maintained.
        </p>
      </div>

      <div class='grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3'>
        <!-- Gas Safety Certificate -->
        <div
          class='rounded-xl border border-primary-300 bg-background-00 p-6 shadow-md transition-shadow hover:shadow-lg'>
          <div class='flex items-start'>
            <div class='rounded-lg bg-primary-100 p-3'>
              <ClipboardCheck
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <div class='ml-4'>
              <h3 class='mb-2 text-xl font-bold text-primary-800'>
                Gas Safety Certificates (CP12)
              </h3>
              <p class='text-text-00'>
                Annual Gas Safe inspections and CP12 certificates to keep your
                rental properties compliant and safe.
              </p>
              <a
                href='/services/gas-safety-checks-cp12'
                class='mt-4 inline-flex items-center text-primary-600 hover:text-primary-800'>
                Learn more <span aria-hidden='true'>&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Boiler Services -->
        <div
          class='rounded-xl border border-primary-300 bg-background-00 p-6 shadow-md transition-shadow hover:shadow-lg'>
          <div class='flex items-start'>
            <div class='rounded-lg bg-primary-100 p-3'>
              <Home
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <div class='ml-4'>
              <h3 class='mb-2 text-xl font-bold text-primary-800'>
                Boiler Servicing & Repairs
              </h3>
              <p class='text-text-00'>
                Annual servicing keeps boilers safe and efficient, with fast
                repairs when breakdowns happen.
              </p>
              <a
                href='/services/boiler-servicing-and-repair'
                class='mt-4 inline-flex items-center text-primary-600 hover:text-primary-800'>
                Learn more <span aria-hidden='true'>&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Boiler Installations -->
        <div
          class='rounded-xl border border-primary-300 bg-background-00 p-6 shadow-md transition-shadow hover:shadow-lg'>
          <div class='flex items-start'>
            <div class='rounded-lg bg-primary-100 p-3'>
              <Shield
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <div class='ml-4'>
              <h3 class='mb-2 text-xl font-bold text-primary-800'>
                Boiler Installations
              </h3>
              <p class='text-text-00'>
                Supply and fit efficient gas boilers, with clear guidance on the
                right system for each property.
              </p>
              <a
                href='/services/gas-boiler-installation'
                class='mt-4 inline-flex items-center text-primary-600 hover:text-primary-800'>
                Learn more <span aria-hidden='true'>&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Central Heating -->
        <div
          class='rounded-xl border border-primary-300 bg-background-00 p-6 shadow-md transition-shadow hover:shadow-lg'>
          <div class='flex items-start'>
            <div class='rounded-lg bg-primary-100 p-3'>
              <Calendar
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <div class='ml-4'>
              <h3 class='mb-2 text-xl font-bold text-primary-800'>
                Central Heating Installation
              </h3>
              <p class='text-text-00'>
                Complete heating installations, power flushing, and smart
                controls for efficient, reliable warmth.
              </p>
              <a
                href='/services/central-heating-installation'
                class='mt-4 inline-flex items-center text-primary-600 hover:text-primary-800'>
                Learn more <span aria-hidden='true'>&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Plumbing Services -->
        <div
          class='rounded-xl border border-primary-300 bg-background-00 p-6 shadow-md transition-shadow hover:shadow-lg'>
          <div class='flex items-start'>
            <div class='rounded-lg bg-primary-100 p-3'>
              <BadgeCheck
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <div class='ml-4'>
              <h3 class='mb-2 text-xl font-bold text-primary-800'>
                Plumbing Services
              </h3>
              <p class='text-text-00'>
                Leak repairs, tap and sanitary fixes, pipework, and hot water
                cylinder services for well-maintained rentals.
              </p>
              <a
                href='/services/all-aspects-of-plumbing-heating-and-gas'
                class='mt-4 inline-flex items-center text-primary-600 hover:text-primary-800'>
                Learn more <span aria-hidden='true'>&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Air Source Heat Pumps -->
        <div
          class='rounded-xl border border-primary-300 bg-background-00 p-6 shadow-md transition-shadow hover:shadow-lg'>
          <div class='flex items-start'>
            <div class='rounded-lg bg-primary-100 p-3'>
              <HeartHandshake
                class='h-6 w-6 text-primary-600'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <div class='ml-4'>
              <h3 class='mb-2 text-xl font-bold text-primary-800'>
                Air Source Heat Pumps
              </h3>
              <p class='text-text-00'>
                Low-carbon heating installation and maintenance with guidance on
                efficiency and long-term running costs.
              </p>
              <a
                href='/services/renewable-air-source-heat-pump'
                class='mt-4 inline-flex items-center text-primary-600 hover:text-primary-800'>
                Learn more <span aria-hidden='true'>&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class='bg-primary-200 py-16'>
    <div class='mx-auto max-w-7xl px-4 md:px-8'>
      <div class='mb-16 text-center'>
        <h2 class='mb-4 text-3xl font-bold text-primary-900'>
          Why Landlords Choose AC Plumbers Ltd.
        </h2>
        <p class='mx-auto max-w-3xl text-lg font-medium text-text-00'>
          We understand the unique challenges landlords face and provide
          reliable solutions to help you maintain compliant, safe rental
          properties.
        </p>
      </div>

      <div class='grid grid-cols-1 gap-8 md:grid-cols-2'>
        <!-- Fast Service -->
        <div
          class='rounded-xl border border-primary-400 bg-background-00 p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div class='rounded-full bg-accent-300 p-2'>
              <Clock
                class='h-6 w-6 text-text-00'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <h3 class='text-xl font-bold text-primary-800'>
              Fast Response Times
            </h3>
          </div>
          <p class='text-text-00'>
            We aim for fast callouts to reduce downtime and keep tenants
            comfortable.
          </p>
        </div>

        <!-- Compliance Expertise -->
        <div
          class='rounded-xl border border-primary-400 bg-background-00 p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div class='rounded-full bg-accent-300 p-2'>
              <ClipboardCheck
                class='h-6 w-6 text-text-00'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <h3 class='text-xl font-bold text-primary-800'>
              Compliance Expertise
            </h3>
          </div>
          <p class='text-text-00'>
            Gas Safe registered engineers deliver compliant inspections and
            documentation for rental properties.
          </p>
        </div>

        <!-- Quality Workmanship -->
        <div
          class='rounded-xl border border-primary-400 bg-background-00 p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div class='rounded-full bg-accent-300 p-2'>
              <BadgeCheck
                class='h-6 w-6 text-text-00'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <h3 class='text-xl font-bold text-primary-800'>
              Quality Workmanship
            </h3>
          </div>
          <p class='text-text-00'>
            Certified engineers deliver careful installations, servicing, and
            repairs across plumbing and heating.
          </p>
        </div>

        <!-- Competitive Pricing -->
        <div
          class='rounded-xl border border-primary-400 bg-background-00 p-6 shadow-sm'>
          <div class='mb-4 flex items-center gap-4'>
            <div class='rounded-full bg-accent-300 p-2'>
              <Receipt
                class='h-6 w-6 text-text-00'
                aria-hidden='true'
                focusable='false'
              />
            </div>
            <h3 class='text-xl font-bold text-primary-800'>
              Competitive Pricing
            </h3>
          </div>
          <p class='text-text-00'>
            Clear pricing and practical recommendations to keep costs
            predictable.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Us -->
  <section id='contact' class='bg-background-00 py-16'>
    <div class='mx-auto max-w-6xl px-4 md:px-8'>
      <div class='overflow-hidden rounded-2xl bg-primary-700 shadow-xl'>
        <div class='md:flex'>
          <!-- Left side: Contact Form -->
          <div class='p-8 md:w-3/5 md:p-12'>
            <h2 class='mb-6 text-2xl font-bold text-white md:text-3xl'>
              Get a Landlord Service Quote
            </h2>
            <p class='mb-8 text-primary-100'>
              Complete the form below and we'll get back to you with a
              customized solution for your rental properties.
            </p>

            <form class='space-y-6'>
              <div class='grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-6'>
                <div>
                  <label
                    for='first-name'
                    class='block text-sm font-medium text-white'
                    >First name</label
                  >
                  <input
                    type='text'
                    id='first-name'
                    name='firstName'
                    autocomplete='given-name'
                    class='mt-1 block w-full rounded-md border-border-50 shadow-sm focus:border-accent-400 focus:ring-accent-400'
                  />
                </div>
                <div>
                  <label
                    for='last-name'
                    class='block text-sm font-medium text-white'
                    >Last name</label
                  >
                  <input
                    type='text'
                    id='last-name'
                    name='lastName'
                    autocomplete='family-name'
                    class='mt-1 block w-full rounded-md border-border-50 shadow-sm focus:border-accent-400 focus:ring-accent-400'
                  />
                </div>
              </div>

              <div>
                <label for='email' class='block text-sm font-medium text-white'
                  >Email</label
                >
                <input
                  type='email'
                  id='email'
                  name='email'
                  autocomplete='email'
                  class='mt-1 block w-full rounded-md border-border-50 shadow-sm focus:border-accent-400 focus:ring-accent-400'
                />
              </div>

              <div>
                <label for='phone' class='block text-sm font-medium text-white'
                  >Phone</label
                >
                <input
                  type='tel'
                  id='phone'
                  name='phone'
                  autocomplete='tel'
                  inputmode='tel'
                  class='mt-1 block w-full rounded-md border-border-50 shadow-sm focus:border-accent-400 focus:ring-accent-400'
                />
              </div>

              <div>
                <label
                  for='message'
                  class='block text-sm font-medium text-white'
                  >Tell us about your properties</label
                >
                <textarea
                  id='message'
                  name='message'
                  rows='4'
                  autocomplete='off'
                  class='mt-1 block w-full rounded-md border-border-50 shadow-sm focus:border-accent-400 focus:ring-accent-400'
                ></textarea>
              </div>

              <div>
                <button
                  type='submit'
                  class='inline-flex justify-center rounded-md border border-transparent bg-accent-500 px-6 py-3 text-base font-medium text-text-00 shadow-sm hover:bg-accent-600 focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 focus:outline-none'>
                  Submit
                </button>
              </div>
            </form>
          </div>

          <!-- Right side: Benefits -->
          <div class='bg-primary-800 p-8 md:w-2/5 md:p-12'>
            <h3 class='mb-6 text-xl font-semibold text-white'>
              Landlord Benefits
            </h3>
            <ul class='space-y-4'>
              <li class='flex items-start'>
                <svg
                  class='mr-2 h-6 w-6 flex-shrink-0 text-accent-400'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  aria-hidden='true'
                  focusable='false'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M5 13l4 4L19 7'></path>
                </svg>
                <span class='text-white'>CP12 certificates issued on pass</span>
              </li>
              <li class='flex items-start'>
                <svg
                  class='mr-2 h-6 w-6 flex-shrink-0 text-accent-400'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  aria-hidden='true'
                  focusable='false'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M5 13l4 4L19 7'></path>
                </svg>
                <span class='text-white'>Annual boiler servicing options</span>
              </li>
              <li class='flex items-start'>
                <svg
                  class='mr-2 h-6 w-6 flex-shrink-0 text-accent-400'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  aria-hidden='true'
                  focusable='false'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M5 13l4 4L19 7'></path>
                </svg>
                <span class='text-white'
                  >Heating upgrades and smart controls</span
                >
              </li>
              <li class='flex items-start'>
                <svg
                  class='mr-2 h-6 w-6 flex-shrink-0 text-accent-400'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  aria-hidden='true'
                  focusable='false'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M5 13l4 4L19 7'></path>
                </svg>
                <span class='text-white'
                  >Plumbing repairs and installations</span
                >
              </li>
              <li class='flex items-start'>
                <svg
                  class='mr-2 h-6 w-6 flex-shrink-0 text-accent-400'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  aria-hidden='true'
                  focusable='false'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M5 13l4 4L19 7'></path>
                </svg>
                <span class='text-white'>Air source heat pump options</span>
              </li>
            </ul>

            <div class='mt-10'>
              <h4 class='mb-3 text-lg font-semibold text-white'>
                Need immediate assistance?
              </h4>
              <a
                href={`tel:${phoneTel}`}
                class='inline-block rounded-lg bg-white px-6 py-3 font-bold text-primary-700 transition duration-300 hover:bg-primary-50'>
                {phoneDisplay}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class='bg-neutral-200 py-16'>
    <div class='mx-auto max-w-3xl px-4 md:px-8'>
      <div class='mb-12 text-center'>
        <h2 class='mb-4 text-3xl font-bold text-primary-900'>
          Frequently Asked Questions
        </h2>
        <p class='text-lg font-medium text-text-00'>
          Common questions from our landlord clients
        </p>
      </div>

      <div class='space-y-6'>
        <div
          class='rounded-lg border border-primary-300 bg-background-00 p-6 shadow-sm'>
          <h3 class='mb-3 text-xl font-semibold text-primary-800'>
            How often do I need to get a gas safety certificate?
          </h3>
          <p class='text-text-00'>
            CP12 gas safety certificates must be renewed annually for rental
            properties with gas appliances. Our Gas Safe engineers carry out the
            inspection and issue certification when everything passes.
          </p>
        </div>

        <div
          class='rounded-lg border border-primary-300 bg-background-00 p-6 shadow-sm'>
          <h3 class='mb-3 text-xl font-semibold text-primary-800'>
            How often should a boiler be serviced?
          </h3>
          <p class='text-text-00'>
            We recommend annual boiler servicing to keep systems safe,
            efficient, and compliant. Regular servicing helps reduce breakdowns
            and keeps heating reliable for tenants.
          </p>
        </div>

        <div
          class='rounded-lg border border-primary-300 bg-background-00 p-6 shadow-sm'>
          <h3 class='mb-3 text-xl font-semibold text-primary-800'>
            What does a central heating upgrade include?
          </h3>
          <p class='text-text-00'>
            We install and upgrade central heating systems, including power
            flushing, TRVs, and smart controls, so each property runs more
            efficiently and evenly.
          </p>
        </div>

        <div
          class='rounded-lg border border-primary-300 bg-background-00 p-6 shadow-sm'>
          <h3 class='mb-3 text-xl font-semibold text-primary-800'>
            Do you handle general plumbing repairs?
          </h3>
          <p class='text-text-00'>
            Yes. We cover leak repairs, tap and sanitary fixes, pipework
            updates, and hot water cylinder services for rental properties.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
