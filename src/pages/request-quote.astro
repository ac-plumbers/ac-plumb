---
import BaseLayout from "@/layouts/BaseLayout.astro";
import QuoteHero from "@/components/quote/QuoteHero.astro";
import QuoteForm from "@/components/quote/QuoteForm.vue";
import NetlifyQuoteForm from "@/components/quote/NetlifyQuoteForm.astro";
import MainCta from "@/components/global/MainCta.astro";
// SEO Content
const canonicalURL = new URL("/request-quote", Astro.site).href;
const title = "Request a Quote | AC Plumbers Ltd. Brighton";
const description =
  "Request a quote for plumbing and heating services from AC Plumbers Ltd. in Brighton. Get expert advice and competitive pricing.";
const keywords =
  "request quote, plumbing quote, heating services quote, AC Plumbers, Brighton";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonicalURL}
>
  <QuoteHero>
    <QuoteForm client:only="vue" />
  </QuoteHero>
  <NetlifyQuoteForm />
  <MainCta
    body="Not sure which service you need? Call us or drop a message — our team will point you in the right direction."
    secondaryLinkHref="/services"
    secondaryLinkLabel="Browse All Services"
  />
</BaseLayout>
