---
// Layout
import BaseLayout from '@/layouts/BaseLayout.astro';

// Images
import heroBgImage from '@/images/about/viessman.jpeg';

// Components
import AboutHero from '@/components/about/AboutHero.astro';
import AboutFounderStory from '@/components/about/AboutFounderStory.astro';
import AboutValues from '@/components/about/AboutValues.astro';
import MainCta from '@/components/global/MainCta.astro';
import ServiceCertifications from '@/components/services/ServiceCertifications.astro';
import ServiceHeroSection from '@/components/services/ServiceHeroSection.astro';
// SEO
const title = "Brighton Plumber – About AC Plumbers Ltd.";
const description =
  'Gas Safe plumber Antonio Catalano founded AC Plumbers Ltd. Nearly 30 years of heating experience in Brighton & Hove. Honest advice, clear quotes. Call us today.';
const keywords =
  'about AC Plumbers Ltd., Antonio Catalano, Brighton plumber, heating engineer, Gas Safe registered, trusted plumber Brighton';
const author = 'AC Plumbers Ltd.';
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  author={author}>
  <!-- Skip to main content link for accessibility -->
  <a
    href='#main-content'
    class='sr-only z-50 rounded-md bg-primary-600 px-4 py-2 text-background-00 focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:ring-2 focus:ring-primary-600 focus:ring-offset-2'>
    Skip to main content
  </a>

  <main id='main-content' class='isolate'>
    <ServiceHeroSection
      title="About AC Plumbers Ltd. — Brighton's Trusted Gas Safe Engineers"
      image={heroBgImage}
      alt='Antonio Catalano, founder of AC Plumbers Ltd., standing in front of a van with the company logo, wearing a branded uniform and smiling confidently.'
      intro=' Honest advice, clear communication, and high standards on every job
          — whether it’s a small repair or a complete system
          installation.'
      breadcrumbItems={[{ label: 'Home', href: '/' }, { label: 'About Us' }]}
    />
    <!--  <AboutHero /> -->
    <AboutFounderStory />
    <!-- Certifications -->
    <ServiceCertifications />
    <AboutValues />
    <MainCta />
  </main>
</BaseLayout>
