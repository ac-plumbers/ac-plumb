---
// Layout
import BaseLayout from '@/layouts/BaseLayout.astro';
// Components
import AboutHero from '@/components/about/AboutHero.astro';
import AboutFounderStory from '@/components/about/AboutFounderStory.astro';
import AboutValues from '@/components/about/AboutValues.astro';
import MainCta from '@/components/global/MainCta.astro';
// SEO
const title =
  "About AC Plumbers Ltd. | Meet Antonio Catalano, Brighton's Trusted Plumber";
const description =
  'Meet Antonio Catalano — founder of AC Plumbers Ltd. with nearly 30 years of plumbing and heating experience in Italy and the UK. Honest advice, clear communication, and high standards on every job in Brighton & Hove.';
const keywords =
  'about AC Plumbers Ltd., Antonio Catalano, Brighton plumber, heating engineer, Gas Safe registered, trusted plumber Brighton';
const author = 'AC Plumbers Ltd.';
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  author={author}>
  <!-- Skip to main content link for accessibility -->
  <a
    href='#main-content'
    class='sr-only z-50 rounded-md bg-primary-600 px-4 py-2 text-background-00 focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:ring-2 focus:ring-primary-600 focus:ring-offset-2'>
    Skip to main content
  </a>

  <main id='main-content' class='isolate'>
    <AboutHero />
    <AboutFounderStory />
    <AboutValues />
    <MainCta />
  </main>
</BaseLayout>
