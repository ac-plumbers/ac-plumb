---
// Layout
import BaseLayout from '@/layouts/BaseLayout.astro';
// Components
import AboutHero from '@/components/about/AboutHero.astro';
import MainCta from '@/components/global/MainCta.astro';
// Content for SEO
const title =
  "About AC Plumbers Ltd. | Brighton's Trusted Plumbing & Heating Experts";
const description =
  "Learn about AC Plumbers Ltd., Brighton's leading plumbing and heating company. Discover our history, values, and commitment to quality service.";
const keywords =
  'about AC Plumbers Ltd., Brighton plumbers, heating experts, plumbing company, trusted service';
const author = 'AC Plumbers Ltd.';
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  author={author}>
  <!-- Skip to main content link for accessibility -->
  <a
    href='#main-content'
    class='sr-only z-50 rounded-md bg-primary-600 px-4 py-2 text-background-00 focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:ring-2 focus:ring-primary-600 focus:ring-offset-2'>
    Skip to main content
  </a>

  <div class='bg-background-00'>
    <main id='main-content' class='isolate'>
      <!-- Hero section -->
      <AboutHero />
      <!-- Call to action -->
      <MainCta />
    </main>
  </div>
</BaseLayout>
