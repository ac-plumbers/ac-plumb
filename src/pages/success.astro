---
import BaseLayout from '../layouts/BaseLayout.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';

// Content for SEO
const title = 'Thank You | AC Plumbers Ltd. Brighton';
const description =
  'Thank you for contacting AC Plumbers Ltd. Our team will get back to you shortly regarding your plumbing, heating, or gas service enquiry in Brighton & Hove.';
const keywords = 'contact success, thank you, AC Plumbers Ltd, Brighton';
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  noindex={true}>
  <main
    id='main-content'
    class='flex min-h-screen flex-col items-center justify-center bg-linear-to-b from-green-50 to-green-100 px-6 py-32 sm:py-40 lg:px-8'>
    <div class='mx-auto max-w-lg text-center'>
      <!-- Animated checkmark -->
      <div
        class='mb-8 flex justify-center'
        role='img'
        aria-label='Success checkmark'>
        <svg
          class='h-24 w-24 animate-bounce text-green-600 drop-shadow-lg'
          viewBox='0 0 72 72'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
          aria-hidden='true'>
          <circle
            cx='36'
            cy='36'
            r='34'
            stroke='currentColor'
            stroke-width='4'
            fill='#fff'></circle>
          <path
            d='M22 38.5L32.5 49L50 27'
            stroke='#16a34a'
            stroke-width='5'
            stroke-linecap='round'
            stroke-linejoin='round'></path>
        </svg>
      </div>
      <Text
        tag='h1'
        variant='display2XL'
        class='mb-4 font-lato font-extrabold text-green-700 sm:text-5xl'>
        Message Sent Successfully!
      </Text>
      <Text tag='p' variant='textLG' class='mb-4 font-medium text-green-800'>
        Thanks for reaching out to {BUSINESS_CONFIG.name}! Our friendly team
        will get back to you soon.
      </Text>
      <Text tag='p' variant='textBase' class='mb-8 text-green-700'>
        While you wait, why not <Link
          href='/services'
          variant='default-link'
          class='font-semibold text-green-800 hover:text-green-900'
          >explore our services</Link
        > or <Link
          href='/testimonials'
          variant='default-link'
          class='font-semibold text-green-800 hover:text-green-900'
          >read customer reviews</Link
        >?
      </Text>
      <div class='mb-8 flex flex-col justify-center gap-4 sm:flex-row'>
        <Link
          href='/services'
          variant='default-button'
          size='md'
          aria-label='View our plumbing and heating services'>
          <svg
            class='h-5 w-5'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            viewBox='0 0 24 24'
            aria-hidden='true'
            slot='left-icon'>
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M9 5l7 7-7 7'></path>
          </svg>
          <Text tag='span' variant='textBase' class='font-semibold'>
            See Our Services
          </Text>
        </Link>
        <Link
          href='/testimonials'
          variant='accent-button'
          size='md'
          aria-label='Read customer testimonials'>
          <svg
            class='h-5 w-5'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            viewBox='0 0 24 24'
            aria-hidden='true'
            slot='left-icon'>
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2'
            ></path><circle cx='12' cy='12' r='3'></circle>
          </svg>
          <Text tag='span' variant='textBase' class='font-semibold'>
            Read Testimonials
          </Text>
        </Link>
      </div>

      <!-- Contact Information -->
      <div
        class='mb-6 rounded-lg border-2 border-green-300 bg-white p-6 shadow-sm'>
        <Text
          tag='p'
          variant='textSM'
          class='mb-2 font-semibold text-green-800'>
          Need urgent assistance?
        </Text>
        <Text tag='p' variant='textBase' class='text-green-700'>
          Call us at <a
            href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
            class='font-semibold text-green-800 underline decoration-2 underline-offset-2 transition-colors hover:text-green-900 focus:outline-2 focus:outline-offset-4 focus:outline-green-600'
            aria-label={`Call ${formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}`}>
            {formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}
          </a>
        </Text>
      </div>

      <Link
        href='/'
        variant='default-link'
        class='mt-4 inline-flex items-center gap-2 text-base font-semibold text-green-700 hover:text-green-900'
        aria-label='Return to homepage'>
        <svg
          class='h-5 w-5'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          viewBox='0 0 24 24'
          aria-hidden='true'
          slot='left-icon'>
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M15 19l-7-7 7-7'></path>
        </svg>
        <Text tag='span' variant='textBase'>Back to home</Text>
      </Link>
    </div>
  </main>
</BaseLayout>
