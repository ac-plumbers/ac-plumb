---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TestimonialsComponent from '@/components/home/Testimonials.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import Breadcrumb from '@/components/fundations/elements/Breadcrumb.astro';
import ReviewSchema from '@/components/fundations/head/ReviewSchema.astro';

// Business meta data
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig.ts';

// Review data for schema
const reviews = [
  {
    rating: '10/10',
    title: 'Excellent Boiler Service',
    date: 'January 2025',
    content:
      'AC Plumbers provided an outstanding boiler service. The engineer was professional, punctual, and explained everything clearly. Very impressed with the quality of work and attention to detail. Would definitely recommend to anyone in Brighton.',
    location: 'Brighton',
    author: 'Sarah M.',
  },
  {
    rating: '10/10',
    title: 'Urgent Leak Repair',
    date: 'December 2024',
    content:
      'Called AC Plumbers for an urgent leak. They responded quickly and fixed the problem efficiently. Excellent customer service and fair pricing. Saved us from potential water damage.',
    location: 'Hove',
    author: 'David R.',
  },
  {
    rating: '9/10',
    title: 'Gas Safety Certificate',
    date: 'December 2024',
    content:
      'Needed a gas safety certificate for my rental property. The service was quick, thorough, and professional. Clear documentation provided and competitive pricing. Will use again next year.',
    location: 'Brighton',
    author: 'James T.',
  },
  {
    rating: '10/10',
    title: 'Bathroom Installation',
    date: 'November 2024',
    content:
      'Complete bathroom renovation done to a very high standard. The team was clean, tidy, and professional throughout. Finished on time and within budget. Very happy with the results.',
    location: 'Brighton',
    author: 'Emma L.',
  },
  {
    rating: '10/10',
    title: 'Central Heating Repair',
    date: 'November 2024',
    content:
      'My heating system broke down during the cold spell. AC Plumbers diagnosed and fixed the issue same day. Excellent technical knowledge and customer care. Highly recommended.',
    location: 'Hove',
    author: 'Michael P.',
  },
  {
    rating: '9/10',
    title: 'Landlord Services',
    date: 'October 2024',
    content:
      'Regular maintenance and certification services for my rental properties. Always reliable, professional, and provides clear reports. Great value for money and peace of mind.',
    location: 'Brighton',
    author: 'Rachel W.',
  },
];

// Breadcrumb items
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Testimonials' },
];

// Page meta data
const title = 'Customer Testimonials & Reviews | AC Plumbers Brighton & Hove';
const description =
  "Read genuine customer reviews and testimonials from our satisfied clients across Brighton & Hove. See why we're the trusted choice for plumbing, heating, and gas services with 5-star ratings.";
const keywords =
  'customer testimonials, reviews, AC Plumbers Ltd. Brighton, plumbing reviews, heating reviews, gas safe reviews, Brighton plumbers, 5 star plumber';
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Review Schema for SEO -->
  <ReviewSchema reviews={reviews} slot='head' />

  <!-- Breadcrumb Navigation -->
  <div class='border-b border-neutral-200 bg-white'>
    <div class='mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8'>
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class='relative pt-24 pb-16 sm:pt-32 sm:pb-24'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div
        class='relative overflow-hidden rounded-2xl bg-linear-to-br from-primary-300 via-primary-700 to-primary-800 px-6 py-12 text-center sm:px-8 sm:py-16'>
        <div
          class='absolute inset-0 bg-linear-to-r from-primary-900/80 to-primary-800/60'>
        </div>

        <!-- Decorative elements -->
        <div
          class='absolute -top-16 -right-16 h-32 w-32 rounded-full bg-white/5'>
        </div>
        <div
          class='absolute -bottom-20 -left-20 h-40 w-40 rounded-full bg-white/5'>
        </div>

        <div class='relative z-10'>
          <div
            class='mb-4 inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-sm font-medium text-white backdrop-blur-sm'>
            <svg
              class='mr-2 h-4 w-4'
              fill='currentColor'
              viewBox='0 0 20 20'
              aria-hidden='true'>
              <path
                d='M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z'
              ></path>
            </svg>
            Customer Reviews
          </div>

          <Text
            tag='h1'
            variant='displayLG'
            class='font-lato font-bold tracking-tight text-white sm:text-4xl lg:text-5xl'>
            What Our Customers Say
          </Text>

          <Text
            tag='p'
            variant='textLG'
            class='mx-auto mt-4 max-w-2xl leading-relaxed text-white/90'>
            Real experiences from real customers across Brighton & Hove. See why
            families and businesses trust <Link
              href='/about-us'
              variant='default-link'
              class='text-white underline hover:text-accent-400'
              >AC Plumbers Ltd.</Link
            > for their <Link
              href='/services'
              variant='default-link'
              class='text-white underline hover:text-accent-400'
              >plumbing, heating, and gas services</Link
            >.
          </Text>

          <!-- Trust indicators -->
          <div
            class='mt-8 flex flex-col items-center justify-center gap-6 text-white sm:flex-row'>
            <div class='flex items-center gap-2'>
              <svg
                class='h-5 w-5 text-accent-400'
                fill='currentColor'
                viewBox='0 0 20 20'
                aria-hidden='true'>
                <path
                  d='M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z'
                ></path>
              </svg>
              <Text tag='span' variant='textSM' class='font-semibold'>
                5-Star Service
              </Text>
            </div>

            <div class='flex items-center gap-2'>
              <svg
                class='h-5 w-5 text-accent-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                aria-hidden='true'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'></path>
              </svg>
              <Text tag='span' variant='textSM' class='font-semibold'>
                Gas Safe Registered
              </Text>
            </div>

            <div class='flex items-center gap-2'>
              <svg
                class='h-5 w-5 text-accent-400'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                aria-hidden='true'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'></path>
              </svg>
              <Text tag='span' variant='textSM' class='font-semibold'>
                Emergency Support
              </Text>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Testimonials Component -->

  <TestimonialsComponent />

  <!-- Additional Trust Section -->
  <section class='bg-neutral-50 py-20'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='mb-16 text-center'>
        <Text
          tag='h2'
          variant='displayLG'
          class='font-lato font-bold text-primary-900 sm:text-4xl'>
          Why Customers Choose {BUSINESS_CONFIG.name}
        </Text>
        <Text
          tag='p'
          variant='textLG'
          class='mx-auto mt-6 max-w-3xl text-neutral-700'>
          Over the years, we've built lasting relationships with customers
          across Brighton & Hove through our commitment to quality, reliability,
          and exceptional service. <Link
            href='/services'
            variant='default-link'
            class='font-semibold'>Explore our services</Link
          > or <Link
            href='/about-us'
            variant='default-link'
            class='font-semibold'>learn more about our team</Link
          >.
        </Text>
      </div>

      <div class='grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4'>
        <div class='text-center'>
          <div
            class='mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100'>
            <svg
              class='h-8 w-8 text-primary-600'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              aria-hidden='true'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'></path>
            </svg>
          </div>
          <Text
            tag='h3'
            variant='textLG'
            class='mb-2 font-lato font-semibold text-primary-900'>
            Fully Qualified
          </Text>
          <Text tag='p' variant='textSM' class='text-neutral-600'>
            Gas Safe registered engineers with extensive training and experience
          </Text>
        </div>

        <div class='text-center'>
          <div
            class='mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-accent-100'>
            <svg
              class='h-8 w-8 text-accent-600'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              aria-hidden='true'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'></path>
            </svg>
          </div>
          <Text
            tag='h3'
            variant='textLG'
            class='mb-2 font-lato font-semibold text-primary-900'>
            Fast Response
          </Text>
          <Text tag='p' variant='textSM' class='text-neutral-600'>
            Urgent callouts prioritised with quick response times across
            Brighton & Hove
          </Text>
        </div>

        <div class='text-center'>
          <div
            class='mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100'>
            <svg
              class='h-8 w-8 text-primary-600'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              aria-hidden='true'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 5H7a2 2 0 00-2 2v6a2 2 0 002 2h2m5 0h2a2 2 0 002-2V7a2 2 0 00-2-2h-2m-5 4h4'
              ></path>
            </svg>
          </div>
          <Text
            tag='h3'
            variant='textLG'
            class='mb-2 font-lato font-semibold text-primary-900'>
            Transparent Pricing
          </Text>
          <Text tag='p' variant='textSM' class='text-neutral-600'>
            Clear, upfront quotes with no hidden charges or surprise fees
          </Text>
        </div>

        <div class='text-center'>
          <div
            class='mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-accent-100'>
            <svg
              class='h-8 w-8 text-accent-600'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              aria-hidden='true'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
              ></path>
            </svg>
          </div>
          <Text
            tag='h3'
            variant='textLG'
            class='mb-2 font-lato font-semibold text-primary-900'>
            Quality Guarantee
          </Text>
          <Text tag='p' variant='textSM' class='text-neutral-600'>
            All work backed by our comprehensive warranty and satisfaction
            guarantee
          </Text>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class='py-20'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div
        class='relative overflow-hidden rounded-2xl bg-linear-to-br from-primary-600 via-primary-700 to-primary-800 px-8 py-16 text-center'>
        <div
          class='absolute -top-16 -right-16 h-32 w-32 rounded-full bg-white/5'>
        </div>
        <div
          class='absolute -bottom-20 -left-20 h-40 w-40 rounded-full bg-white/5'>
        </div>

        <div class='relative z-10'>
          <Text
            tag='h2'
            variant='displayLG'
            class='font-lato font-bold text-white sm:text-4xl'>
            Ready to Join Our Happy Customers?
          </Text>
          <Text
            tag='p'
            variant='textLG'
            class='mx-auto mt-6 max-w-2xl text-white/90'>
            Experience the same exceptional service that our customers rave
            about. Whether you need <Link
              href='/services'
              variant='default-link'
              class='text-white underline hover:text-accent-400'
              >plumbing repairs</Link
            >, <Link
              href='/services'
              variant='default-link'
              class='text-white underline hover:text-accent-400'
              >heating installations</Link
            >, or <Link
              href='/landlords'
              variant='default-link'
              class='text-white underline hover:text-accent-400'
              >landlord services</Link
            >, get your free quote today.
          </Text>

          <div
            class='mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row'>
            <Link
              href='/contact-us'
              variant='default-button'
              size='md'
              class='bg-white text-primary-700 hover:bg-primary-50 focus:outline-2 focus:outline-white'>
              <Text tag='span' variant='textBase' class='font-semibold'>
                Contact Us
              </Text>
            </Link>
            <Link
              href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
              variant='default-button'
              size='md'
              class='border-2 border-white bg-transparent text-white hover:bg-white hover:text-primary-700 focus:outline-2 focus:outline-white'
              aria-label={`Call ${formatPhoneForDisplay(
                BUSINESS_CONFIG.mobilePhone,
              )}`}>
              <Text tag='span' variant='textBase' class='font-semibold'>
                Call: {formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}
              </Text>
            </Link>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
