---
// Layout
import HomeLayout from '@/layouts/HomeLayout.astro';
// Components
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import MainCta from '@/components/global/MainCta.astro';
// Utils
import { BUSINESS_CONFIG, formatPhoneForTel } from '@/utils/businessConfig';
import { Flame, Info, CirclePoundSterling, Wrench } from '@lucide/astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';

// Organized FAQ data by category
const faqCategories = [
  {
    category: 'General Services',
    icon: Info,
    faqs: [
      {
        question: 'What services do you offer?',
        answer:
          'We provide plumbing, heating, and gas services including boiler installation, boiler servicing and repair, central heating installation, gas safety checks (CP12), air source heat pump installation, and general plumbing — from leaks and taps to full bathroom and kitchen installations — for both residential and commercial properties across Brighton & Hove.',
      },
      {
        question: 'Are your engineers Gas Safe registered?',
        answer:
          `Yes. All AC Plumbers Ltd. engineers are fully Gas Safe registered (licence ${BUSINESS_CONFIG.gasSafeNumber}), professionally qualified, and fully insured. We follow all current UK gas and heating regulations on every job.`,
      },
      {
        question: 'What areas do you cover?',
        answer:
          "We serve Brighton, Hove, and the surrounding Sussex areas including Rottingdean, Saltdean, Peacehaven, Lewes, Hassocks, Portslade, Southwick, Shoreham-by-Sea, and Lancing. Not sure if we cover your location? Get in touch and we'll confirm.",
      },
    ],
  },
  {
    category: 'Boilers & Heating',
    icon: Flame,
    faqs: [
      {
        question: 'What types of boiler do you install?',
        answer:
          'We install combi boilers, system boilers, and conventional (heat-only) boilers. We work with leading brands including Vaillant and Viessmann, and will recommend the most suitable system for your property size and hot water demands.',
      },
      {
        question: 'How long does a boiler installation take?',
        answer:
          "A standard boiler replacement typically takes 1–2 days depending on the complexity of the pipework and system type. We'll give you a clear timeline during your free consultation before any work begins.",
      },
      {
        question: 'How often should I service my boiler?',
        answer:
          'We recommend an annual boiler service. Regular servicing keeps your boiler running safely and efficiently, helps prevent unexpected breakdowns, and maintains any manufacturer warranty.',
      },
      {
        question: 'What is a power flush and do I need one?',
        answer:
          "A power flush clears sludge, rust, and debris from your heating system's pipes and radiators. It's often recommended when fitting a new boiler or if you notice cold spots on radiators, unusual noises, or slow warm-up times. We include a power flush assessment as part of every boiler installation quote.",
      },
    ],
  },
  {
    category: 'Pricing & Quotes',
    icon: CirclePoundSterling,
    faqs: [
      {
        question: 'How do I get a quote?',
        answer:
          "You can request a quote by phone, WhatsApp, or our online contact form. For most jobs we'll arrange a free site visit to assess the work and provide a clear, no-obligation estimate with no hidden costs.",
      },
      {
        question: 'Do you offer financing for new boiler installations?',
        answer:
          'Yes, we offer flexible payment options to help spread the cost of a new boiler or heating system installation. Ask us about available options when you request your quote.',
      },
      {
        question: 'What payment methods do you accept?',
        answer:
          'We accept bank transfers. Payment terms are clearly outlined in your quote and invoice before any work begins.',
      },
    ],
  },
  {
    category: 'Gas Safety & Heat Pumps',
    icon: Wrench,
    faqs: [
      {
        question: 'What is a Gas Safety Certificate (CP12)?',
        answer:
          'A Gas Safety Certificate — also known as a CP12 — is an annual inspection of all gas appliances in a property, carried out by a Gas Safe registered engineer. Landlords are legally required to hold a valid CP12 for every rented property. We issue digital certificates and can set up renewal reminders to keep you compliant.',
      },
      {
        question: 'Do you carry out gas safety checks for landlords?',
        answer:
          'Yes. We work with landlords across Brighton & Hove and the surrounding areas, providing annual gas safety inspections, CP12 certificates, and ongoing appliance maintenance to keep rental properties legally compliant.',
      },
      {
        question: 'What is an air source heat pump?',
        answer:
          'An air source heat pump (ASHP) extracts heat from outside air to provide heating and hot water for your home. It is a highly efficient, low-carbon alternative to a gas boiler and can significantly reduce energy bills over time.',
      },
      {
        question: 'Can I get a grant for an air source heat pump?',
        answer:
          "Eligible homeowners in England and Wales can apply for the Government's Boiler Upgrade Scheme (BUS), which currently offers grants of up to £7,500 towards ASHP installation costs. We are MCS-compliant installers, which is a requirement to access the grant. Contact us to find out if your property qualifies.",
      },
    ],
  },
];
---

<HomeLayout
  title='Plumbing & Heating FAQ Brighton | AC Plumbers Ltd.'
  description='Find answers to common plumbing, heating, and gas questions from our Brighton & Hove engineers. Call or contact us for expert advice today.'>
  <!-- Hero Section -->
  <section class='bg-neutral-50 py-16 md:py-20'>
    <Wrapper variant='standard'>
      <div class='mx-auto max-w-3xl text-center'>
        <Text tag='h1' variant='displayLG' class='text-text-00'>
          Plumbing & Heating FAQs for Brighton & Hove
        </Text>
        <Text tag='p' variant='textXL' class='mt-6 text-neutral-700'>
          Find answers to common questions about our plumbing, heating, and gas
          services. Can't find what you're looking for?{' '}
          <a
            href='/contact-us'
            class='font-semibold text-primary-600 underline hover:text-primary-700'>
            Contact our team
          </a>{' '}
          for expert advice.
        </Text>

        <div class='mt-10 flex flex-wrap items-center justify-center gap-4'>
          <Link
            href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
            variant='default-button'
            size='lg'>
            Call Us Now
          </Link>
          <Link href='/contact-us' variant='accent-button' size='lg'>
            Contact Us
          </Link>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- FAQ Categories -->
  <section class='bg-white py-16' aria-label='FAQ Categories'>
    <Wrapper variant='full'>
      <div class='grid grid-cols-1 gap-8 lg:grid-cols-2'>
        {
          faqCategories.map(({ category, icon: Icon, faqs }) => (
            <article class='h-full rounded-2xl border border-neutral-200 bg-linear-to-br from-neutral-50 to-white p-8 shadow-sm'>
              {/* Category Header */}
              <div class='mb-6 flex items-center gap-3'>
                <div class='rounded-lg bg-primary-100 p-2'>
                  <Icon class='h-6 w-6 text-primary-600' aria-hidden='true' />
                </div>
                <Text tag='h2' variant='displayMD' class='text-text-00'>
                  {category}
                </Text>
              </div>

              {/* FAQ Items */}
              <div class='space-y-4'>
                {faqs.map(faq => (
                  <details class='group overflow-hidden rounded-xl border border-neutral-200 bg-white transition-all duration-200'>
                    <summary class='flex cursor-pointer items-center justify-between gap-4 p-5 text-left transition-colors hover:bg-neutral-50 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:outline-none [&::-webkit-details-marker]:hidden'>
                      <span class='text-lg font-semibold text-text-00'>
                        {faq.question}
                      </span>
                      <svg
                        class='h-5 w-5 shrink-0 text-primary-600 transition-transform duration-200 group-open:rotate-180'
                        fill='none'
                        stroke='currentColor'
                        viewBox='0 0 24 24'
                        aria-hidden='true'>
                        <path
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          stroke-width='2'
                          d='M19 9l-7 7-7-7'
                        />
                      </svg>
                    </summary>
                    <div class='border-t border-neutral-200 px-5 py-4'>
                      <Text tag='p' variant='textBase' class='text-neutral-700'>
                        {faq.answer}
                      </Text>
                    </div>
                  </details>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </Wrapper>
  </section>

  <!-- FAQPage Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqCategories.flatMap(({ faqs }) =>
      faqs.map(({ question, answer }) => ({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": answer
        }
      }))
    )
  })} />

  <!-- CTA -->
  <MainCta
    body='Still have questions? Our Gas Safe engineers are on hand to help with personalised advice on plumbing, heating, and gas services across Brighton & Hove.'
    secondaryLinkHref='/contact-us'
    secondaryLinkLabel='Contact Our Team'
  />
</HomeLayout>
