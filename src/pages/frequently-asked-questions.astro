---
// Layout
import HomeLayout from '@/layouts/HomeLayout.astro';
// Components
import Text from '@/components/fundations/elements/Text.astro';
import ContactSupportCTA from '@/components/ContactSupportCTA.astro';
// Utils
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
import {
  Phone,
  Mail,
  ShieldAlert,
  Info,
  CirclePoundSterling,
  Wrench,
} from '@lucide/astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';

// Organized FAQ data by category
const faqCategories = [
  {
    category: 'General Services',
    icon: Info,
    faqs: [
      {
        question: 'What services do you offer?',
        answer:
          'We provide comprehensive plumbing, heating, and gas services including installations, repairs, and maintenance. Our services cover boiler installation, central heating, bathroom fitting, emergency plumbing, gas safety checks, air source heat pumps, and smart thermostats for residential and commercial properties.',
      },
      {
        question: 'Are your plumbers certified?',
        answer:
          'Yes! All AC Plumbers engineers are fully Gas Safe registered, professionally qualified, and insured. Our team undergoes regular training to stay current with the latest UK standards, safety regulations, and best practices in the industry.',
      },
      {
        question: 'What areas do you serve?',
        answer:
          'We serve Brighton, Hove, and surrounding Sussex areas including Rottingdean, Saltdean, Peacehaven, Lewes, Hassocks, Portslade, Southwick, Shoreham by Sea, and Lancing. Response times typically range from 15-40 minutes depending on your location. Not sure if we cover your area? Contact us to check!',
      },
    ],
  },
  {
    category: 'Emergency & Response',
    icon: ShieldAlert,
    faqs: [
      {
        question: 'Do you offer emergency services?',
        answer:
          'Absolutely. We provide 24/7 emergency plumbing response for urgent issues like burst pipes, major leaks, blocked drains, and heating system failures. Call us any time for immediate assistance.',
      },
      {
        question: 'How quickly can you respond?',
        answer:
          'For our primary service areas (Brighton & Hove), we typically respond within 15-20 minutes for emergencies. For surrounding areas, response times range from 20-40 minutes depending on location and current demand.',
      },
      {
        question: 'What should I do if I have a burst pipe?',
        answer:
          'Turn off the water supply immediately at the main stopcock (usually under the kitchen sink or where the water pipe enters your property). Turn off electricity if water is near electrical fittings. Move valuables away from the leak and call us immediately for emergency assistance.',
      },
    ],
  },
  {
    category: 'Pricing & Quotes',
    icon: CirclePoundSterling,
    faqs: [
      {
        question: 'How can I get a quote?',
        answer:
          "Request a quote by phone, email, or our online contact form. For most jobs, we'll arrange a free site visit to assess the work and provide a clear, competitive, no-obligation estimate. For emergency work, we provide transparent pricing before starting.",
      },
      {
        question: 'Do you charge for call-outs?',
        answer:
          'We do not charge hidden travel fees within our primary service areas. For emergency call-outs, there is a standard call-out fee which is clearly communicated upfront and can be offset against the final repair cost.',
      },
      {
        question: 'What payment methods do you accept?',
        answer:
          'We accept bank transfers for your convenience. Payment terms will be clearly outlined in your quote and invoice.',
      },
    ],
  },
  {
    category: 'Installations & Maintenance',
    icon: Wrench,
    faqs: [
      {
        question: 'How long does a boiler installation take?',
        answer:
          'A standard boiler replacement typically takes 1-2 days depending on the complexity. This includes removing the old boiler, installing the new system, connecting all pipework, and testing. We´ll provide a clear timeline during your free consultation.',
      },
      {
        question: 'What is a boiler service and why is it important?',
        answer:
          "A boiler service is a thorough check and maintenance of your boiler to ensure it's running safely and efficiently. Annual servicing can prevent breakdowns, extend your boiler's lifespan, maintain warranty validity, improve efficiency, and ensure safety by detecting potential carbon monoxide risks.",
      },
      {
        question: 'Do you provide guarantees on your work?',
        answer:
          'Yes, we provide guarantees on all our work and use only quality parts from reputable manufacturers. Specific warranty details vary by job type and will be clearly outlined in your quote.',
      },
    ],
  },
];
---

<!-- TODO:: FINISH THE PAGE -->
<HomeLayout
  title='Frequently Asked Questions - AC Plumbers Ltd. Brighton'
  description='Find answers to common questions about our plumbing, heating, and gas services in Brighton & Hove. Expert advice on emergency repairs, installations, and maintenance.'>
  <main id='maincontent' tabindex='-1'>
    <!-- Hero Section -->
    <section
      class='mt-24 bg-linear-to-b from-primary-600 to-white py-16 md:py-20'>
      <Wrapper variant='standard'>
        <div class='mx-auto max-w-3xl text-center'>
          <Text tag='h1' variant='displayLG' class='text-primary-900'>
            Frequently Asked Questions
          </Text>
          <Text tag='p' variant='textXL' class='mt-6 text-primary-700'>
            Find answers to common questions about our plumbing, heating, and
            gas services. Can't find what you're looking for?{' '}
            <a
              href='/contact-us'
              class='font-semibold text-accent-600 underline hover:text-accent-700'>
              Contact our team
            </a>{' '}
            for expert advice.
          </Text>

          <!-- Quick Contact Cards -->
          <div class='mt-10 grid gap-4 sm:grid-cols-2'>
            <a
              href={`tel:${BUSINESS_CONFIG.mobilePhone.replace(/\s+/g, '')}`}
              class='flex items-center gap-3 rounded-lg border-2 border-primary-200 bg-white p-4 transition-all hover:border-primary-400 hover:shadow-md'>
              <div class='rounded-lg bg-primary-100 p-3'>
                <Phone class='h-5 w-5 text-primary-600' />
              </div>
              <div class='text-left'>
                <div class='text-sm font-medium text-primary-600'>Call Us</div>
                <div class='font-semibold text-primary-900'>
                  {BUSINESS_CONFIG.mobilePhone}
                </div>
              </div>
            </a>

            <a
              href={`mailto:${BUSINESS_CONFIG.email}`}
              class='flex items-center gap-3 rounded-lg border-2 border-primary-200 bg-white p-4 transition-all hover:border-primary-400 hover:shadow-md'>
              <div class='rounded-lg bg-accent-100 p-3'>
                <Mail class='h-5 w-5 text-accent-600' />
              </div>
              <div class='text-left'>
                <div class='text-sm font-medium text-primary-600'>Email Us</div>
                <div class='font-semibold text-primary-900'>
                  {BUSINESS_CONFIG.email}
                </div>
              </div>
            </a>
          </div>
        </div>
      </Wrapper>
    </section>

    <!-- FAQ Categories -->
    <section class='bg-white py-16' aria-label='FAQ Categories'>
      <Wrapper variant='standard'>
        <div class='space-y-12'>
          {
            faqCategories.map(({ category, icon: Icon, faqs }) => (
              <div class='rounded-2xl border border-neutral-200 bg-linear-to-br from-neutral-50 to-white p-8 shadow-sm'>
                {/* Category Header */}
                <div class='mb-6 flex items-center gap-3'>
                  <div class='rounded-lg bg-primary-100 p-2'>
                    <Icon class='h-6 w-6 text-primary-600' />
                  </div>
                  <Text tag='h2' variant='displayMD' class='text-primary-900'>
                    {category}
                  </Text>
                </div>

                {/* FAQ Items */}
                <div class='space-y-4'>
                  {faqs.map(faq => (
                    <details class='group overflow-hidden rounded-xl border border-neutral-200 bg-white transition-all duration-200'>
                      <summary class='flex cursor-pointer items-center justify-between gap-4 p-5 text-left transition-colors hover:bg-neutral-50 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:outline-none [&::-webkit-details-marker]:hidden'>
                        <span class='text-lg font-semibold text-primary-900'>
                          {faq.question}
                        </span>
                        <svg
                          class='h-5 w-5 shrink-0 text-primary-600 transition-transform duration-200 group-open:rotate-180'
                          fill='none'
                          stroke='currentColor'
                          viewBox='0 0 24 24'
                          aria-hidden='true'>
                          <path
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            stroke-width='2'
                            d='M19 9l-7 7-7-7'
                          />
                        </svg>
                      </summary>
                      <div class='border-t border-neutral-200 px-5 py-4'>
                        <Text
                          tag='p'
                          variant='textBase'
                          class='text-primary-700'>
                          {faq.answer}
                        </Text>
                      </div>
                    </details>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </Wrapper>
    </section>

    <!-- Still Have Questions CTA -->
    <section class='bg-neutral-50 py-16'>
      <Wrapper variant='standard'>
        <ContactSupportCTA
          heading='Still have questions?'
          message="If you can't find the answer you're looking for, our expert team is ready to help with personalized advice and support."
          buttonText='Contact Us Now'
          buttonHref='/contact-us'
        />
      </Wrapper>
    </section>
  </main>
</HomeLayout>
