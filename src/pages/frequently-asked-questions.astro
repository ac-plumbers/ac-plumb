---
import HomeLayout from '@/layouts/HomeLayout.astro';
import Text from '@/components/fundations/elements/Text.astro';
import FormFaqPage from '@/components/forms/FormFaqPage.astro';
import ContactSupportCTA from '@/components/ContactSupportCTA.astro';
import Button from '@/components/fundations/elements/Button.astro';
import { BUSINESS_CONFIG } from '@/utils/businessConfig';
import Logo from '@/images/logo/ac-plumbers-logo-brighton.png';
import { Image } from 'astro:assets';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';
---

<HomeLayout>
  <main id='maincontent' tabindex='-1'>
    <section class='bg-primary-40 mt-20' aria-labelledby='faq-title'>
      <div class='mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8'>
        <header class='mx-auto max-w-2xl text-center'>
          <Text
            tag='h1'
            variant='displayLG'
            class='text-primary-700'
            id='faq-title'>
            Frequently Asked Questions
          </Text>
          <Text tag='p' variant='textLG' class='mt-6 text-primary-600'>
            AC Plumbers Ltd. Brighton is here to help! Browse our most common
            questions below, or <a
              href='/contact-us'
              class='font-semibold text-accent-500 underline hover:text-accent-700'
              >contact our team</a
            > for expert advice or urgent support.
          </Text>
        </header>
        <section class='mt-20' aria-label='Frequently Asked Questions List'>
          <dl
            class='space-y-16 sm:grid sm:grid-cols-2 sm:space-y-0 sm:gap-x-6 sm:gap-y-16 lg:grid-cols-3 lg:gap-x-10'>
            <div>
              <dt
                class='text-lg font-semibold text-primary-800'
                id='faq1-question'>
                What services do you offer?
              </dt>
              <dd
                class='mt-2 text-base text-primary-700'
                aria-labelledby='faq1-question'>
                We offer plumbing, heating, and gas services: installations,
                repairs, and maintenance for homes and businesses in Brighton,
                Hove, Lewes, Worthing, and nearby.
              </dd>
            </div>
            <div>
              <dt
                class='text-lg font-semibold text-primary-800'
                id='faq2-question'>
                Are your plumbers certified?
              </dt>
              <dd
                class='mt-2 text-base text-primary-700'
                aria-labelledby='faq2-question'>
                Yes! All AC Plumbers engineers are fully certified, insured, and
                regularly trained to meet the latest UK standards and safety
                regulations.
              </dd>
            </div>
            <div>
              <dt
                class='text-lg font-semibold text-primary-800'
                id='faq3-question'>
                Do you offer emergency services?
              </dt>
              <dd
                class='mt-2 text-base text-primary-700'
                aria-labelledby='faq3-question'>
                Absolutely. We provide 24/7 emergency plumbing response. Call us
                any time for urgent leaks, blockages, or heating breakdowns.
              </dd>
            </div>
            <div>
              <dt
                class='text-lg font-semibold text-primary-800'
                id='faq4-question'>
                How can I get a quote for a job?
              </dt>
              <dd
                class='mt-2 text-base font-(--font-inconsolata) text-primary-700'
                aria-labelledby='faq4-question'>
                Request a quote by phone, email, or our online form. We’ll
                arrange a visit and provide a clear, competitive estimate—no
                obligation.
              </dd>
            </div>
            <div>
              <dt
                class='text-lg font-semibold text-primary-800'
                id='faq5-question'>
                What areas do you serve?
              </dt>
              <dd
                class='mt-2 text-base text-primary-700'
                aria-labelledby='faq5-question'>
                We serve Brighton, Hove, Lewes, Worthing, and surrounding Sussex
                areas. Unsure if we cover your postcode? <a
                  href='/contact-us'
                  class='font-semibold text-accent-500 underline hover:text-accent-700'
                  >Ask us!</a
                >
              </dd>
            </div>
          </dl>
        </section>
        <!-- Contact Support CTA -->
        <Wrapper variant='standard'>
          <section class='mt-16' aria-labelledby='contact-support-heading'>
            <ContactSupportCTA
              heading='Still have questions?'
              message="If you can't find the answer you're looking for, our team is ready to help."
              buttonText='Contact Support'
              buttonHref='/contact-us'
              sectionClass='mt-16'
              containerClass='bg-white rounded-lg shadow p-8'
            />
          </section>
        </Wrapper>
      </div>
      <section class='mt-16'>
        <div
          class='flex flex-col gap-8 rounded border-2 border-red-700 bg-primary-900 p-8 lg:flex-row lg:items-end lg:justify-between'>
          <div class='max-w-xl text-balance'>
            <Image src={Logo} alt='AC Plumbers Logo' />

            <Text tag='p' variant='textLG' class='mt-24 font-medium text-white'>
              Building with precision, dependable delivery, and clear
              communication from preconstruction through handover.
            </Text>
          </div>
          <div class='flex flex-wrap gap-2 sm:items-center'>
            <Button
              isLink
              size='xs'
              variant='default'
              href={`mailto:${BUSINESS_CONFIG.email}`}>
              {BUSINESS_CONFIG.email}
            </Button>
            <Button
              isLink
              size='xs'
              variant='muted'
              href={`tel:${BUSINESS_CONFIG.companyNumber.replace(/[^\d+]/g, '')}`}>
              {BUSINESS_CONFIG.phone}
            </Button>
          </div>
        </div>
      </section>
    </section>
  </main>
</HomeLayout>
