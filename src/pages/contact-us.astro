---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Text from '@/components/fundations/elements/Text.astro';
import Link from '@/components/fundations/elements/Link.astro';
import CallButton from '@/components/fundations/elements/CallButton.astro';
import Wrapper from '@/components/fundations/containers/Wrapper.astro';
import MainCta from '@/components/global/MainCta.astro';
import FormContact from '@/components/forms/FormContact.astro';
import {
  BUSINESS_CONFIG,
  formatPhoneForDisplay,
  formatPhoneForTel,
} from '@/utils/businessConfig';

// SEO
const title = "Contact AC Plumbers Ltd. | Brighton's Trusted Plumbing Experts";
const description =
  'Get in touch with AC Plumbers Ltd. for reliable plumbing services in Brighton. Our expert team is ready to assist you with all your plumbing needs.';
const keywords =
  'contact, AC Plumbers Ltd., plumbing services, Brighton, emergency plumbing, boiler repair, heating services';

// Derive WhatsApp URL from business config
const whatsappNumber = BUSINESS_CONFIG.mobilePhone.replace(/[\+\s]/g, '');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Hi%20AC%20Plumbers%2C%20I%20need%20help%20with%20my%20plumbing`;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section
    class='relative isolate overflow-hidden'
    aria-labelledby='contact-hero-heading'
    data-bg='dark'>
    <div
      class='bg-linear-to-br from-primary-900 via-primary-800 to-secondary-800'>
      <!-- Decorative SVG grid pattern -->
      <svg
        aria-hidden='true'
        class='absolute inset-x-0 top-0 -z-10 h-256 w-full mask-[radial-gradient(32rem_32rem_at_center,white,transparent)] stroke-primary-200/15'>
        <defs>
          <pattern
            id='contact-hero-pattern'
            width='200'
            height='200'
            x='50%'
            y='-1'
            patternUnits='userSpaceOnUse'>
            <path d='M.5 200V.5H200' fill='none'></path>
          </pattern>
        </defs>
        <svg x='50%' y='-1' class='overflow-visible fill-primary-900'>
          <path
            d='M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z'
            stroke-width='0'></path>
        </svg>
        <rect
          width='100%'
          height='100%'
          fill='url(#contact-hero-pattern)'
          stroke-width='0'></rect>
      </svg>

      <!-- Decorative blur blob -->
      <div
        aria-hidden='true'
        class='absolute top-0 right-0 left-1/2 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48'>
        <div
          style='clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)'
          class='aspect-801/1036 w-200.25 bg-linear-to-tr from-accent-500/40 to-secondary-400/40 opacity-80'>
        </div>
      </div>

      <Wrapper
        variant='standard'
        class='pt-36 pb-20 sm:pt-52 lg:pt-32 lg:pb-28'>
        <div class='mx-auto max-w-4xl text-center'>
          <Text
            tag='p'
            variant='textSM'
            class='inline-flex rounded-full bg-accent-500 px-4 py-1.5 font-semibold tracking-wide whitespace-nowrap text-primary-900 uppercase'>
            Brighton &amp; Hove
          </Text>
          <Text
            tag='h1'
            id='contact-hero-heading'
            variant='displayLG'
            class='mt-5 font-bold text-white'>
            Your trusted local experts in Brighton for all plumbing, heating,
            and gas services. We're here to help with emergencies and planned
            work.
          </Text>
          <!-- <Text tag='p' variant='textLG' class='mt-6 text-primary-100'>
            Your trusted local experts in Brighton for all plumbing, heating,
            and gas services. We're here to help with emergencies and planned
            work.
          </Text> -->
          <div class='mt-10 flex flex-col justify-center gap-4 sm:flex-row'>
            <CallButton variant='accent' size='md' animation='ring' />
            <a
              href={whatsappUrl}
              target='_blank'
              rel='noopener noreferrer'
              class='text-md inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/40 px-8 py-3 font-medium text-white transition hover:border-white/70 hover:bg-white/10 focus:outline-2 focus:outline-offset-4 focus:outline-white'
              aria-label='Contact AC Plumbers via WhatsApp'>
              <svg
                class='h-5 w-5'
                fill='currentColor'
                viewBox='0 0 24 24'
                aria-hidden='true'>
                <path
                  d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488'
                ></path>
              </svg>
              WhatsApp Us
            </a>
          </div>
        </div>
      </Wrapper>
    </div>
  </section>

  <!-- ─── Contact Methods ───────────────────────────────────────────────── -->
  <section
    class='bg-white py-16 sm:py-24'
    aria-labelledby='contact-methods-heading'>
    <Wrapper variant='standard'>
      <div class='mx-auto max-w-2xl text-center'>
        <Text
          tag='p'
          variant='textSM'
          class='font-semibold tracking-wider text-primary-600 uppercase'>
          Get in touch
        </Text>
        <Text
          tag='h2'
          id='contact-methods-heading'
          variant='displayXL'
          class='mt-3 font-bold text-text-00'>
          We're Here to Help You
        </Text>
        <Text tag='p' variant='textLG' class='mt-4 text-neutral-600'>
          Whether it's an emergency or planned work, we make getting in touch
          simple. Choose the method that works best for you.
        </Text>
      </div>

      <div
        class='mx-auto mt-16 grid max-w-4xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3'>
        <!-- Phone -->
        <div
          class='relative rounded-2xl bg-white p-8 shadow-lg ring-1 ring-neutral-200 transition-shadow duration-300 hover:shadow-xl hover:shadow-primary-500/20'>
          <div
            class='mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-600'>
            <svg
              class='h-6 w-6 text-white'
              fill='none'
              viewBox='0 0 24 24'
              stroke-width='1.5'
              stroke='currentColor'
              aria-hidden='true'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z'
              ></path>
            </svg>
          </div>
          <Text tag='h3' variant='textXL' class='font-semibold text-text-00'>
            Speak with Our Team
          </Text>
          <Text tag='p' variant='textSM' class='mt-2 text-neutral-600'>
            Get immediate assistance from our friendly experts
          </Text>
          <div class='mt-4 space-y-2'>
            <div>
              <Text tag='p' variant='textSM' class='font-medium text-text-00'
                >Office:</Text
              >
              <a
                href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.landline)}`}
                class='rounded font-medium text-primary-600 hover:text-primary-700 focus:outline-2 focus:outline-offset-2 focus:outline-primary-600'
                aria-label={`Call office number ${formatPhoneForDisplay(BUSINESS_CONFIG.landline)}`}>
                {formatPhoneForDisplay(BUSINESS_CONFIG.landline)}
              </a>
            </div>
            <div>
              <Text tag='p' variant='textSM' class='font-medium text-text-00'
                >Mobile:</Text
              >
              <a
                href={`tel:${formatPhoneForTel(BUSINESS_CONFIG.mobilePhone)}`}
                class='rounded font-medium text-primary-600 hover:text-primary-700 focus:outline-2 focus:outline-offset-2 focus:outline-primary-600'
                aria-label={`Call mobile number ${formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}`}>
                {formatPhoneForDisplay(BUSINESS_CONFIG.mobilePhone)}
              </a>
            </div>
          </div>
        </div>

        <!-- WhatsApp -->
        <div
          class='relative rounded-2xl bg-white p-8 shadow-lg ring-1 ring-neutral-200 transition-shadow duration-300 hover:shadow-xl hover:shadow-primary-500/20'>
          <div
            class='mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-green-600'>
            <svg
              class='h-6 w-6 text-white'
              fill='currentColor'
              viewBox='0 0 24 24'
              aria-hidden='true'>
              <path
                d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488'
              ></path>
            </svg>
          </div>
          <Text tag='h3' variant='textXL' class='font-semibold text-text-00'>
            Quick &amp; Easy Messaging
          </Text>
          <Text tag='p' variant='textSM' class='mt-2 text-neutral-600'>
            Send photos, ask questions, or book appointments instantly
          </Text>
          <div class='mt-4'>
            <a
              href={whatsappUrl}
              target='_blank'
              rel='noopener noreferrer'
              class='inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white transition-colors duration-200 hover:bg-green-700 focus:outline-2 focus:outline-offset-2 focus:outline-green-600'
              aria-label='Start WhatsApp conversation with AC Plumbers'>
              <svg
                class='h-4 w-4'
                fill='currentColor'
                viewBox='0 0 24 24'
                aria-hidden='true'>
                <path
                  d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488'
                ></path>
              </svg>
              Start Conversation
            </a>
          </div>
        </div>

        <!-- Email -->
        <div
          class='relative rounded-2xl bg-white p-8 shadow-lg ring-1 ring-neutral-200 transition-shadow duration-300 hover:shadow-xl hover:shadow-primary-500/20 sm:col-span-2 lg:col-span-1'>
          <div
            class='mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-600'>
            <svg
              class='h-6 w-6 text-white'
              fill='none'
              viewBox='0 0 24 24'
              stroke-width='1.5'
              stroke='currentColor'
              aria-hidden='true'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75'
              ></path>
            </svg>
          </div>
          <Text tag='h3' variant='textXL' class='font-semibold text-text-00'>
            Send Us Details
          </Text>
          <Text tag='p' variant='textSM' class='mt-2 text-neutral-600'>
            Perfect for detailed queries or non-urgent requests
          </Text>
          <div class='mt-4'>
            <a
              href={`mailto:${BUSINESS_CONFIG.email}`}
              class='rounded font-medium text-primary-600 hover:text-primary-700 focus:outline-2 focus:outline-offset-2 focus:outline-primary-600'
              aria-label={`Send email to ${BUSINESS_CONFIG.email}`}>
              {BUSINESS_CONFIG.email}
            </a>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- ─── Form + Trust Info ─────────────────────────────────────────────── -->
  <section
    class='bg-neutral-50 py-16 sm:py-24'
    aria-labelledby='contact-form-heading'>
    <Wrapper variant='standard'>
      <div class='grid grid-cols-1 gap-16 lg:grid-cols-2'>
        <!-- Left: trust info -->
        <div>
          <Text
            tag='h2'
            id='contact-form-heading'
            variant='displayLG'
            class='font-bold text-text-00'>
            Why Brighton Trusts AC Plumbers Ltd.
          </Text>
          <Text tag='p' variant='textLG' class='mt-4 text-neutral-600'>
            We've been helping families and businesses in Brighton with their
            plumbing needs for years. Here's what makes us different.
          </Text>

          <ul class='mt-12 space-y-8' role='list'>
            <li class='flex gap-4'>
              <div class='shrink-0'>
                <div
                  class='flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600'>
                  <svg
                    class='h-6 w-6 text-white'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    aria-hidden='true'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'
                    ></path>
                  </svg>
                </div>
              </div>
              <div>
                <Text
                  tag='h3'
                  variant='textLG'
                  class='font-semibold text-text-00'>
                  Fast Response Times
                </Text>
                <Text tag='p' variant='textBase' class='mt-2 text-neutral-600'>
                  Urgent plumbing issue? We prioritise emergency callouts and
                  aim to respond as quickly as possible — often within hours.
                </Text>
              </div>
            </li>

            <li class='flex gap-4'>
              <div class='shrink-0'>
                <div
                  class='flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600'>
                  <svg
                    class='h-6 w-6 text-white'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    aria-hidden='true'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.745 3.745 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z'
                    ></path>
                  </svg>
                </div>
              </div>
              <div>
                <Text
                  tag='h3'
                  variant='textLG'
                  class='font-semibold text-text-00'>
                  Qualified Experts You Can Trust
                </Text>
                <Text tag='p' variant='textBase' class='mt-2 text-neutral-600'>
                  All our engineers are Gas Safe registered and fully insured.
                  We invest in ongoing training so you get the latest techniques
                  and safety standards.
                </Text>
              </div>
            </li>

            <li class='flex gap-4'>
              <div class='shrink-0'>
                <div
                  class='flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600'>
                  <svg
                    class='h-6 w-6 text-white'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                    aria-hidden='true'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443a55.381 55.381 0 0 1 5.25 2.882V15'
                    ></path>
                  </svg>
                </div>
              </div>
              <div>
                <Text
                  tag='h3'
                  variant='textLG'
                  class='font-semibold text-text-00'>
                  Honest Pricing, No Surprises
                </Text>
                <Text tag='p' variant='textBase' class='mt-2 text-neutral-600'>
                  We believe in transparent pricing. You'll get a free, detailed
                  quote upfront, and we stand behind our work with comprehensive
                  guarantees.
                </Text>
              </div>
            </li>
          </ul>

          <div
            class='mt-12 rounded-xl bg-primary-50 p-6 ring-1 ring-primary-100'>
            <Text
              tag='h3'
              variant='textLG'
              class='font-semibold text-primary-900'>
              Our Local Service Area
            </Text>
            <Text tag='p' variant='textBase' class='mt-2 text-primary-800'>
              Based in Brighton, we proudly serve our local community and
              surrounding areas. Local knowledge means faster response times and
              better service.
            </Text>
          </div>
        </div>

        <!-- Right: contact form card -->
        <div class='rounded-2xl bg-white p-8 shadow-lg ring-1 ring-neutral-200'>
          <Text tag='h2' variant='displayLG' class='font-bold text-text-00'>
            Tell Us About Your Project
          </Text>
          <Text tag='p' variant='textBase' class='mt-4 text-neutral-600'>
            Share the details of what you need and we'll get back to you with a
            personalised solution within 24 hours.
          </Text>
          <FormContact />
        </div>
      </div>
    </Wrapper>
  </section>

  <!-- ─── CTA ──────────────────────────────────────────────────────────── -->
  <MainCta
    body="Urgent plumbing issue? Our Gas Safe engineers are ready to help — call us now or send a message and we'll get back to you fast."
    secondaryLinkHref='/request-quote'
    secondaryLinkLabel='Request a Quote'
  />
</BaseLayout>
